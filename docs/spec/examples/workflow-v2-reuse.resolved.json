          },
          "executor": {
            "agent": "codex",
            "timeout": "60m"
          },
          "id": "apply",
          "needs": [
            "propose"
          ],
          "produces": [
            {
              "artifact": "pull_request"
            }
          ],
          "reviewers": {
            "agents": [
              {
                "provider": "codex"
              }
            ]
          },
          "type": "implement"
        },
        {
          "budget": {
            "max_runtime": "10m"
          },
          "executor": {
            "human": true
          },
          "id": "gate",
          "reviewers": {
            "human": 1
          },
          "type": "review"
        },
        {
          "budget": {
            "max_runtime": "45m"
          },
          "executor": {
            "human": true
          },
          "id": "verify",
          "inputs": [
            {
              "artifact": "pull_request",
              "from_stage": "apply"
            }
          ],
          "reviewers": {
            "agents": [
              {
                "provider": "claudecode"
              },
              {
                "provider": "codex"
              }
            ],
            "human": 1
          },
          "type": "review"
        },
        {
          "budget": {
            "max_runtime": "45m"
          },
          "executor": {
            "delegate": {
              "target": "github_actions",
              "workflow_ref": "deploy.yml"
            }
          },
          "id": "ship",
          "inputs": [
            {
              "artifact": "pull_request",
              "from_stage": "apply"
            }
          ],
          "reviewers": {
            "agents": [
              {
                "provider": "claudecode"
              },
