    "completion": {
      "type": "object",
      "additionalProperties": false,
      "description": "POST /v0/specialist-jobs/{job_id}/result body, written by the runner. evidence may be absent ONLY on verdict inconclusive with a reason. specialistjob.ParseCompletion additionally refuses a kind that differs from the stored job's kind (ErrKindMismatch).",
      "required": [
        "schema_version",
        "execution_nonce",
        "kind",
        "verdict",
        "duration_ms"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "specialist-job-v1"
        },
        "execution_nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "reason": {
          "type": "string",
          "enum": [
            "kind_not_executable",
            "not_runnable",
            "admission_timeout",
            "materialize_failed",
            "unresolvable_sha",
            "execution_error",
            "timeout",
            "probe_error",
            "inputs_invalid",
            "not_applicable"
          ],
          "description": "Closed reason vocabulary. Required when evidence is absent."
        },
        "evidence": {
          "type": "object",
          "description": "Per-kind evidence, selected by kind via the if/then arms."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "counterfactual_battery"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-counterfactual_battery"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fanin_build"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-fanin_build"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "overlap_scan"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-overlap_scan"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plan_crosscheck"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-plan_crosscheck"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "inventory"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-inventory"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "draft"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-draft"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "evidence"
              ]
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "verdict": {
                "const": "inconclusive"
              }
            }
          }
        }
      ]
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "description": "Server-derived from the authenticated identity; never read from a request body.",
      "required": [
