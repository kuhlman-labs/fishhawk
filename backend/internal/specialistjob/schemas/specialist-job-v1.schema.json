            }
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "counterfactual_battery"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-counterfactual_battery"
              }
            }
          }
        },
        {
