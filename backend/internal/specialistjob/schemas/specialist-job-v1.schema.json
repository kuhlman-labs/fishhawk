              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-fanin_build"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "overlap_scan"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-overlap_scan"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plan_crosscheck"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-plan_crosscheck"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "inventory"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/evidence-inventory"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "draft"
              }
            },
