#!/usr/bin/env bash
# Smoke test for scripts/cleanup-merged.
# Spins up an isolated temp git repo, creates a merged and an unmerged branch,
# runs the script, and asserts the correct branches are deleted or preserved.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0
FAIL=0

tmpdir=$(mktemp -d)
tmpdir2=$(mktemp -d)
tmpdir3=$(mktemp -d)
trap 'rm -rf "$tmpdir" "$tmpdir2" "$tmpdir3"' EXIT

git -C "$tmpdir" init -q
git -C "$tmpdir" config user.email "test@example.com"
git -C "$tmpdir" config user.name "Test"

# Seed an initial commit on main so HEAD exists.
touch "$tmpdir/README"
git -C "$tmpdir" add README
git -C "$tmpdir" commit -q -m "init"

# Rename default branch to 'main' for determinism.
git -C "$tmpdir" branch -m main

pass() { echo "PASS: $1"; PASS=$((PASS + 1)); }
fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); }

# grep_q: `grep -q` for the read end of a PIPE (#4233). `grep -q` exits on its
# first match and closes the pipe; a writer with bytes still unwritten then gets
# EPIPE/SIGPIPE and `pipefail` fails the pipeline even though grep MATCHED. This
# drains stdin after grep decides. PIPE-ONLY: with a terminal on stdin it blocks.
grep_q() { local rc=0; grep -q "$@" || rc=$?; cat >/dev/null; return "$rc"; }

# Create a branch, commit to it, then merge it back into main.
git -C "$tmpdir" checkout -q -b merged-branch
echo "merged" > "$tmpdir/merged.txt"
git -C "$tmpdir" add merged.txt
git -C "$tmpdir" commit -q -m "merged commit"
git -C "$tmpdir" checkout -q main
git -C "$tmpdir" merge --no-ff -q -m "merge merged-branch" merged-branch

# Create a second merged branch that will be held by a worktree.
git -C "$tmpdir" checkout -q -b worktree-held-branch
echo "held" > "$tmpdir/held.txt"
git -C "$tmpdir" add held.txt
git -C "$tmpdir" commit -q -m "held commit"
git -C "$tmpdir" checkout -q main
git -C "$tmpdir" merge --no-ff -q -m "merge worktree-held-branch" worktree-held-branch

# Create a branch with an unmerged commit.
git -C "$tmpdir" checkout -q -b unmerged-branch
echo "unmerged" > "$tmpdir/unmerged.txt"
git -C "$tmpdir" add unmerged.txt
git -C "$tmpdir" commit -q -m "unmerged commit"
git -C "$tmpdir" checkout -q main

# Register a worktree that checks out the merged worktree-held-branch, so
# `git branch -D` would refuse it ('used by worktree').
git -C "$tmpdir" worktree add -q "$tmpdir/held-wt" worktree-held-branch
# git worktree list --porcelain reports the RESOLVED realpath (on macOS mktemp's
# /var/folders/... becomes /private/var/...), so capture the resolved path to
# assert against rather than the raw $tmpdir prefix.
held_wt_resolved="$(cd "$tmpdir/held-wt" && pwd -P)"

# Point origin/main at the local main so merge-base checks work without a remote.
git -C "$tmpdir" remote add origin "$tmpdir"
git -C "$tmpdir" fetch -q origin main

# Run the script inside the temp repo directory.
set +e
output=$(cd "$tmpdir" && bash "$REPO_ROOT/scripts/cleanup-merged" 2>&1)
status=$?
set -e

# Case 1: merged-branch should have been deleted.
if ! git -C "$tmpdir" show-ref --verify --quiet refs/heads/merged-branch; then
  pass "merged-branch was deleted"
else
  fail "merged-branch should have been deleted (output: $output)"
fi

# Case 2: unmerged-branch should still exist.
if git -C "$tmpdir" show-ref --verify --quiet refs/heads/unmerged-branch; then
  pass "unmerged-branch was preserved"
else
  fail "unmerged-branch should have been preserved (output: $output)"
fi

# Case 3: a merged branch held by a worktree must be SKIPPED, not deleted.
if git -C "$tmpdir" show-ref --verify --quiet refs/heads/worktree-held-branch; then
  pass "worktree-held-branch was preserved (held by worktree)"
else
  fail "worktree-held-branch should have been preserved (output: $output)"
fi

# Case 4: the warning names the holding worktree path (resolved realpath) and
# points at scripts/dev sweep.
if printf '%s' "$output" | grep_q -F "$held_wt_resolved" \
  && printf '%s' "$output" | grep_q -F "scripts/dev sweep"; then
  pass "warning names the holding worktree path and scripts/dev sweep"
else
  fail "warning should name '$held_wt_resolved' and 'scripts/dev sweep' (output: $output)"
fi

# Case 5: despite the skip, the script exits 0 so post-merge reaches its reload.
if [ "$status" -eq 0 ]; then
  pass "script exited 0 despite the worktree-held skip"
else
  fail "script should exit 0 (got $status; output: $output)"
fi

# ---------------------------------------------------------------------------
# Fail-open: when `git worktree list --porcelain` errors, the snapshot degrades
# to an empty string and the script preserves its prior delete behavior (a
# merged branch is still deleted, no branch is treated as held, exit 0). This
# exercises the `|| true` fallback on the snapshot line, which the main scenario
# above (where the command succeeds) cannot reach.
git -C "$tmpdir2" init -q
git -C "$tmpdir2" config user.email "test@example.com"
git -C "$tmpdir2" config user.name "Test"
touch "$tmpdir2/README"
git -C "$tmpdir2" add README
git -C "$tmpdir2" commit -q -m "init"
git -C "$tmpdir2" branch -m main

git -C "$tmpdir2" checkout -q -b merged-branch-2
echo "merged2" > "$tmpdir2/merged2.txt"
git -C "$tmpdir2" add merged2.txt
git -C "$tmpdir2" commit -q -m "merged commit 2"
git -C "$tmpdir2" checkout -q main
git -C "$tmpdir2" merge --no-ff -q -m "merge merged-branch-2" merged-branch-2

git -C "$tmpdir2" remote add origin "$tmpdir2"
git -C "$tmpdir2" fetch -q origin main

# Shim `git` so `git worktree list …` fails, forcing the fail-open snapshot
# path; every other git subcommand delegates to the real binary by absolute
# path (no PATH recursion).
shimdir="$tmpdir2/shim"
mkdir -p "$shimdir"
real_git="$(command -v git)"
cat > "$shimdir/git" <<EOF
#!/usr/bin/env bash
if [ "\$1" = "worktree" ] && [ "\$2" = "list" ]; then
  echo "simulated git worktree failure" >&2
  exit 1
fi
exec "$real_git" "\$@"
EOF
chmod +x "$shimdir/git"

set +e
output2=$(cd "$tmpdir2" && PATH="$shimdir:$PATH" bash "$REPO_ROOT/scripts/cleanup-merged" 2>&1)
status2=$?
set -e

# Case 6: fail-open — a merged branch is still deleted when the snapshot fails.
if ! git -C "$tmpdir2" show-ref --verify --quiet refs/heads/merged-branch-2; then
  pass "fail-open: merged branch deleted despite worktree-list failure"
else
  fail "fail-open: merged-branch-2 should have been deleted (status $status2; output: $output2)"
fi

# Case 7: fail-open — the script still exits 0.
if [ "$status2" -eq 0 ]; then
  pass "fail-open: script exited 0 despite the worktree-list failure"
else
  fail "fail-open: script should exit 0 (got $status2; output: $output2)"
fi

# ---------------------------------------------------------------------------
# Argument parsing (#5224 G1). The CM arms share one fixture: two merged
# branches (cm-merged-a, cm-merged-b) and one unmerged (cm-unmerged-c).
cm="$tmpdir3/repo"
git init -q "$cm"
git -C "$cm" config user.email "test@example.com"
git -C "$cm" config user.name "Test"
touch "$cm/README"
git -C "$cm" add README
git -C "$cm" commit -q -m "init"
git -C "$cm" branch -m main
for b in cm-merged-a cm-merged-b; do
  git -C "$cm" checkout -q -b "$b"
  echo "$b" > "$cm/$b.txt"
  git -C "$cm" add "$b.txt"
  git -C "$cm" commit -q -m "$b commit"
  git -C "$cm" checkout -q main
  git -C "$cm" merge --no-ff -q -m "merge $b" "$b"
done
git -C "$cm" checkout -q -b cm-unmerged-c
echo "c" > "$cm/c.txt"
git -C "$cm" add c.txt
git -C "$cm" commit -q -m "unmerged commit"
git -C "$cm" checkout -q main
git -C "$cm" remote add origin "$cm"
git -C "$cm" fetch -q origin main

cm_all_branches_survive() {
  local b
  for b in cm-merged-a cm-merged-b cm-unmerged-c; do
    git -C "$cm" show-ref --verify --quiet "refs/heads/$b" || return 1
  done
}
cm_err="$tmpdir3/stderr"

# CM-D: --dry-run fetches, lists exactly the two merged branches (not the
# unmerged one), prints the would-clean total, and deletes nothing. Without
# the dry-run guard around `git branch -D`, both merged branches are deleted.
set +e
cm_out=$(cd "$cm" && bash "$REPO_ROOT/scripts/cleanup-merged" --dry-run 2>"$cm_err")
cm_status=$?
set -e
if [ "$cm_status" -eq 0 ] \
  && printf '%s\n' "$cm_out" | grep_q -Fx "would delete (merged): cm-merged-a" \
  && printf '%s\n' "$cm_out" | grep_q -Fx "would delete (merged): cm-merged-b" \
  && ! printf '%s\n' "$cm_out" | grep_q -F "cm-unmerged-c" \
  && ! printf '%s\n' "$cm_out" | grep_q -F "deleted (merged)" \
  && printf '%s\n' "$cm_out" | grep_q -Fx "would clean 2 branch(es)"; then
  pass "CM-D: --dry-run lists exactly the two merged branches and the would-clean total"
else
  fail "CM-D: --dry-run output wrong (status $cm_status; output: $cm_out; stderr: $(cat "$cm_err"))"
fi
if cm_all_branches_survive; then
  pass "CM-D: --dry-run deleted no branch"
else
  fail "CM-D: --dry-run deleted a branch (output: $cm_out)"
fi

# The remaining arms run with origin pointed at a path that does not exist,
# so any fetch dies: an arm that exits as asserted proves it never fetched.
git -C "$cm" remote set-url origin "$tmpdir3/no-such-origin"

# CM-H: --help and -h print usage to stdout and exit 0 with no fetch and no
# deletion. Without the parse, the fetch dies (or, with a reachable origin,
# the merged branches are deleted).
for flag in --help -h; do
  set +e
  cm_out=$(cd "$cm" && bash "$REPO_ROOT/scripts/cleanup-merged" "$flag" 2>"$cm_err")
  cm_status=$?
  set -e
  if [ "$cm_status" -eq 0 ] \
    && printf '%s\n' "$cm_out" | grep_q -F -- "--help" \
    && printf '%s\n' "$cm_out" | grep_q -F -- "--dry-run" \
    && [ ! -s "$cm_err" ] && cm_all_branches_survive; then
    pass "CM-H: $flag prints usage, exits 0, no fetch, no deletion"
  else
    fail "CM-H: $flag (status $cm_status; output: $cm_out; stderr: $(cat "$cm_err"))"
  fi
done

# CM-U: an unknown argument exits 2, names the argument on stderr, and leaves
# every branch, including after a valid --dry-run. Without the unknown arm the
# argument is ignored and the script runs on to the fetch.
for args in "--bogus" "--dry-run --bogus"; do
  set +e
  # shellcheck disable=SC2086 # word-splitting the arg list is the point
  cm_out=$(cd "$cm" && bash "$REPO_ROOT/scripts/cleanup-merged" $args 2>"$cm_err")
  cm_status=$?
  set -e
  if [ "$cm_status" -eq 2 ] \
    && grep -qFx "unknown argument: --bogus" "$cm_err" \
    && grep -qF "usage:" "$cm_err" \
    && [ -z "$cm_out" ] && cm_all_branches_survive; then
    pass "CM-U: '$args' exits 2 naming the argument, no branch touched"
  else
    fail "CM-U: '$args' (status $cm_status; output: $cm_out; stderr: $(cat "$cm_err"))"
  fi
done

echo ""
echo "Results: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
