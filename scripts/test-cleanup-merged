#!/usr/bin/env bash
# Smoke test for scripts/cleanup-merged.
# Spins up an isolated temp git repo, creates a merged and an unmerged branch,
# runs the script, and asserts the correct branches are deleted or preserved.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0
FAIL=0

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

git -C "$tmpdir" init -q
git -C "$tmpdir" config user.email "test@example.com"
git -C "$tmpdir" config user.name "Test"

# Seed an initial commit on main so HEAD exists.
touch "$tmpdir/README"
git -C "$tmpdir" add README
git -C "$tmpdir" commit -q -m "init"

# Rename default branch to 'main' for determinism.
git -C "$tmpdir" branch -m main

pass() { echo "PASS: $1"; PASS=$((PASS + 1)); }
fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); }

# Create a branch, commit to it, then merge it back into main.
git -C "$tmpdir" checkout -q -b merged-branch
echo "merged" > "$tmpdir/merged.txt"
git -C "$tmpdir" add merged.txt
git -C "$tmpdir" commit -q -m "merged commit"
git -C "$tmpdir" checkout -q main
git -C "$tmpdir" merge --no-ff -q -m "merge merged-branch" merged-branch

# Create a second merged branch that will be held by a worktree.
git -C "$tmpdir" checkout -q -b worktree-held-branch
echo "held" > "$tmpdir/held.txt"
git -C "$tmpdir" add held.txt
git -C "$tmpdir" commit -q -m "held commit"
git -C "$tmpdir" checkout -q main
git -C "$tmpdir" merge --no-ff -q -m "merge worktree-held-branch" worktree-held-branch

# Create a branch with an unmerged commit.
git -C "$tmpdir" checkout -q -b unmerged-branch
echo "unmerged" > "$tmpdir/unmerged.txt"
git -C "$tmpdir" add unmerged.txt
git -C "$tmpdir" commit -q -m "unmerged commit"
git -C "$tmpdir" checkout -q main

# Register a worktree that checks out the merged worktree-held-branch, so
# `git branch -D` would refuse it ('used by worktree').
git -C "$tmpdir" worktree add -q "$tmpdir/held-wt" worktree-held-branch
# git worktree list --porcelain reports the RESOLVED realpath (on macOS mktemp's
# /var/folders/... becomes /private/var/...), so capture the resolved path to
# assert against rather than the raw $tmpdir prefix.
held_wt_resolved="$(cd "$tmpdir/held-wt" && pwd -P)"

# Point origin/main at the local main so merge-base checks work without a remote.
git -C "$tmpdir" remote add origin "$tmpdir"
git -C "$tmpdir" fetch -q origin main

# Run the script inside the temp repo directory.
set +e
output=$(cd "$tmpdir" && bash "$REPO_ROOT/scripts/cleanup-merged" 2>&1)
status=$?
set -e

# Case 1: merged-branch should have been deleted.
if ! git -C "$tmpdir" show-ref --verify --quiet refs/heads/merged-branch; then
  pass "merged-branch was deleted"
else
  fail "merged-branch should have been deleted (output: $output)"
fi

# Case 2: unmerged-branch should still exist.
if git -C "$tmpdir" show-ref --verify --quiet refs/heads/unmerged-branch; then
  pass "unmerged-branch was preserved"
else
  fail "unmerged-branch should have been preserved (output: $output)"
fi

# Case 3: a merged branch held by a worktree must be SKIPPED, not deleted.
if git -C "$tmpdir" show-ref --verify --quiet refs/heads/worktree-held-branch; then
  pass "worktree-held-branch was preserved (held by worktree)"
else
  fail "worktree-held-branch should have been preserved (output: $output)"
fi

# Case 4: the warning names the holding worktree path (resolved realpath) and
# points at scripts/dev sweep.
if printf '%s' "$output" | grep -qF "$held_wt_resolved" \
  && printf '%s' "$output" | grep -qF "scripts/dev sweep"; then
  pass "warning names the holding worktree path and scripts/dev sweep"
else
  fail "warning should name '$held_wt_resolved' and 'scripts/dev sweep' (output: $output)"
fi

# Case 5: despite the skip, the script exits 0 so post-merge reaches its reload.
if [ "$status" -eq 0 ]; then
  pass "script exited 0 despite the worktree-held skip"
else
  fail "script should exit 0 (got $status; output: $output)"
fi

echo ""
echo "Results: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
