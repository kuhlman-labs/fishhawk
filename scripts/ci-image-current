#!/usr/bin/env bash
# Is the validated image still current for the remote main tree?
# 0: equal image inputs, 1: newer inputs (skip promotion), 2: cannot decide.
# Compare trees, not only SHA: a later docs-only commit must not strand an
# otherwise-current image. Callers serialize publication and fetch main first.
set -uo pipefail
if [ "$#" -ne 3 ]; then
  echo 'usage: scripts/ci-image-current backend|gate <validated-sha> <main-sha>' >&2
  exit 2
fi
kind="$1"
validated="$2"
current="$3"
case "$kind" in
  backend)
    paths=(backend runner cli verifier directory pricing redaction credstore
      ':(glob)**/go.mod' ':(glob)**/go.sum' ':(glob)go.work*' .dockerignore
      .github/workflows/ci.yml .github/workflows/backend-build.yml)
    ;;
  gate)
    paths=(deploy/gate-image scripts/check-gate-image scripts/test
      frontend/package.json frontend/pnpm-lock.yaml scripts/check-frontend scripts/verify-change
      .github/workflows/ci.yml ':(glob).github/workflows/gate-image*.yml')
    ;;
  *) echo "unknown image kind: $kind" >&2; exit 2 ;;
esac
paths+=(scripts/ci-image-current)
# Resolve explicitly: malformed, option-like or absent revisions are never
# treated as equal. --end-of-options keeps arguments out of git's flag parser.
validated="$(git rev-parse --verify --end-of-options "$validated^{commit}")" || exit 2
current="$(git rev-parse --verify --end-of-options "$current^{commit}")" || exit 2
git diff --quiet "$validated" "$current" -- "${paths[@]}"
rc=$?
case "$rc" in
  0) exit 0 ;;
  1) echo 'Newer main changes image inputs; keeping only the commit image tag.'; exit 1 ;;
  *) echo 'Cannot compare image inputs; refusing promotion.' >&2; exit 2 ;;
esac
