#!/usr/bin/env bash
set -eu

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

for schema in "$REPO_ROOT"/docs/spec/*.schema.json; do
  base="$(basename "$schema")"
  case "$base" in
    plan-standard-*.schema.json)
      cp "$schema" "$REPO_ROOT/backend/internal/plan/schemas/$base"
      cp "$schema" "$REPO_ROOT/runner/internal/plan/schemas/$base"
      ;;
    clarification-request-*.schema.json)
      # The standard_v1 SIBLING schema (#1080) is embedded into the
      # backend plan validator only; the runner handles the
      # clarification_request outcome semantically and does not embed it.
      cp "$schema" "$REPO_ROOT/backend/internal/plan/schemas/$base"
      ;;
    workflow-v*.schema.json)
      cp "$schema" "$REPO_ROOT/backend/internal/spec/schemas/$base"
      cp "$schema" "$REPO_ROOT/cli/internal/spec/schemas/$base"
      ;;
    operator-role*.schema.json)
      cp "$schema" "$REPO_ROOT/backend/internal/operatorrole/schemas/$base"
      ;;
    work-management-v*.schema.json)
      cp "$schema" "$REPO_ROOT/backend/internal/workmgmt/schemas/$base"
      ;;
    *)
      echo "sync-schemas: unrecognized schema file '$base' — skipping (add a case to route it)" >&2
      ;;
  esac
done

# The shipped default operator role spec (ADR-040 D1) is a product
# artifact synced like the schemas, not just an example.
cp "$REPO_ROOT/docs/spec/operator-role-default.yaml" \
  "$REPO_ROOT/backend/internal/operatorrole/defaults/operator-role-default.yaml"

# The shipped default work-management conventions (#1005) are likewise a
# product artifact synced alongside the schema, not just an example.
cp "$REPO_ROOT/docs/spec/work-management-default.yaml" \
  "$REPO_ROOT/backend/internal/workmgmt/defaults/work-management-default.yaml"

# The workflow presets (ADR-048 / E29.1) are canonical product artifacts
# — the low/medium/high onboarding seeds — mirrored into both module
# sides so each embeds its own copy (the backend/cli module wall forbids
# a cross-module import). The docs/spec/*.schema.json loop above does NOT
# glob these .yaml files, so mirror them explicitly here.
for preset in "$REPO_ROOT"/docs/spec/workflow-preset-*.yaml; do
  base="$(basename "$preset")"
  cp "$preset" "$REPO_ROOT/cli/internal/spec/presets/$base"
  cp "$preset" "$REPO_ROOT/backend/internal/spec/presets/$base"
done

# The shared path-predicate fixture corpus (E53.1 / #2224) is the canonical
# proof surface for the byte-duplicated predicate matcher, mirrored into both
# module sides so the backend and cli suites run the SAME rows — CI's
# schema-sync gate red-lines if the two ever diverge. It is named
# predicate-fixtures.json (NOT *.schema.json) so the docs/spec/*.schema.json
# loop above never globs it and never emits its unrecognized-file warning.
cp "$REPO_ROOT/docs/spec/predicate-fixtures.json" \
  "$REPO_ROOT/backend/internal/spec/testdata/predicate-fixtures.json"
cp "$REPO_ROOT/docs/spec/predicate-fixtures.json" \
  "$REPO_ROOT/cli/internal/spec/testdata/predicate-fixtures.json"

# The shared acceptance-verdict fixture corpus (#2512 / E48.78) is the proof
# surface for the two hand-maintained verdict validators that CANNOT import each
# other -- validateAcceptanceVerdict in package main of runner/cmd/fishhawk-runner
# (the runner module does not require the backend module) and
# acceptanceBody.validate in backend/internal/server. Mirroring it into both
# testdata dirs makes the two suites run the SAME rows, so a twin divergence
# (sharply, a whitespace-only undecidable_reason admitted by one side) fails
# whichever side drifted; CI's schema-sync gate red-lines a mirror that itself
# drifts. Same predicate-fixtures.json idiom: named *-fixtures.json (NOT
# *.schema.json) so the docs/spec/*.schema.json loop above never globs it.
cp "$REPO_ROOT/docs/spec/acceptance-verdict-fixtures.json" \
  "$REPO_ROOT/backend/internal/server/testdata/acceptance-verdict-fixtures.json"
cp "$REPO_ROOT/docs/spec/acceptance-verdict-fixtures.json" \
  "$REPO_ROOT/runner/cmd/fishhawk-runner/testdata/acceptance-verdict-fixtures.json"

echo "schemas synced from docs/spec/"
