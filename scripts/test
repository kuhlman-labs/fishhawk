#!/usr/bin/env bash
# scripts/test — wraps the multi-module Go test + coverage gates.
#
# Mirrors the loop CI uses for the Go lane: reads registered modules
# from go.work, runs each module's tests in its own directory.
# Fail-fast on the first module whose tests fail.
#
# Usage:
#   scripts/test              run `go test -race ./...` in every module
#   scripts/test coverage     the gate above + scripts/check-coverage.py
#   scripts/test lint         run `golangci-lint run ./...` in every module
#   scripts/test verify       lint + schema-sync + tests + patch-coverage — the runner's gate
#   scripts/test verify --packages backend/internal/run,cli/internal/spec
#                             the SCOPED verify form (#3315): every non-test leg
#                             is unchanged, but the `go test -race` loop is
#                             restricted to the listed repo-relative package
#                             DIRECTORIES in the modules that own them and every
#                             other module is skipped. The patch-coverage gate is
#                             SKIPPED in this form (its denominator is the whole
#                             branch diff, which a scoped run cannot honestly
#                             gate) — the full form still runs it. Falls back to
#                             $FISHHAWK_VERIFY_PACKAGES when the flag is absent.
#   scripts/test single ARGS  pass-through to `go test -race ARGS`
#                             example:
#                             scripts/test single -run TestX ./backend/internal/version/...
#
# `verify` (both forms) takes a per-repository lock in the shared git common dir
# so two verifies never contend on golangci-lint's global lock or the shared
# testcontainers Postgres. A SHELL-kind invocation meeting a live holder REFUSES
# immediately (it does not poll); a RUNNER-kind one (FISHHAWK_VERIFY_LOCK_OWNER=
# runner) waits up to 600s. Long form: scripts/README.md.
#
# Frontend gates (pnpm format:check / typecheck / test) are NOT
# covered here — they have their own conventions per docs/.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# Directory of THIS script (the real scripts/), captured from BASH_SOURCE so it
# is stable even when a test harness sources scripts/test lib-only and overrides
# ROOT to a throwaway repo under test. The patch-coverage gate locates its
# sibling check-coverage.py here rather than under $ROOT: $ROOT is the git repo
# the gate operates ON (which the harness redirects), whereas check-coverage.py
# always lives next to this file. In production the two coincide.
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Signing-agnostic isolation (#912): make every test that creates a temp repo
# and commits ignore the operator's global/system git config. Otherwise a
# global commit.gpgsign=true is inherited and red-lines the verify gate when
# the external signing agent (e.g. 1Password op-ssh-sign) is unavailable.
# Exported once here, so go test and its exec.Command("git", ...) children
# inherit it via os.Environ(). In-repo git ops are unaffected: the repo-local
# .git/config commit.gpgsign=false takes precedence over the now-absent global.
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null

# Disable the testcontainers ryuk reaper (#972 cascade). It is a SHARED, single-
# point-of-failure container: under Docker-daemon load the reaper itself times
# out starting ("reaper: new reaper: run container: ... context deadline
# exceeded"), and every package that then tries to register with the dead reaper
# fails ("No such container: <reaper-id>"), cascading one flake into a whole-
# suite red. Disabling ryuk removes that shared dependency so a slow container
# start can at worst flake ONE package (which the runner's verify gate absorbs),
# never the cascade. Disabling ryuk is also what lets the single shared
# fishhawk-test-postgres container (internal/pgtest, #1174) PERSIST across the
# per-package test processes that reuse it — it is reaped by the EXIT trap below
# instead of by ryuk. (The exempt internal/postgres MigrateUp/MigrateDown tests
# start their OWN random-named throwaway containers and Terminate each via
# t.Cleanup on BOTH the success and the start-error path — the latter added in
# #3122, where the missing error-path cleanup leaked a container per start
# timeout and eventually failed a verify gate category-A.) CI runners and
# `scripts/dev` are ephemeral / pruned, but a developer daemon is NOT, so orphan
# reaping IS relied upon here: the generation-keyed sweep in _reap_shared_container
# (#3122) is the backstop for a container whose test binary was SIGKILLed before
# its t.Cleanup ran. Covers the runner's `scripts/test verify` too, since it
# sources this script.
export TESTCONTAINERS_RYUK_DISABLED=true

# Concurrent-invocation lease refcount for the shared testcontainers Postgres
# (#1174 reuse design, #1792 collision fix). internal/pgtest deliberately does
# NOT Terminate fishhawk-test-postgres (it is reused across every package's test
# process while ryuk is disabled above), so scripts/test reaps it via the EXIT
# trap below. That was safe for concurrent PROCESSES within one invocation but
# NOT for concurrent INVOCATIONS: a first invocation's EXIT trap would docker-rm
# the shared container out from under a second invocation whose go test loop
# still held live connections (the #1587/#1589 spurious verify failure).
#
# Fix: lease-count the container across concurrent scripts/test invocations.
# Each container-using invocation registers a per-invocation lease file (named
# by its PID) in a shared lease directory under a mkdir-based lock; the EXIT
# trap removes only its OWN lease and docker-rm's the container only when no
# leases remain (rmdir of the now-empty lease dir succeeds). Stale leases left
# by a SIGKILL'd invocation are pruned by a `kill -0` PID liveness check so a
# crashed run never permanently pins the container. LEASE_DIR / LEASE_TOKEN are
# overridable to make the refcount contract hermetically testable
# (scripts/test-container-lease).
LEASE_DIR="${FISHHAWK_TEST_LEASE_DIR:-${TMPDIR:-/tmp}/fishhawk-test-postgres.leases}"

# Generation-keyed orphan snapshot + sweep (#3122). backend/internal/postgres/
# postgres_test.go is the documented pgtest exemption: it needs raw, un-migrated
# throwaway databases, so it starts its OWN anonymous testcontainers Postgres
# containers rather than reusing the shared fishhawk-test-postgres. With ryuk
# disabled above nothing reaps those, and they accumulate across invocations
# until a loaded daemon fails a verify gate category-A against packages the change
# never touched (the #3122 signature). The Go-side t.Cleanup fix (postgres_test.go)
# is the root repair; this is defence in depth for a container whose test binary
# was SIGKILLed before its Cleanup ran, or one created by an overlapping
# invocation that exited without sweeping.
#
# The boundary is the one the lease already owns: a GENERATION opens when
# $LEASE_DIR first comes into existence and closes on the successful `rmdir` the
# last-holder reap already uses. The FIRST holder to arm records the set of
# testcontainers-labelled containers that PREDATE the generation into a SIBLING
# snapshot file ($LEASE_DIR.snapshot — a sibling, NEVER inside $LEASE_DIR, whose
# emptiness the last-holder rmdir depends on); later holders reuse it unchanged.
# The last holder removes every labelled container ABSENT from that snapshot
# (i.e. created DURING the generation) and deletes the snapshot — all INSIDE the
# lock, so a concurrent invocation cannot arm between rmdir and the removal and
# have its fresh snapshot deleted. Pre-generation containers are SPARED by design
# and reported by the preflight instead. Degrades to a no-op — never a
# remove-everything fallback — when the snapshot is missing/unreadable, docker is
# absent, or FISHHAWK_TEST_NO_ORPHAN_SWEEP is set. The snapshot path is inline
# "$LEASE_DIR.snapshot" (as "$LEASE_DIR.lock" is) so it tracks a per-invocation
# FISHHAWK_TEST_LEASE_DIR override.

# _labelled_container_ids: the current testcontainers-labelled container id set,
# one id per line. Two DISTINCT outcomes, never conflated: docker ABSENT is a
# clean no-op (empty output, exit 0) so every caller degrades to a no-op; a docker
# PRESENT-but-failing query (daemon down, transient error) PROPAGATES docker's
# non-zero exit — deliberately NOT `|| true`. A snapshot writer must be able to
# tell a genuine empty set from a failed query and DECLINE to publish an empty
# snapshot on failure (#3122): swallowing the failure would let a later daemon
# recovery make the last-holder sweep treat every labelled container as
# generation-created and remove unrelated testcontainers workloads.
_labelled_container_ids() {
  command -v docker >/dev/null 2>&1 || return 0
  docker ps -aq --filter label=org.testcontainers=true 2>/dev/null
}

# _write_generation_snapshot: record the labelled-container set that exists at
# generation-open time, written atomically (temp sibling then mv) so a concurrent
# reader never sees a partial file. Guarded to never fail the run. Callers hold
# the lock. DECLINE-TO-PUBLISH on a failed query (#3122): _labelled_container_ids
# propagates docker's non-zero exit when the daemon is present but the query
# fails, so the `if` goes false and NO snapshot is published — leaving any prior
# snapshot untouched and, when none exists, leaving the sweep to degrade to a
# no-op rather than publishing an EMPTY snapshot that a later daemon recovery
# would turn into a remove-everything sweep.
_write_generation_snapshot() {
  command -v docker >/dev/null 2>&1 || return 0
  local tmp="$LEASE_DIR.snapshot.tmp.$$"
  if _labelled_container_ids > "$tmp" 2>/dev/null; then
    mv "$tmp" "$LEASE_DIR.snapshot" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
  else
    rm -f "$tmp" 2>/dev/null || true
  fi
  return 0
}

# _preflight_orphan_warn: non-fatal WARNING when the just-written generation
# snapshot already holds more than ORPHAN_WARN_AT labelled containers — they
# predate this run and are spared by the sweep on purpose. Printed to STDERR,
# which the runner captures via CombinedOutput into the category-A FailureReason,
# so the count lands in the operator-visible failure text with no runner change
# (#3122 proposals 3/4). Fires ONLY for the invocation that OPENS a generation;
# one JOINING an already-open generation on a littered daemon warns nothing
# (a deliberate residual). Callers hold the lock.
_preflight_orphan_warn() {
  command -v docker >/dev/null 2>&1 || return 0
  [ -r "$LEASE_DIR.snapshot" ] || return 0
  local count
  count="$(grep -c . "$LEASE_DIR.snapshot" 2>/dev/null)" || true
  case "$count" in ''|*[!0-9]*) count=0 ;; esac
  # Read the threshold at USE time (not a frozen top-level var), so a per-
  # invocation FISHHAWK_TEST_ORPHAN_WARN_AT is honoured — matching how
  # FISHHAWK_TEST_NO_ORPHAN_SWEEP is read inline. Dev-only: the runner strips
  # FISHHAWK_* from the gate env, so in-loop this is always the default 4.
  local warn_at="${FISHHAWK_TEST_ORPHAN_WARN_AT:-4}"
  case "$warn_at" in ''|*[!0-9]*) warn_at=4 ;; esac
  if [ "$count" -gt "$warn_at" ]; then
    {
      printf 'scripts/test: WARNING: %d pre-existing testcontainers-labelled container(s) on this daemon before this run.\n' "$count"
      printf 'scripts/test: they predate this run and are SPARED by the generation sweep on purpose; remove them with:\n'
      printf 'scripts/test:   docker rm -f $(docker ps -aq --filter label=org.testcontainers=true)\n'
    } >&2
  fi
  return 0
}

# _sweep_generation_orphans: last-holder-only. Remove every labelled container
# ABSENT from the generation snapshot — created DURING this lease generation,
# including by an overlapping invocation that exited ref-held and swept nothing.
# Degrades to a no-op (NEVER remove-everything) when the opt-out is set, docker is
# absent, or the snapshot is missing/unreadable. Every command is guarded so it
# can never fail the run. Callers hold the lock.
_sweep_generation_orphans() {
  [ -z "${FISHHAWK_TEST_NO_ORPHAN_SWEEP:-}" ] || return 0
  command -v docker >/dev/null 2>&1 || return 0
  [ -r "$LEASE_DIR.snapshot" ] || return 0
  local removed=0 id
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    if ! grep -qxF "$id" "$LEASE_DIR.snapshot" 2>/dev/null; then
      docker rm -f "$id" >/dev/null 2>&1 || true
      removed=$((removed + 1))
    fi
  done <<EOF
$(_labelled_container_ids)
EOF
  if [ "$removed" -gt 0 ]; then
    printf 'scripts/test: swept %d orphaned testcontainers container(s) created during this run (#3122).\n' "$removed" >&2
  fi
  return 0
}

# _lease_token: this invocation's lease identity (its PID by default). Injectable
# so the hermetic test can register/reap distinct synthetic leases.
_lease_token() {
  printf '%s' "${FISHHAWK_TEST_LEASE_TOKEN:-$$}"
}

# _lease_lock: acquire the lock guarding the register/reap critical sections.
# The lock is an atomically-created SYMLINK whose target IS the holder's owner
# PID, so it carries its owner from the instant it exists: symlink(2) is a single
# atomic syscall that fails EEXIST if the path is already taken, and there is NO
# separate stamp step. Exactly one racer wins; the loser reads the winner's PID
# via `readlink`. Before each retry the spin loop breaks a lock whose owner PID
# is dead (`kill -0` fails → rm, then retry) so a SIGKILL'd holder can never
# permanently wedge later invocations.
#
# Because acquisition is atomic there is NO window in which the lock exists yet
# is unowned. That eliminates BY CONSTRUCTION both the old mkdir-then-stamp lock's
# ownerless-forever wedge (a holder SIGKILL'd between mkdir and stamping) AND its
# live-but-delayed acquisition race (a live holder paused before stamping whose
# "ownerless" lock a concurrent breaker could remove and then double-enter the
# critical section, #1792 fixup). A grace-window heuristic could only trade those
# two off; the symlink carries its owner atomically so a live holder's lock can
# never be seen as ownerless and broken out from under it. An empty/garbage link
# target is therefore never a live claim — only a crash leftover, a corrupt link,
# or a stray inner link left when `ln -s` landed inside a leftover dir-form lock
# (the readlink-equals-$$ re-check catches that) — and is safe to break.
#
# Returns non-zero if the bounded retry cap is exhausted with a LIVE owner still
# holding it (stuck) — callers must then fail SAFE (never docker-rm under an
# uncertain lease state).
_lease_lock() {
  local lock="$LEASE_DIR.lock"
  local cap="${FISHHAWK_TEST_LEASE_LOCK_CAP:-50}"
  local tries=0 owner
  # Atomic acquire: ln -s creates the lock with our PID as its target in one
  # syscall. The readlink-equals-$$ re-check rejects the case where ln "succeeded"
  # by landing a stray link inside a leftover dir-form lock (which the break
  # branch below then clears), so only a genuine atomic claim returns success.
  while ! { ln -s "$$" "$lock" 2>/dev/null && [ "$(readlink "$lock" 2>/dev/null)" = "$$" ]; }; do
    owner="$(readlink "$lock" 2>/dev/null || true)"
    case "$owner" in
      ''|*[!0-9]*)
        # No/garbage owner target: NOT a live-holder claim (a live acquire always
        # carries its PID atomically). A crash leftover, corrupt link, or stray
        # inner link from an older dir-form lock — break it and retry.
        rm -rf "$lock" 2>/dev/null || true
        ;;
      *)
        if ! kill -0 "$owner" 2>/dev/null; then
          rm -f "$lock" 2>/dev/null || true  # dead owner → break the stale lock
        fi
        ;;
    esac
    tries=$((tries + 1))
    if [ "$tries" -ge "$cap" ]; then
      return 1
    fi
    sleep 0.1
  done
  return 0
}

_lease_unlock() {
  rm -rf "$LEASE_DIR.lock" 2>/dev/null || true
}

# _prune_dead_leases: drop lease files whose PID name no longer names a live
# process — crashed-invocation cleanup so a SIGKILL'd run never pins the
# container. Guards the empty glob and skips non-numeric names. Callers hold the
# lock.
_prune_dead_leases() {
  [ -d "$LEASE_DIR" ] || return 0
  local f base
  for f in "$LEASE_DIR"/*; do
    [ -e "$f" ] || continue  # empty-glob guard
    base="$(basename "$f")"
    case "$base" in
      ''|*[!0-9]*) continue ;;  # non-PID lease name — can't liveness-check, leave it
    esac
    if ! kill -0 "$base" 2>/dev/null; then
      rm -f "$f" 2>/dev/null || true
    fi
  done
}

# _register_lease: record this invocation's lease under the lock. Returns
# non-zero when it did NOT record a lease — no Docker (nothing to refcount) or a
# live-but-stuck lock the retry cap could not acquire. The caller MUST treat a
# non-zero return as "hold no lease" and NOT arm the reap: an invocation that
# never recorded a lease must never docker-rm the shared container, or it could
# reap it out from under a peer whose lease it never got the lock to see (the
# register-timeout lifecycle hole).
_register_lease() {
  command -v docker >/dev/null 2>&1 || return 1
  _lease_lock || return 1  # lock stuck → hold NO lease; caller must NOT arm reap
  # A generation opens when $LEASE_DIR is ABSENT: this holder is the first to arm,
  # so it records the pre-existing labelled set. A holder JOINING an already-open
  # generation (dir present, snapshot present) reuses the snapshot UNCHANGED — a
  # container created mid-generation must NOT be captured as pre-existing, or the
  # last holder would spare it (the per-invocation-snapshot defect this keying
  # fixes). A dir present with NO snapshot is a crash leftover: (re)write one from
  # the current set, which spares live containers — the fail-safe direction.
  local opening_generation=0
  [ -d "$LEASE_DIR" ] || opening_generation=1
  mkdir -p "$LEASE_DIR" 2>/dev/null || true
  _prune_dead_leases
  : > "$LEASE_DIR/$(_lease_token)" 2>/dev/null || true
  if [ "$opening_generation" = "1" ] || [ ! -f "$LEASE_DIR.snapshot" ]; then
    _write_generation_snapshot
    _preflight_orphan_warn
  fi
  _lease_unlock
  return 0
}

# Per-invocation coverage-profile scratch dir for the patch-coverage gate. It is
# keyed by PID (as the container leases are) and lives OUTSIDE the repo, so two
# concurrent `scripts/test verify` invocations can never share, corrupt, or
# delete each other's profile, no fixed in-repo filename is ever clobbered, and
# no build artifact is left in the working tree. Removed by the EXIT trap below,
# so an early test failure cannot leave litter behind.
PATCHCOV_DIR=""
LEASE_ARMED=0

# Verify-lock state (#3315). VERIFY_LOCK_HELD is the lock path THIS invocation
# actually acquired (empty when it refused, degraded, or was stolen from);
# VERIFY_LOCK_TARGET is the `<pid>:<kind>` link target it wrote, re-read before
# release so a lock that no longer names us is never removed. VERIFY_PRUNE_MARKER
# is the prune-serialising marker while this invocation holds it.
VERIFY_LOCK_HELD=""
VERIFY_LOCK_TARGET=""
VERIFY_PRUNE_MARKER=""

# Integrity anchor for the pre-test change-set snapshot (#2124). Computed by the
# PARENT shell from the pristine snapshot BEFORE the go-test loop and held only
# here in parent memory — never written to a test-reachable path, never exported
# into a test subprocess. At consume time it is handed to check-coverage.py,
# which re-hashes the on-disk snapshot and FAILS CLOSED on any mismatch, so a
# test that rewrites the snapshot mid-loop is detected rather than silently
# skipping the gate. The digest makes tampering tamper-EVIDENT, not impossible
# (a same-user test can still write the file); full prevention needs test-loop
# isolation (ADR-063 / #2127).
PATCHCOV_SNAPSHOT_DIGEST=""

# _sha256_file <path>: print the lowercase hex sha256 of a file, or return
# non-zero if no sha256 tool is available or the file cannot be read. Tries
# sha256sum (Linux/CI) then shasum -a 256 (macOS, ships with Perl). The output
# byte-matches Python's hashlib.sha256(...).hexdigest() over the same bytes, so
# the parent-computed anchor and the Python re-hash compare equal.
_sha256_file() {
  local f="$1" out
  if command -v sha256sum >/dev/null 2>&1; then
    out="$(sha256sum "$f" 2>/dev/null)" || return 1
  elif command -v shasum >/dev/null 2>&1; then
    out="$(shasum -a 256 "$f" 2>/dev/null)" || return 1
  else
    return 1
  fi
  [ -n "$out" ] || return 1
  printf '%s' "${out%% *}"
}

_patchcov_cleanup() {
  if [ -n "$PATCHCOV_DIR" ]; then
    rm -rf "$PATCHCOV_DIR" 2>/dev/null || true
  fi
}

# The single EXIT handler. It always sweeps the coverage scratch dir and reaps
# the shared container ONLY when this invocation actually recorded a lease —
# an invocation holding no lease must never docker-rm the container out from
# under a peer (#1792). Kept as one string so both arming sites install the
# identical handler.
EXIT_TRAP='_release_verify_lock; _patchcov_cleanup; if [ "${LEASE_ARMED:-0}" = "1" ]; then _reap_shared_container; fi'

# _patchcov_mktemp: create the per-invocation profile dir and arm the EXIT trap.
# Returns non-zero (never aborts) if the dir cannot be created — the caller then
# degrades to the plain test loop.
#
# The dir is created by `mktemp -d`, which creates ATOMICALLY (mode 0700) and
# fails rather than reusing an existing path. Deliberately NOT `rm -rf` then
# `mkdir`: removing a pre-created path both destroys whatever is there and opens
# a remove→create window in which a local attacker could substitute the scratch
# dir (or a symlink to one) and steer where profiles are written. The PID stays
# in the name (as the container leases are PID-keyed) for provenance; the mktemp
# suffix is what makes collision and clobber impossible.
_patchcov_mktemp() {
  if ! PATCHCOV_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fishhawk-patchcov-$$.XXXXXX" 2>/dev/null)"; then
    PATCHCOV_DIR=""
    return 1
  fi
  if [ -z "$PATCHCOV_DIR" ] || [ ! -d "$PATCHCOV_DIR" ]; then
    PATCHCOV_DIR=""
    return 1
  fi
  trap "$EXIT_TRAP" EXIT
  return 0
}

# _arm_container_lease: register this invocation's lease and arm the reap trap
# ONLY if the lease was actually recorded. Replaces the bare EXIT trap at the top
# of cmd_test / cmd_coverage. If registration failed (no Docker, or a live-stuck
# lock), we hold no lease and deliberately do NOT arm the reap — the container is
# left for a lease-holding invocation to reap, never removed under an uncertain
# lease state.
_arm_container_lease() {
  if _register_lease; then
    LEASE_ARMED=1
    trap "$EXIT_TRAP" EXIT
  fi
}

# _reap_shared_container: EXIT-trap teardown. Remove ONLY this invocation's lease
# and docker-rm the shared container only when no leases remain. Fails SAFE on an
# unacquirable lock (a live-but-stuck owner): skip docker rm and leave the
# container for the next invocation's attach-reuse, never removing it under an
# uncertain lease state. Guarded to be a no-op when Docker is absent and to never
# fail the run.
_reap_shared_container() {
  command -v docker >/dev/null 2>&1 || return 0
  if ! _lease_lock; then
    return 0  # lock stuck (live owner) → fail safe, leave the container
  fi
  rm -f "$LEASE_DIR/$(_lease_token)" 2>/dev/null || true
  _prune_dead_leases
  if rmdir "$LEASE_DIR" 2>/dev/null; then
    docker rm -f fishhawk-test-postgres >/dev/null 2>&1 || true
    # Last holder. Sweep the generation's orphans and drop the snapshot INSIDE
    # the lock (#3122, condition 4): if these ran after _lease_unlock a concurrent
    # invocation could arm between the rmdir and the snapshot removal, open a new
    # generation, write a fresh snapshot, and have us delete it — silently
    # disabling its sweep. Holding the lock across rmdir → sweep → removal closes
    # that window.
    _sweep_generation_orphans
    rm -f "$LEASE_DIR.snapshot" "$LEASE_DIR.snapshot.tmp."* 2>/dev/null || true
  fi
  _lease_unlock
  return 0
}

modules() {
  go work edit -json | jq -r '.Use[].DiskPath'
}

# _module_list: the module list, or non-zero when it is unavailable or empty.
# The test loops consume this instead of piping `modules` straight into a `while
# read`, where a failing `modules` yields ZERO iterations and the loop reports
# success having run no tests at all.
_module_list() {
  local mlist
  if ! mlist="$(modules 2>/dev/null)"; then
    return 1
  fi
  if [ -z "$mlist" ]; then
    return 1
  fi
  printf '%s\n' "$mlist"
}

# Message for the fail-closed branch below. A test loop that enumerated no
# modules must never exit 0 — that is a green gate that ran nothing. This is NOT
# the patch-coverage gate failing (that one always degrades to the plain loop);
# it is the plain loop being unable to run at all.
NO_MODULES_MSG="scripts/test: could not enumerate go.work modules (go/jq unavailable, or an empty go.work) — refusing to report success without running any tests"

# Full-suite test-binary parallelism (#972, #1174). Historically every backend
# package started its OWN testcontainers Postgres, so at the default -p
# (~GOMAXPROCS) a developer-Mac Docker daemon intermittently timed out starting
# one ("context deadline exceeded" after 9 retries against docker.sock) — pure
# load contention, not a real bug — and the bound was lowered 4 -> 2 to halve
# concurrent container starts.
#
# As of #1174 the backend integration tests share a SINGLE Postgres container
# (internal/pgtest): the first package to need it starts fishhawk-test-postgres,
# every other package attaches to it by name (testcontainers WithReuseByName),
# and each test gets a cheap per-test database cloned from a migrated template.
# There is no longer a container start per package, so the start-contention that
# forced -p 2 is gone — concurrent first-starts converge to the one shared
# container via pgtest's bounded attach-retry on the docker name conflict.
# Restored 2 -> 4 (#1174), proven by a full -p 4 run showing exactly one
# fishhawk-test-postgres via `docker ps`. `go test -p n` still caps concurrent
# test binaries; lower it on a constrained daemon with FISHHAWK_TEST_P (e.g.
# FISHHAWK_TEST_P=2). `single` runs are unbounded.
TEST_P="${FISHHAWK_TEST_P:-4}"

cmd_test() {
  local mlist m
  if ! mlist="$(_module_list)"; then
    echo "$NO_MODULES_MSG" >&2
    exit 1
  fi
  _arm_container_lease
  while IFS= read -r m; do
    printf '>>> %s\n' "$m"
    (cd "$m" && go test -race -p "$TEST_P" ./...)
  done <<< "$mlist"
}

# --------------------------------------------------------------------------
# Scoped verify (#3315)
#
# The runner's in-loop verify gate re-runs the WHOLE `go test -race ./...` loop
# on every fix-up iteration, which is where a 25-40 minute implement stage comes
# from. `scripts/test verify --packages <repo/rel/pkg,...>` (or the
# FISHHAWK_VERIFY_PACKAGES env fallback the runner injects) restricts ONLY that
# loop to the listed packages in the modules that own them; every other module is
# skipped entirely, which is where the saving comes from.
#
# Everything else is deliberately UNCHANGED in scoped mode: lint, the doc-line
# budget, schema-sync, the gate harnesses and both site gates all still run, so
# the agent keeps its fastest lint/format feedback. The one thing that is not run
# is the patch-coverage gate — see cmd_verify for why.
#
# FAIL-SAFE DIRECTION: a scoped run must never silently test LESS than the
# caller asked for. So a package this layer cannot bucket (owned by no go.work
# module, or carrying a tab/newline its own `<module>\t<pkgs>` encoding cannot
# present) prints a one-line reason and returns non-zero, and cmd_verify then
# WIDENS to the full unscoped loop. That mirrors _patch_cov_all_modules' precedent
# of paying more rather than dropping a file out of a gate's reach.
# --------------------------------------------------------------------------

# The package list in force for this invocation, set by _parse_verify_args from
# the --packages flag or the FISHHAWK_VERIFY_PACKAGES fallback. Empty means the
# full unscoped form, which is byte-for-byte what verify did before #3315.
VERIFY_PACKAGES=""

# _parse_verify_args: consume `verify`'s own options. CLI beats the environment
# when both are present. A `--packages` given with an EMPTY value is a CALLER
# BUG, not a request to run unscoped: silently widening would hide a runner-side
# defect that produced an empty list, so it exits 1 with the usage line.
_parse_verify_args() {
  local seen_flag=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --packages)
        if [ "$#" -lt 2 ]; then
          echo "scripts/test: --packages requires a comma-separated package list" >&2
          usage >&2
          exit 1
        fi
        VERIFY_PACKAGES="$2"
        seen_flag=1
        shift 2
        ;;
      --packages=*)
        VERIFY_PACKAGES="${1#--packages=}"
        seen_flag=1
        shift
        ;;
      *)
        echo "scripts/test: unknown verify option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
  if [ "$seen_flag" = "1" ]; then
    if [ -z "$VERIFY_PACKAGES" ]; then
      echo "scripts/test: --packages requires a non-empty comma-separated package list" >&2
      usage >&2
      exit 1
    fi
    return 0
  fi
  VERIFY_PACKAGES="${FISHHAWK_VERIFY_PACKAGES:-}"
}

# _verify_scope_buckets <comma-separated repo-relative package dirs>: emit one
# `<module>\t./pkg ./pkg2` line per owning go.work module, using the same
# longest-prefix module match _patch_cov_changed_modules uses. Returns non-zero
# (after printing a one-line reason) for every input this layer cannot bucket, so
# the caller widens to the full loop.
_verify_scope_buckets() {
  local list="$1" mlist p cand m rel pairs=""
  case "$list" in
    *$'\n'*|*$'\t'*)
      echo "scripts/test: --packages value contains a tab or newline this layer cannot present — running the full test loop" >&2
      return 1
      ;;
  esac
  if ! mlist="$(modules 2>/dev/null)" || [ -z "$mlist" ]; then
    echo "scripts/test: could not enumerate go.work modules to scope --packages — running the full test loop" >&2
    return 1
  fi
  while IFS= read -r p; do
    p="${p#./}"
    p="${p%/}"
    if [ -z "$p" ]; then
      echo "scripts/test: --packages contains an empty entry — running the full test loop" >&2
      return 1
    fi
    m=""
    while IFS= read -r cand; do
      cand="${cand#./}"
      cand="${cand%/}"
      if [ -z "$cand" ]; then continue; fi
      if [ "$p" = "$cand" ] || [ "${p#"$cand"/}" != "$p" ]; then
        if [ "${#cand}" -gt "${#m}" ]; then m="$cand"; fi
      fi
    done <<< "$mlist"
    if [ -z "$m" ]; then
      echo "scripts/test: --packages entry '$p' is not inside any go.work module — running the full test loop" >&2
      return 1
    fi
    if [ "$p" = "$m" ]; then rel="."; else rel="./${p#"$m"/}"; fi
    pairs="$pairs$m	$rel
"
  done <<< "$(printf '%s' "$list" | tr ',' '\n')"
  if [ -z "$pairs" ]; then
    echo "scripts/test: --packages produced no packages — running the full test loop" >&2
    return 1
  fi
  printf '%s' "$pairs" | sort -u | awk -F'\t' '
    { if ($1 != cur) { if (cur != "") print cur "\t" acc; cur = $1; acc = $2 }
      else acc = acc " " $2 }
    END { if (cur != "") print cur "\t" acc }'
}

# cmd_test_scoped <buckets>: cmd_test's loop restricted to the bucketed packages.
# A module with no listed package is SKIPPED (printed, so the saving is visible in
# the log). It arms the container lease exactly as cmd_test does — a scoped loop
# still touches the shared testcontainers Postgres — and fails closed on an
# unavailable/empty module list with cmd_test's NO_MODULES_MSG contract.
cmd_test_scoped() {
  local buckets="$1" mlist m mm pp pkgs ran=0
  if ! mlist="$(_module_list)"; then
    echo "$NO_MODULES_MSG" >&2
    exit 1
  fi
  _arm_container_lease
  while IFS= read -r m; do
    pkgs=""
    while IFS=$'\t' read -r mm pp; do
      if [ "${mm#./}" = "${m#./}" ]; then pkgs="$pp"; fi
    done <<< "$buckets"
    if [ -z "$pkgs" ]; then
      printf '>>> %s (no scoped packages — skipped)\n' "$m"
      continue
    fi
    printf '>>> %s %s\n' "$m" "$pkgs"
    # Word-splitting $pkgs is intentional: it is a space-joined list of ./pkg
    # arguments this script built itself, and _verify_scope_buckets already
    # refused any entry carrying whitespace.
    # shellcheck disable=SC2086
    (cd "$m" && go test -race -p "$TEST_P" $pkgs)
    ran=$((ran + 1))
  done <<< "$mlist"
  # Defence in depth against the module list changing between bucketing and this
  # loop: a scoped loop that matched NO module must never exit 0, for the same
  # reason _module_list fails closed — that is a green gate that ran nothing.
  if [ "$ran" -eq 0 ]; then
    echo "scripts/test: scoped verify matched no go.work module — refusing to report success without running any tests" >&2
    exit 1
  fi
}

cmd_coverage() {
  _arm_container_lease
  local profiles=()
  while IFS= read -r m; do
    printf '>>> %s\n' "$m"
    (cd "$m" && go test -race -p "$TEST_P" -coverprofile=coverage.out -covermode=atomic ./...)
    profiles+=("$m/coverage.out")
  done < <(modules)
  python3 "$ROOT/scripts/check-coverage.py" --threshold 80 --exclude '/db/' "${profiles[@]}"
}

# Fail CLOSED if golangci-lint is missing: the verify gate must never silently
# skip lint and re-open the gofmt/lint-drift-to-CI gap (#1064). Name the v2.x
# install pin (the v2.8.0 install.sh tag CI uses, per AGENTS.md / ci.yml) so the
# error is actionable. A v1 binary rejects this repo's v2-format .golangci.yml,
# so v2.x is required.
_require_golangci_lint() {
  if ! command -v golangci-lint >/dev/null 2>&1; then
    cat >&2 <<'EOF'
scripts/test: golangci-lint not found on PATH (required for `lint`/`verify`).
Install golangci-lint v2.x (this repo's .golangci.yml is v2-format; v1 rejects it):
  curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/v2.8.0/install.sh \
    | sh -s -- -b "$(go env GOPATH)/bin" v2.8.0
EOF
    exit 1
  fi
}

cmd_lint() {
  _require_golangci_lint
  while IFS= read -r m; do
    printf '>>> %s\n' "$m"
    (cd "$m" && golangci-lint run ./...)
  done < <(modules)
}

# _verify_schema_sync: mirror CI's 'Schema sync (docs/spec ↔ embedded copies)'
# step (ci.yml) inside the verify gate so an implement pass that edits a
# canonical docs/spec/ file (or a mirrored default/preset) WITHOUT running
# scripts/sync-schemas fails IN-LOOP with CI's exact actionable message, instead
# of passing verify and then red-lining the required CI Pass check after the
# agent is terminal (#1064/#1772).
#
# Unlike CI's unscoped `git diff --exit-code`, this snapshots
# `git status --porcelain` before and after running sync-schemas and fails only
# if the porcelain output CHANGED — so a developer running verify on a dirty tree
# fails only on drift sync-schemas itself introduces, not on unrelated pending
# edits. On the runner's committed (clean) run-branch tree the two forms are
# equivalent. sync-schemas is a pure cp-only file mirror (set -eu), so an
# already-synced tree is a no-op that leaves the porcelain output unchanged.
#
# Guarded to a no-op (return 0, one-line stderr warning) when git is absent or
# $ROOT is not a git work tree — the check needs git to diff, and the runner
# always runs verify inside the committed worktree so the real path fires there.
_verify_schema_sync() {
  if ! command -v git >/dev/null 2>&1; then
    echo "scripts/test: git not found — skipping schema-sync drift check" >&2
    return 0
  fi
  # `--is-inside-work-tree` prints `true`/`false` and, in a BARE repo, prints
  # `false` yet exits 0 — so guard on the printed value, not just the exit
  # status, or a bare-repo $ROOT falls through to `git status --porcelain`
  # (which errors in a bare repo) instead of the documented return-0 no-op.
  if [ "$(git -C "$ROOT" rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]; then
    echo "scripts/test: $ROOT is not a git work tree — skipping schema-sync drift check" >&2
    return 0
  fi
  local before after
  before="$(git -C "$ROOT" status --porcelain)"
  "$ROOT/scripts/sync-schemas" >/dev/null
  after="$(git -C "$ROOT" status --porcelain)"
  if [ "$before" != "$after" ]; then
    echo "Embedded schema copies drifted from docs/spec/. Run scripts/sync-schemas and commit the result." >&2
    exit 1
  fi
}

# _verify_doc_line_budget: cap docs/ARCHITECTURE.md line length at 1000 chars.
# The Read tool agents use truncates lines around 2000 chars, so a fat
# "Where to look" table row is silently unreadable past that point — at its
# worst the file hid ~195KB (35%) of its content that way. The budget keeps
# §10 rows as pointers (path + one sentence); long-form contracts belong in
# the package's README.md next to the code (see AGENTS.md "Documentation
# surfaces"). 1000 leaves headroom for a legitimately dense row while staying
# far below the truncation cliff.
_verify_doc_line_budget() {
  local doc="$ROOT/docs/ARCHITECTURE.md" offenders
  [ -f "$doc" ] || return 0
  offenders="$(awk 'length($0) > 1000 { print FILENAME ":" FNR " (" length($0) " chars)" }' "$doc")"
  if [ -n "$offenders" ]; then
    cat >&2 <<EOF
docs/ARCHITECTURE.md has lines over the 1000-char budget:
$offenders
"Where to look" rows are pointers — path + one sentence. Move the long-form
contract into the owning package's README.md and link it from the row.
EOF
    exit 1
  fi
}

# --------------------------------------------------------------------------
# Patch-scoped coverage gate (#1887 / ADR-059)
#
# CI enforces only the whole-repo AGGREGATE floor, and it runs AFTER the agent
# is terminal — so a new 0%-covered function barely moves the aggregate and
# lands anyway. These helpers add a diff-scoped coverage check to the verify
# gate so an uncovered new path fails IN-LOOP (#1064).
#
# FAIL-OPEN BY CONSTRUCTION: every git/go/jq call below runs in a TESTED context
# (`if !`, `if [ ... ]`), so none of them can abort verify under `set -e`. Any
# failure returns non-zero, and cmd_verify then prints a one-line reason and
# falls through to the plain `cmd_test` loop. Only the Python gate itself is
# allowed to fail verify.
# --------------------------------------------------------------------------

# _patch_cov_base: echo the diff base ref, or return non-zero when none is
# usable. Ladder: FISHHAWK_DIFF_BASE (must resolve; an unresolvable override is
# NOT silently replaced by a fallback), else the first of origin/main, main that
# resolves.
_patch_cov_base() {
  if ! command -v git >/dev/null 2>&1; then
    return 1
  fi
  if [ "$(git -C "$ROOT" rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]; then
    return 1
  fi
  local ref
  if [ -n "${FISHHAWK_DIFF_BASE:-}" ]; then
    if git -C "$ROOT" rev-parse --verify --quiet "${FISHHAWK_DIFF_BASE}^{commit}" >/dev/null 2>&1; then
      printf '%s' "$FISHHAWK_DIFF_BASE"
      return 0
    fi
    return 1
  fi
  for ref in origin/main main; do
    if git -C "$ROOT" rev-parse --verify --quiet "${ref}^{commit}" >/dev/null 2>&1; then
      printf '%s' "$ref"
      return 0
    fi
  done
  return 1
}

# _patch_cov_all_modules: emit `<module>\t./...` for every go.work module. This
# is the fail-CLOSED fallback used when a changed path cannot be decoded (see
# _patch_cov_changed_modules): instrumenting every module costs more, but it
# keeps the undecodable file inside the gate's reach — check-coverage.py's own
# enumeration is binary-safe and will fold it into the denominator — instead of
# dropping it, which is exactly the hide-behind-a-filename bypass. Returns
# non-zero if the module list is unavailable.
_patch_cov_all_modules() {
  local mlist m
  if ! mlist="$(modules 2>/dev/null)"; then
    return 1
  fi
  if [ -z "$mlist" ]; then
    return 1
  fi
  while IFS= read -r m; do
    m="${m#./}"
    m="${m%/}"
    if [ -z "$m" ]; then continue; fi
    printf '%s\t./...\n' "$m"
  done <<< "$mlist"
}

# _patch_cov_changed_modules: emit one `<module>\t./pkg,./pkg2` line per go.work
# module that owns a changed non-test .go file. Diffs the MERGE BASE against the
# WORK TREE — the same snapshot `go test` compiles and the same snapshot
# check-coverage.py diffs, so line attribution never skews on a dirty tree — and
# adds UNTRACKED .go files, which `git diff` cannot see but the compiler can, so
# a never-`git add`ed new file is bucketed rather than silently bypassing the
# gate (it would otherwise be the only Go change and take the plain-test path).
#
# BINARY-SAFE ENUMERATION: both git listings use -z, because without it git
# C-quotes any path carrying a double quote, a backslash, a control character or
# a non-ASCII byte, and a filename containing a NEWLINE would split one path into
# two — letting Go code hide from the gate behind its name. Command substitution
# cannot carry NUL bytes, so the -z stream is remapped by an INJECTIVE `tr`:
# record-separator NUL -> newline, and any newline (which at that point can only
# be INSIDE a filename) -> \001. A record still containing \001 is therefore a
# path this layer cannot present, and is handled fail-CLOSED below rather than
# dropped — as is a path containing a TAB or a COMMA, the two delimiters this
# layer's OWN output encoding uses (`<module>\t<pkg>` pairs, comma-joined
# -coverpkg patterns), which would otherwise emit a corrupt pattern and leave
# the package tested but un-instrumented.
# Returns non-zero if git/go/jq is unavailable or there is no merge base.
_patch_cov_changed_modules() {
  local base="$1" mb files untracked mlist f cand m rel pkg pairs shown undecodable=0
  if ! mb="$(git -C "$ROOT" merge-base "$base" HEAD 2>/dev/null)"; then
    return 1
  fi
  if [ -z "$mb" ]; then
    return 1
  fi
  if ! files="$(git -C "$ROOT" diff --name-only -z --diff-filter=ACMR "$mb" -- '*.go' 2>/dev/null | tr '\n\000' '\001\n')"; then
    return 1
  fi
  # Untracked files are additive: a failure here degrades to the tracked-only
  # list rather than skipping the whole gate.
  if untracked="$(git -C "$ROOT" ls-files --others --exclude-standard -z -- '*.go' 2>/dev/null | tr '\n\000' '\001\n')"; then
    if [ -n "$untracked" ]; then
      files="$files
$untracked"
    fi
  fi
  if ! mlist="$(modules 2>/dev/null)"; then
    return 1
  fi
  if [ -z "$mlist" ]; then
    return 1
  fi
  pairs=""
  while IFS= read -r f; do
    if [ -z "$f" ]; then continue; fi
    case "$f" in
      *$'\001'*|*$'\t'*|*,*)
        # A path this layer's own encoding cannot carry: a NEWLINE (surviving
        # the `tr` remap as \001), a TAB (the `<module>\t<pkg>` pair delimiter,
        # at which the awk grouping pass truncates), or a COMMA (the -coverpkg
        # pattern-list separator, which `go test` would split the pattern on).
        # Each would emit a corrupt pattern, leaving the package tested but
        # UN-instrumented — its lines fall inside no profile block and the
        # Python layer's denominator rule silently drops the file, printing the
        # misleading "no coverable new Go statements" skip. So this layer must
        # not decide the path is uninteresting: say so on one line and fall back
        # to instrumenting every module. The Python layer's own enumeration is
        # binary-safe and folds the path into the denominator from there.
        shown="${f//$'\001'/<NL>}"
        shown="${shown//$'\t'/<TAB>}"
        echo "scripts/test: cannot decode changed path '$shown' (newline, tab or comma in path) — instrumenting every module (fail-closed)" >&2
        undecodable=1
        continue
        ;;
    esac
    case "$f" in
      *_test.go) continue ;;
    esac
    m=""
    while IFS= read -r cand; do
      cand="${cand#./}"
      cand="${cand%/}"
      if [ -z "$cand" ]; then continue; fi
      case "$f" in
        "$cand"/*)
          if [ "${#cand}" -gt "${#m}" ]; then m="$cand"; fi
          ;;
      esac
    done <<< "$mlist"
    if [ -z "$m" ]; then continue; fi
    rel="${f#"$m"/}"
    pkg="${rel%/*}"
    if [ "$pkg" = "$rel" ]; then pkg="."; else pkg="./$pkg"; fi
    pairs="$pairs$m	$pkg
"
  done <<< "$files"
  if [ "$undecodable" -eq 1 ]; then
    if ! _patch_cov_all_modules; then
      return 1
    fi
    return 0
  fi
  if [ -z "$pairs" ]; then
    return 0
  fi
  printf '%s' "$pairs" | sort -u | awk -F'\t' '
    { if ($1 != cur) { if (cur != "") print cur "\t" acc; cur = $1; acc = $2 }
      else acc = acc "," $2 }
    END { if (cur != "") print cur "\t" acc }'
}

# _patch_cov_emit_snapshot <base> <snapshot_path>: capture the pre-test change
# set (resolved against <base>) to a JSON snapshot, before any test runs. This
# is the load-bearing half of the TOCTOU fix (#2124): the change set is a read
# of the mutable WORK TREE, so it MUST be taken before the repository-controlled
# test loop can revert a changed file or delete an untracked one and erase its
# own lines from the denominator. check-coverage.py writes a trusted skip-marker
# and returns 0 on a git degrade, and FAILS CLOSED (non-zero) on an undecodable
# changed path — moved ahead of the tests rather than after them.
_patch_cov_emit_snapshot() {
  local base="$1" snapshot="$2"
  python3 "$SCRIPTS_DIR/check-coverage.py" \
    --emit-changed-snapshot "$snapshot" \
    --diff-base "$base" \
    --exclude '/db/' \
    --repo-root "$ROOT"
}

# cmd_test_with_patch_coverage: the same per-module test loop cmd_test runs, but
# a module that owns changed packages also emits a coverage profile with
# -coverpkg RESTRICTED to those packages. Restricting -coverpkg (rather than
# relying on Go's default per-package attribution) means the module's FULL test
# set credits the changed packages — a function exercised only by a sibling
# package's test still counts — while instrumentation cost is paid only for
# changed code, and no second test run happens.
#
# ORDERING IS LOAD-BEARING (#2124): emit the change-set snapshot, hash it into
# PATCHCOV_SNAPSHOT_DIGEST (parent memory) — both BEFORE the go-test loop — then
# run the tests; _verify_patch_coverage verifies the digest and consumes the
# snapshot AFTER. A snapshot rewritten by a test during the loop no longer
# matches the pre-test digest and fails closed.
cmd_test_with_patch_coverage() {
  local mods="$1" base="$2" mlist
  # Re-enumerate defensively: bucketing enumerated the modules earlier, but if
  # THIS call cannot, feeding the loop from a failed `modules` would run zero
  # modules and still exit 0 — verify reporting success having tested nothing.
  # Degrade to the plain loop, which fails closed on the same condition.
  if ! mlist="$(_module_list)"; then
    echo "scripts/test: could not enumerate go.work modules for the coverage loop — skipping the patch-coverage gate" >&2
    cmd_test
    return 0
  fi
  _arm_container_lease
  if ! _patchcov_mktemp; then
    echo "scripts/test: could not create the coverage scratch dir — skipping the patch-coverage gate" >&2
    cmd_test
    return 0
  fi
  # emit -> hash-into-parent-memory, BEFORE the loop (#2124). A non-zero exit
  # here is a fail-closed condition (an undecodable changed path) — return 1 so
  # `set -e` aborts verify rather than letting the gate proceed on an untrusted
  # change set. A git degrade writes a trusted skip-snapshot and exits 0.
  local snapshot="$PATCHCOV_DIR/changed-snapshot.json"
  if ! _patch_cov_emit_snapshot "$base" "$snapshot"; then
    echo "scripts/test: failed to capture the pre-test changed-line snapshot — failing the patch-coverage gate closed" >&2
    return 1
  fi
  if ! PATCHCOV_SNAPSHOT_DIGEST="$(_sha256_file "$snapshot")" || [ -z "$PATCHCOV_SNAPSHOT_DIGEST" ]; then
    PATCHCOV_SNAPSHOT_DIGEST=""
    echo "scripts/test: could not anchor the snapshot digest (no sha256 tool, or snapshot unreadable) — failing the patch-coverage gate closed" >&2
    return 1
  fi
  # The profile filename is keyed by a per-loop ORDINAL, not by a slug derived
  # from the module path. A slug (`tr '/' '_'`) is NOT injective — the distinct
  # valid module paths `a/b` and `a_b` both map to `a_b.out`, so the later
  # module's `go test` would overwrite the earlier module's profile and every
  # changed line in the overwritten module would fall inside no remaining
  # profile block, silently leaving that module's new code ungated. The ordinal
  # is unique by construction (the loop is sequential); the slug is retained
  # only as a human-readable SUFFIX for provenance, where a collision is
  # harmless. `(( ++cov_idx ))` is pre-increment: post-increment returns the old
  # value, and `(( 0 ))` is false, which aborts under `set -e`.
  local m mm pp pkgs slug cov_idx=0
  while IFS= read -r m; do
    printf '>>> %s\n' "$m"
    pkgs=""
    while IFS=$'\t' read -r mm pp; do
      if [ "${mm#./}" = "${m#./}" ]; then pkgs="$pp"; fi
    done <<< "$mods"
    if [ -n "$pkgs" ]; then
      (( ++cov_idx ))
      slug="$(printf '%s' "${m#./}" | tr '/' '_')"
      (cd "$m" && go test -race -p "$TEST_P" -covermode=atomic \
        -coverprofile="$PATCHCOV_DIR/$cov_idx-$slug.out" -coverpkg="$pkgs" ./...)
    else
      (cd "$m" && go test -race -p "$TEST_P" ./...)
    fi
  done <<< "$mlist"
}

# _verify_patch_coverage: run the diff-scoped gate over the profiles the loop
# emitted. This is the ONE step allowed to fail verify — a below-threshold patch
# exits non-zero and `set -e` aborts. Missing profiles degrade to a printed skip.
#
# It consumes the PRE-TEST snapshot (#2124) via --changed-snapshot rather than
# letting the Python layer recompute the change set from the now-test-mutated
# work tree, and passes --expected-snapshot-digest (the parent-memory anchor) so
# a snapshot rewritten during the loop fails closed instead of skipping.
_verify_patch_coverage() {
  local base="$1" f n=0
  local profiles=()
  if [ -z "$PATCHCOV_DIR" ]; then
    echo "scripts/test: no coverage profiles were produced — skipping the patch-coverage gate" >&2
    return 0
  fi
  # Verify the pre-test snapshot's integrity BEFORE any skip path (#2124). A
  # test that tampered with or deleted the snapshot AND removed the profiles
  # (to reach the no-profiles skip below) must still fail CLOSED — a snapshot
  # failure is never a passing SKIP. check-coverage.py only re-checks the digest
  # when it is invoked, which the no-profiles skip bypasses, so the parent-memory
  # anchor is re-checked here against the on-disk snapshot: a missing/unreadable
  # snapshot or a digest mismatch fails closed even when Python is never reached.
  local snapshot="$PATCHCOV_DIR/changed-snapshot.json" actual
  if ! actual="$(_sha256_file "$snapshot")" || [ -z "$actual" ]; then
    echo "scripts/test: pre-test changed-line snapshot missing or unreadable at verify time — failing the patch-coverage gate closed" >&2
    return 1
  fi
  if [ "$actual" != "$PATCHCOV_SNAPSHOT_DIGEST" ]; then
    echo "scripts/test: pre-test changed-line snapshot digest mismatch (modified after capture) — failing the patch-coverage gate closed" >&2
    return 1
  fi
  for f in "$PATCHCOV_DIR"/*.out; do
    if [ -f "$f" ]; then
      profiles[$n]="$f"
      n=$((n + 1))
    fi
  done
  if [ "$n" -eq 0 ]; then
    # Zero profiles is NOT an unconditional skip (#2124). A skip-snapshot (emit
    # degraded) or an empty change set legitimately has nothing to gate, but a
    # digest-verified snapshot carrying a NON-EMPTY changed map means the loop
    # instrumented the changed modules — their profiles vanishing is an integrity
    # anomaly (a test deleted them after capture), not "nothing to cover". Hand
    # the verdict to check-coverage.py with ZERO profiles: it SKIPs a skip-snapshot
    # / empty change set and FAILS CLOSED on a non-empty change set. The snapshot
    # digest was already verified above, so this consumes a trusted snapshot.
    python3 "$SCRIPTS_DIR/check-coverage.py" \
      --diff-base "$base" \
      --changed-snapshot "$PATCHCOV_DIR/changed-snapshot.json" \
      --expected-snapshot-digest "$PATCHCOV_SNAPSHOT_DIGEST" \
      --diff-threshold "${FISHHAWK_PATCH_COVERAGE_THRESHOLD:-85}" \
      --exclude '/db/' \
      --repo-root "$ROOT"
    return
  fi
  python3 "$SCRIPTS_DIR/check-coverage.py" \
    --diff-base "$base" \
    --changed-snapshot "$PATCHCOV_DIR/changed-snapshot.json" \
    --expected-snapshot-digest "$PATCHCOV_SNAPSHOT_DIGEST" \
    --diff-threshold "${FISHHAWK_PATCH_COVERAGE_THRESHOLD:-85}" \
    --exclude '/db/' \
    --repo-root "$ROOT" \
    "${profiles[@]}"
}

# _verify_gate_harnesses: run the standalone harnesses that pin the gate scripts
# themselves. They are the only machine check that scripts/test's patch-coverage
# wiring, scripts/check-coverage.py, and scripts/dev still behave as documented,
# and "must be green" is worth nothing if nothing ever runs them — `scripts/test
# verify` on a Python/shell-only diff otherwise takes the no-changed-Go-packages
# SKIP path and exercises neither the gate nor its harnesses. test-check-coverage
# and test-patch-coverage together run in ~11s; test-dev — which pins scripts/dev
# (the readiness gate + #1018 nonce round-trip, the container lease, the
# stale-worktree sweep, MCP banner selection, the #2453 TLS helpers) — takes the
# loop to ~26s, still small next to a verify gate that already runs lint plus a
# full -race module loop for minutes. All three run UNCONDITIONALLY rather than
# diff-scoped: a `scripts/`-touched guard would itself be a branch needing a pin
# and could mis-classify, and the two coverage harnesses already run every time.
# test-container-lease (#1792, extended for the #3122 generation-keyed orphan
# snapshot/sweep) sources this script lib-only with a fake `docker` on PATH, so it
# needs no Docker and adds well under a second; wiring it here machine-enforces the
# lease + sweep contract in-loop rather than only when a human runs the harness.
# A missing or non-executable harness prints a reason and is skipped; test-dev is
# ADDITIONALLY skipped when zsh is absent from PATH — it is `#!/usr/bin/env zsh`,
# so the exec would otherwise fail 127 and red-line verify instead of skipping.
# test-site-voice (#2261) pins scripts/check-site-voice, the banned-vocabulary
# gate over site/src/content/docs/; it is bash and adds well under a second
# (ten temp-dir fixture cases, no network, no Docker), so it needs no zsh guard.
# test-site-ia (E12.7 / #2318) pins scripts/check-site-ia, the sidebar<->pages IA
# gate over site/; same shape (bash, temp-dir fixtures, no network/Docker, no zsh
# guard), eleven cases including the parser-limitation pin and both fail-opens.
# test-helm-render (E62.2 / #2301) is the render gate for deploy/helm/fishhawk:
# it drives the real chart through `helm template`/`helm lint` and asserts on
# shipped rendered output — the only machine check that the chart's YAML
# defaults and rendered identifiers, which no compiler enforces, still say what
# the docs claim. It is bash and needs no zsh guard; the helm-absent SKIP lives
# INSIDE the harness (a printed reason plus exit 0), so this loop needs no
# helm-specific branch, and a helm-less host takes the same residual the zsh
# guard already accepts.
# test-site-reference (E12.4 / #2264) is the drift gate for the four generated
# Reference pages: it hashes each committed page, regenerates in place, hashes
# again, and restores the committed bytes unconditionally, so a stale generated
# region fails verify without leaving the tree mutated. It is bash and needs no
# zsh guard; the go-absent SKIP lives INSIDE the harness (a printed reason plus
# exit 0), exactly like test-helm-render's helm-absent skip, so this loop needs
# no site-reference-specific branch.
# test-verify-scope (#3315) pins the scoped verify form (--packages, its env
# fallback and both widening fail-safes) and the per-repository verify lock
# (shell-refuses / runner-waits-then-displaces / runner-never-displaces-a-runner,
# the serialised prune, and all three no-locking degrades). It is bash (no zsh
# guard needed) and hermetic — temp-dir git fixtures with stubbed go/golangci-lint/
# sleep/docker, no network and no real Docker. Wiring it here is what makes the
# harness enforce anything: a harness that exists but is never invoked satisfies
# the scope-completeness gate while enforcing nothing.
# A FAILING harness fails verify (set -e), which is the point (#2455).
_verify_gate_harnesses() {
  local h
  for h in test-check-coverage test-patch-coverage test-container-lease test-dev test-site-voice test-site-ia test-helm-render test-site-reference test-verify-scope; do
    if [ ! -x "$ROOT/scripts/$h" ]; then
      echo "scripts/test: scripts/$h missing or not executable — skipping that harness" >&2
      continue
    fi
    # test-dev is `#!/usr/bin/env zsh`; on a host without zsh the exec fails 127
    # and would red-line verify rather than take the documented skip. The two
    # coverage harnesses are POSIX-portable and need no such guard (#2455).
    if [ "$h" = "test-dev" ] && ! command -v zsh >/dev/null 2>&1; then
      echo "scripts/test: scripts/test-dev needs zsh, absent from PATH — skipping that harness" >&2
      continue
    fi
    printf '>>> scripts/%s\n' "$h"
    "$ROOT/scripts/$h"
  done
}

# _verify_site_voice: run the banned-vocabulary gate over the COMMITTED site
# content. _verify_gate_harnesses above proves the CONTROL still works against
# fixtures; this proves the shipped pages still pass it, so a later docs child
# that writes "seamless" into a page fails verify in-loop rather than landing
# and being caught by a human, or not at all (#2261). The script itself
# fail-OPENs with a printed reason on a tree with no site/src/content/docs —
# it is a voice linter, not a security control — so it can never red-line a
# checkout that predates the site. A real violation exits 1 and, under set -e,
# fails verify: that is the enforcement AGENTS.md "Documentation surfaces"
# claims. Long form: scripts/README.md.
_verify_site_voice() {
  if [ ! -x "$ROOT/scripts/check-site-voice" ]; then
    echo "scripts/test: scripts/check-site-voice missing or not executable — skipping the site voice gate" >&2
    return 0
  fi
  printf '>>> scripts/check-site-voice\n'
  "$ROOT/scripts/check-site-voice"
}

# _verify_site_ia: run the sidebar<->pages IA gate over the COMMITTED site content.
# _verify_gate_harnesses above proves the CONTROL still works against fixtures;
# this proves the shipped sidebar and pages still agree, so a docs child that adds
# a page without a sidebar entry (or a sidebar entry with no page) fails verify
# in-loop rather than only in the operator-installed Pages build (E12.7 / #2318).
# The script fail-OPENs with a printed reason on a tree with no site/ — mirroring
# _verify_site_voice — so it can never red-line a checkout that predates the site.
# A real violation exits 1 and, under set -e, fails verify. Long form:
# scripts/README.md.
_verify_site_ia() {
  if [ ! -x "$ROOT/scripts/check-site-ia" ]; then
    echo "scripts/test: scripts/check-site-ia missing or not executable — skipping the site IA gate" >&2
    return 0
  fi
  printf '>>> scripts/check-site-ia\n'
  "$ROOT/scripts/check-site-ia"
}

# --------------------------------------------------------------------------
# Per-repository verify lock (#3315)
#
# Two concurrent `scripts/test verify` invocations on one worktree family contend
# on golangci-lint's global lock and on the shared testcontainers Postgres, and
# the loser fails category-B behind a misleading scope-drift framing (#2645). The
# lock makes that structurally impossible on the normal path.
#
# KEY: <git-common-dir>/fishhawk-verify.lock. The common dir is SHARED by the
# main checkout and every linked worktree, so the runner's throwaway verify
# worktree and the agent's run worktree genuinely contend — which a TMPDIR-keyed
# path would not guarantee, since the runner's gate env is a default-deny
# allow-list and a differing TMPDIR would leave the control inert while appearing
# to work. Living inside .git also keeps it invisible to `git status`, so it can
# never pollute the scope-completeness or untracked-file gates.
#
# PRIMITIVE: an atomic symlink whose TARGET is `<pid>:<kind>` (kind is `runner`
# or `shell`). `ln -s` is one symlink(2) that fails EEXIST if the path is taken,
# so the lock carries BOTH its owner and its kind from the instant it exists —
# there is no window in which it exists yet is unowned. Same construction as
# _lease_lock (#1792).
#
# SEMANTICS, by the kind of the invocation MEETING a live holder:
#   * SHELL meets ANY live holder  -> REFUSE IMMEDIATELY. Non-zero, no sleep, no
#     poll, and an actionable message naming `scripts/test single`. Polling a
#     refusal in a loop is what killed run a662ed6f category-A; the refusal is a
#     fast failure, not a queue.
#   * RUNNER meets a live SHELL holder -> WAIT, bounded by 600 seconds at a
#     2-second poll. Most holders finish inside that, and the runner then
#     acquires normally with NO concurrency at all. Only on EXPIRY does it
#     DISPLACE the holder, printing a loud warning naming the deposed pid. That
#     is the wedged-holder escape hatch, not the normal path.
#   * RUNNER meets a live RUNNER holder -> wait on the same budget and then
#     REFUSE. Two concurrent runner verifies on one worktree family is a bug to
#     surface, not one to paper over by stealing.
#
# DEAD/GARBAGE holders are pruned, and the prune is itself SERIALISED by a second
# atomic symlink at <lockpath>.prune. Without that, two invocations that both
# classify the same dead holder can both unlink it, and the loser's unlink
# removes the WINNER'S fresh live lock — both then believe they hold it.
# Re-reading immediately before the unlink only narrows that window; the marker
# closes it. Holding the marker the pruner RE-READS the lock and only removes a
# still-dead holder; if a live holder appeared it falls through to the normal
# live-holder path. The marker is released by the same EXIT trap, only when this
# invocation created it.
#
# The marker's OWN dead-owner recovery is exclusive too (_verify_lock_recover_
# marker): a claim at <lockpath>.prune.reap.<victim>, content-addressed by the
# observed dead owner, and a removal CONDITIONAL on the marker still naming that
# owner. An unprotected read/kill/rm there would be the identical defect one
# level up — two recoverers, the loser deleting the winner's fresh live marker,
# both then pruning the lock. A claim is never broken, so a recoverer killed
# while holding one wedges recovery of that one marker; the restart budget turns
# that into a loud refusal naming the paths to remove, which is a residual an
# operator can clear rather than a mutual exclusion that is merely narrow.
#
# The runner's EXPIRY displacement is conditional in the same sense
# (_verify_lock_steal): the lock is taken by an atomic `mv` to a private path and
# the entry actually taken is READ. Anything other than the holder the budget was
# spent on is put back and the displacement refused, so the decision stays valid
# THROUGH the unlink rather than only at classification time — a shell holder
# that releases into a fresh RUNNER holder in that window is met by the normal
# live-runner refusal instead of being deleted.
#
# RESIDUAL, stated: `kill -0 <pid>` succeeding does not prove the pid is the
# ORIGINAL holder — a reused pid reads as live. That is the identical residual
# the container lease already accepts, and the consequence here is a bounded wait
# plus a loud displacement, or a refusal with an escape hatch printed in the
# message — never a lost or corrupted run.
#
# The lock is taken by `verify` ONLY, so `test`/`coverage`/`lint`/`single` are
# unaffected and the escape hatch the refusal names stays always available.
# Long form: scripts/README.md.
# --------------------------------------------------------------------------

# Wait budget and poll interval, by number. Both are dev-overridable via the
# environment; that override is DEV-ONLY in the same sense as the other FISHHAWK_*
# knobs, since the runner's gate env is a default-deny allow-list and FISHHAWK_ is
# not an allowed prefix. Read at USE time (not frozen at load) so a per-invocation
# override is honoured even when this file is sourced lib-only by the harness.
VERIFY_LOCK_WAIT_SECONDS=600
VERIFY_LOCK_POLL_SECONDS=2

_verify_lock_wait_budget() {
  local v="${FISHHAWK_VERIFY_LOCK_WAIT_SECONDS:-$VERIFY_LOCK_WAIT_SECONDS}"
  case "$v" in ''|*[!0-9]*) v="$VERIFY_LOCK_WAIT_SECONDS" ;; esac
  printf '%s' "$v"
}

_verify_lock_poll_interval() {
  local v="${FISHHAWK_VERIFY_LOCK_POLL_SECONDS:-$VERIFY_LOCK_POLL_SECONDS}"
  case "$v" in ''|*[!0-9]*|0) v="$VERIFY_LOCK_POLL_SECONDS" ;; esac
  printf '%s' "$v"
}

# _verify_lock_self_pid: this invocation's identity. Injectable (as the container
# lease's _lease_token is) so the harness can drive two synthetic acquisitions in
# one process and pin the prune interleaving deterministically.
_verify_lock_self_pid() {
  printf '%s' "${FISHHAWK_VERIFY_LOCK_SELF_PID:-$$}"
}

# _verify_lock_kind: `runner` when the runner marked this invocation, else
# `shell`. The runner appends the marker to the gate env AFTER sanitization, so
# an ambient value never reaches the gate subprocess.
_verify_lock_kind() {
  if [ "${FISHHAWK_VERIFY_LOCK_OWNER:-}" = "runner" ]; then
    printf 'runner'
  else
    printf 'shell'
  fi
}

# _verify_lock_path: <git-common-dir>/fishhawk-verify.lock, or non-zero plus a
# printed reason when locking is not possible. Three DEGRADES, each to NO
# locking rather than to a failure: git absent, $ROOT not a work tree, and a BARE
# repo. The bare-repo case guards on the printed `--is-inside-work-tree` VALUE,
# not its exit status, because a bare repo prints `false` yet exits 0 — the same
# trap _verify_schema_sync documents.
_verify_lock_path() {
  if ! command -v git >/dev/null 2>&1; then
    echo "scripts/test: git not found — running verify without the concurrency lock" >&2
    return 1
  fi
  if [ "$(git -C "$ROOT" rev-parse --is-inside-work-tree 2>/dev/null)" != "true" ]; then
    echo "scripts/test: $ROOT is not a git work tree — running verify without the concurrency lock" >&2
    return 1
  fi
  local common
  if ! common="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || [ -z "$common" ]; then
    echo "scripts/test: could not resolve the git common dir — running verify without the concurrency lock" >&2
    return 1
  fi
  printf '%s/fishhawk-verify.lock' "${common%/}"
}

# _verify_lock_classify <lockpath>: ONE parse driving every branch below, so the
# three callers cannot diverge. Prints exactly one of:
#   free | dead | live-shell | live-runner | garbage
_verify_lock_classify() {
  local lock="$1" target pid kind
  if [ ! -L "$lock" ]; then
    if [ -e "$lock" ]; then printf 'garbage'; else printf 'free'; fi
    return 0
  fi
  target="$(readlink "$lock" 2>/dev/null || true)"
  pid="${target%%:*}"
  kind="${target#*:}"
  case "$pid" in ''|*[!0-9]*) printf 'garbage'; return 0 ;; esac
  case "$kind" in runner|shell) ;; *) printf 'garbage'; return 0 ;; esac
  if kill -0 "$pid" 2>/dev/null; then
    printf 'live-%s' "$kind"
  else
    printf 'dead'
  fi
}

# _verify_lock_holder_pid <lockpath>: the holder pid, or empty.
_verify_lock_holder_pid() {
  local target
  target="$(readlink "$1" 2>/dev/null || true)"
  case "${target%%:*}" in
    ''|*[!0-9]*) printf '' ;;
    *) printf '%s' "${target%%:*}" ;;
  esac
}

# _verify_lock_try_acquire <lockpath> <target>: the atomic claim. The
# readlink-equals-ours re-check rejects the case where `ln -s` "succeeded" by
# landing a stray link INSIDE a leftover dir-form lock, so only a genuine atomic
# claim returns success.
_verify_lock_try_acquire() {
  local lock="$1" target="$2"
  ln -s "$target" "$lock" 2>/dev/null || return 1
  [ "$(readlink "$lock" 2>/dev/null)" = "$target" ] || return 1
  VERIFY_LOCK_HELD="$lock"
  VERIFY_LOCK_TARGET="$target"
  trap "$EXIT_TRAP" EXIT
  return 0
}

# _verify_lock_recover_marker <markerpath> <observed-owner>: recover a prune
# marker left behind by a pruner that died holding it — WITHOUT the unlink race
# the marker itself exists to close.
#
# The naive form (read the owner, `kill -0` it, `rm`) is the SAME defect one
# level up: two recoverers can both observe the same dead owner, A removes the
# marker and plants its own, and B — still acting on the classification it took
# BEFORE A ran — deletes A's FRESH LIVE marker. Both then believe they are the
# sole pruner and both prune the lock, which is exactly the double-prune this
# marker was introduced to prevent.
#
# The observed owner is therefore an ARGUMENT, not something re-read here: the
# staleness is the hazard, so it is modelled explicitly and the removal is made
# both EXCLUSIVE and CONDITIONAL.
#
#   * The right to reap a marker owned by <victim> is claimed by an atomic
#     symlink at <marker>.reap.<victim>. The claim is CONTENT-ADDRESSED by the
#     victim, so two recoverers acting on the same observation cannot both hold
#     it, and one acting on a DIFFERENT observation is not competing for the
#     same removal at all.
#   * Holding the claim, the marker is RE-READ and removed ONLY if it still
#     names <victim>. A fresh marker planted by whoever got there first names a
#     different pid and is left strictly alone.
#
# Nothing is created at <marker> here. The caller restarts classification and
# competes for the marker with the same atomic `ln -s` every other invocation
# uses, so a successful recovery confers no ownership. It returns 0 ONLY when it
# actually removed the marker it was asked about, and 1 for every back-off — a
# live owner, a claim held by another recoverer, or a marker that has since
# changed hands.
#
# This function NEVER breaks a claim it finds, not even one whose owner is dead:
# breaking a claim would reintroduce the identical race one level deeper, and
# each further level could only ever narrow the window rather than close it. The
# terminating alternative is stated honestly instead. A claim leaked by a
# recoverer SIGKILLed inside the microseconds it holds one wedges recovery of
# that ONE dead marker; the acquisition loop's restart budget converts that into
# a loud refusal naming the paths to remove. A wedge an operator can clear in
# one `rm` beats a mutual exclusion that is merely narrow.
_verify_lock_recover_marker() {
  local marker="$1" victim="$2" claim self cur rc
  self="$(_verify_lock_self_pid)"
  case "$victim" in
    ''|*[!0-9]*)
      # No pid to identify a live pruner with: a GARBAGE marker (a dir-form
      # leftover, or a target that names no pid). It still goes through an
      # exclusive claim, so two recoverers cannot both act on it.
      claim="$marker.reap.garbage"
      ;;
    *)
      if kill -0 "$victim" 2>/dev/null; then
        return 1  # a LIVE pruner holds it: there is nothing to recover
      fi
      claim="$marker.reap.$victim"
      ;;
  esac
  if ! { ln -s "$self" "$claim" 2>/dev/null && [ "$(readlink "$claim" 2>/dev/null)" = "$self" ]; }; then
    return 1
  fi
  cur="$(readlink "$marker" 2>/dev/null || true)"
  rc=1
  if [ "$cur" = "$victim" ]; then
    rm -rf "$marker" 2>/dev/null || true
    rc=0
  fi
  rm -f "$claim" 2>/dev/null || true
  return "$rc"
}

# _verify_lock_steal <lockpath> <victim-target> <target>: the runner's
# wait-expiry displacement, made valid THROUGH the removal rather than only at
# classification time.
#
# The unconditional `rm -f "$lock"` this replaces decided on a classification
# and acted on it afterwards. Between the two, the wedged shell holder can
# release and a DIFFERENT invocation — including a RUNNER one — can acquire; the
# rm would then delete a fresh lock this loop never classified, producing exactly
# the two concurrent runner verifies the live-runner branch exists to refuse.
#
# `rm` cannot be made conditional, but `mv` can be made EXCLUSIVE: renaming the
# lock to a private path is atomic, so of two invocations racing to displace the
# same entry exactly one succeeds — and the winner can then READ what it actually
# took. Taking anything other than the holder the budget was spent on is a
# MIS-TAKE: the entry is put back with a non-clobbering `ln -s` and this
# invocation REFUSES, so the caller restarts classification and meets the new
# holder through the normal branches. A displacement is only ever completed
# against the holder that was actually waited on.
#
# The prune marker is held across the whole sequence, so a concurrent PRUNER
# (which also removes the lock) is excluded while the rename excludes a
# concurrent STEALER.
#
# RESIDUAL, stated rather than claimed closed: the restore is `ln -s`, which
# refuses to clobber. If a THIRD invocation acquired the freed path between the
# mis-take and the restore, the mis-taken holder's entry is gone and it becomes a
# phantom holder. That needs two separate acquisitions inside the same
# microseconds, and this invocation still refuses — but it is a window, not a
# guarantee. The alternative, a clobbering `mv` restore, would delete the third
# invocation's live lock instead, which is strictly worse.
#
# Returns 0 when this invocation displaced the victim AND now holds the lock,
# 2 when it displaced the victim but LOST the race to re-acquire (the caller
# must never displace twice), and 1 when no displacement was performed at all.
# 0 and 2 are both COMPLETED displacements — the victim's lock is gone in each —
# so the caller owes the loud warning on both, not only on the one that ends
# holding the lock.
_verify_lock_steal() {
  local lock="$1" victim="$2" target="$3" marker self taken moved rc=1
  self="$(_verify_lock_self_pid)"
  marker="$lock.prune"
  if ! { ln -s "$self" "$marker" 2>/dev/null && [ "$(readlink "$marker" 2>/dev/null)" = "$self" ]; }; then
    _verify_lock_recover_marker "$marker" "$(readlink "$marker" 2>/dev/null || true)" || true
    return 1
  fi
  VERIFY_PRUNE_MARKER="$marker"
  trap "$EXIT_TRAP" EXIT
  taken="$lock.stolen.$self"
  rm -rf "$taken" 2>/dev/null || true
  if mv "$lock" "$taken" 2>/dev/null; then
    moved="$(readlink "$taken" 2>/dev/null || true)"
    if [ "$moved" = "$victim" ]; then
      rm -rf "$taken" 2>/dev/null || true
      if _verify_lock_try_acquire "$lock" "$target"; then rc=0; else rc=2; fi
    else
      # MIS-TAKE: the entry we took is not the holder we waited on. Put it back
      # without clobbering anything that landed meanwhile, and refuse.
      if [ -n "$moved" ]; then
        ln -s "$moved" "$lock" 2>/dev/null || true
      fi
      rm -rf "$taken" 2>/dev/null || true
    fi
  fi
  rm -f "$marker" 2>/dev/null || true
  VERIFY_PRUNE_MARKER=""
  return "$rc"
}

# _verify_lock_prune_and_acquire <lockpath> <target>: prune a dead/garbage holder
# under the exclusive prune marker. Returns 0 only when this invocation now HOLDS
# the lock; returns 1 for every other outcome, and the caller then RESTARTS
# classification from the top rather than assuming the prune conferred anything.
_verify_lock_prune_and_acquire() {
  local lock="$1" target="$2" marker self mowner cls rc=1
  marker="$lock.prune"
  self="$(_verify_lock_self_pid)"
  if ! { ln -s "$self" "$marker" 2>/dev/null && [ "$(readlink "$marker" 2>/dev/null)" = "$self" ]; }; then
    # Another invocation is already pruning. Recover the marker if its owner
    # died holding it — EXCLUSIVELY, see _verify_lock_recover_marker — then back
    # off and restart classification from the top.
    mowner="$(readlink "$marker" 2>/dev/null || true)"
    _verify_lock_recover_marker "$marker" "$mowner" || true
    return 1
  fi
  VERIFY_PRUNE_MARKER="$marker"
  trap "$EXIT_TRAP" EXIT
  # Holding the marker, RE-READ the lock. Only a still-dead (or garbage) holder is
  # removed; a live holder that got there first is left alone and the caller falls
  # through to the normal live-holder path.
  cls="$(_verify_lock_classify "$lock")"
  case "$cls" in
    dead|garbage)
      rm -rf "$lock" 2>/dev/null || true
      if _verify_lock_try_acquire "$lock" "$target"; then rc=0; fi
      ;;
    free)
      if _verify_lock_try_acquire "$lock" "$target"; then rc=0; fi
      ;;
  esac
  rm -f "$marker" 2>/dev/null || true
  VERIFY_PRUNE_MARKER=""
  return "$rc"
}

# The one refusal both restart budgets print. It names the recovery-claim paths
# because the only way this is reached repeatedly is a recoverer SIGKILLed while
# holding one — the stated, operator-clearable residual of
# _verify_lock_recover_marker's refusal to break a claim it did not create.
VERIFY_LOCK_UNSETTLED_MSG='scripts/test: the verify lock never settled — refusing rather than proceeding under an uncertain lock state.
If this repeats, a pruner was killed holding a recovery claim: inspect and remove
<git-common-dir>/fishhawk-verify.lock.prune and its .reap.* siblings by hand.'

# _acquire_verify_lock_at <lockpath>: the acquisition loop. Returns 0 when this
# invocation may proceed (it holds the lock), 1 when it must REFUSE. Split from
# _acquire_verify_lock so the harness can drive every branch in-process against a
# fixture lock path with an injected self pid.
_acquire_verify_lock_at() {
  local lock="$1" kind target self cls holder budget poll steal_rc waited=0 announced=0 stole=0 restarts=0
  self="$(_verify_lock_self_pid)"
  kind="$(_verify_lock_kind)"
  target="$self:$kind"
  budget="$(_verify_lock_wait_budget)"
  poll="$(_verify_lock_poll_interval)"
  while :; do
    if _verify_lock_try_acquire "$lock" "$target"; then
      return 0
    fi
    cls="$(_verify_lock_classify "$lock")"
    holder="$(_verify_lock_holder_pid "$lock")"
    case "$cls" in
      free|dead|garbage)
        restarts=$((restarts + 1))
        if [ "$restarts" -gt 100 ]; then
          echo "$VERIFY_LOCK_UNSETTLED_MSG" >&2
          return 1
        fi
        if [ "$cls" = "free" ]; then
          continue
        fi
        if _verify_lock_prune_and_acquire "$lock" "$target"; then
          return 0
        fi
        continue
        ;;
      live-shell|live-runner)
        if [ "$kind" = "shell" ]; then
          cat >&2 <<EOF
scripts/test: another verify already holds the lock at $lock (pid ${holder:-unknown}, kind ${cls#live-}).
The runner owns verify for this stage. Do NOT poll or retry this in a loop — it is a
fast failure, not a queue. Run your package's tests directly instead:
  scripts/test single -run TestX ./your/package/...
EOF
          return 1
        fi
        if [ "$waited" -ge "$budget" ]; then
          if [ "$cls" = "live-runner" ]; then
            cat >&2 <<EOF
scripts/test: another RUNNER verify still holds the lock at $lock after ${budget}s
(holder pid ${holder:-unknown}, this pid $self). Two concurrent runner verifies on one
worktree family is a bug to surface, not one to paper over — refusing rather than
displacing a peer runner.
EOF
            return 1
          fi
          if [ "$stole" -eq 1 ]; then
            echo "scripts/test: the verify lock at $lock was retaken after a displacement — refusing rather than displacing twice" >&2
            return 1
          fi
          # Conditional displacement: the decision must still be VALID at the
          # unlink, not merely at the classification. _verify_lock_steal
          # completes only against this exact holder.
          steal_rc=0
          _verify_lock_steal "$lock" "$holder:shell" "$target" || steal_rc=$?
          # The warning is owed on EVERY COMPLETED displacement, not only on the
          # one that ended with this invocation holding the lock. rc=2 means the
          # victim's lock WAS removed and someone else won the freed path — the
          # deposed verify is running unprotected either way, which is exactly
          # the state the warning exists to announce. Gating the warning on rc=0
          # would let a real displacement pass silently.
          case "$steal_rc" in
            0|2)
              echo "scripts/test: WARNING: displacing a wedged shell verify holding $lock (deposed pid ${holder:-unknown}) after ${budget}s — two verifies may now contend on golangci-lint's global lock and the shared testcontainers Postgres." >&2
              ;;
          esac
          case "$steal_rc" in
            0)
              return 0
              ;;
            2)
              # The victim was displaced but another invocation won the free
              # lock. Never displace twice: the next expiry refuses.
              echo "scripts/test: the freed verify lock at $lock was taken by another invocation before this one could re-acquire it — this invocation will not displace again." >&2
              stole=1
              ;;
          esac
          restarts=$((restarts + 1))
          if [ "$restarts" -gt 100 ]; then
            echo "$VERIFY_LOCK_UNSETTLED_MSG" >&2
            return 1
          fi
          continue
        fi
        if [ "$announced" -eq 0 ]; then
          echo "scripts/test: waiting up to ${budget}s for the verify lock at $lock (holder pid ${holder:-unknown}, kind ${cls#live-})" >&2
          announced=1
        fi
        sleep "$poll"
        waited=$((waited + poll))
        continue
        ;;
    esac
  done
}

# _acquire_verify_lock: resolve the lock path and acquire. Returns 0 to proceed
# (held, or degraded to no locking) and 1 to refuse.
_acquire_verify_lock() {
  local lock
  if ! lock="$(_verify_lock_path)"; then
    return 0  # degrade: reason already printed, run without the lock
  fi
  _acquire_verify_lock_at "$lock"
}

# _release_verify_lock: EXIT-trap release. Removes the prune marker only when it
# still names us, and the lock only when it still names US — so a lock this
# invocation refused on, or one that was displaced out from under it, is never
# removed.
_release_verify_lock() {
  local self
  self="$(_verify_lock_self_pid)"
  if [ -n "${VERIFY_PRUNE_MARKER:-}" ] && [ "$(readlink "$VERIFY_PRUNE_MARKER" 2>/dev/null)" = "$self" ]; then
    rm -f "$VERIFY_PRUNE_MARKER" 2>/dev/null || true
  fi
  VERIFY_PRUNE_MARKER=""
  if [ -n "${VERIFY_LOCK_HELD:-}" ] && [ "$(readlink "$VERIFY_LOCK_HELD" 2>/dev/null)" = "${VERIFY_LOCK_TARGET:-}" ]; then
    rm -f "$VERIFY_LOCK_HELD" 2>/dev/null || true
  fi
  VERIFY_LOCK_HELD=""
  return 0
}

# verify: the runner's committed-tree implement gate. Lint FIRST so a fast
# format/lint failure leads the captured output and aborts (set -e) before the
# slow test loop. The doc line budget and schema-sync drift are checked NEXT
# (each <1s) so a docs defect fails in-loop, still ahead of the slow test loop,
# as are the gate harnesses, the site voice gate (#2261), and the site IA gate
# (E12.7 / #2318).
# The AGGREGATE coverage gate is still intentionally omitted to bound in-loop
# runtime — it stays on `coverage` and in CI. What runs here instead is the
# PATCH-scoped gate (#1887), folded into the same test loop via -coverpkg so no
# second run happens. Every precondition degrades to a one-line reason plus the
# plain `cmd_test` loop; none of them can red-line verify.
cmd_verify() {
  if ! _acquire_verify_lock; then
    exit 1
  fi
  cmd_lint
  _verify_doc_line_budget
  _verify_schema_sync
  _verify_gate_harnesses
  _verify_site_voice
  _verify_site_ia
  # SCOPED form (#3315). Bucketing fails SAFE: any package this layer cannot
  # place prints a reason and falls through to the full unscoped loop below.
  local buckets=""
  if [ -n "$VERIFY_PACKAGES" ] && buckets="$(_verify_scope_buckets "$VERIFY_PACKAGES")" && [ -n "$buckets" ]; then
    # The patch-coverage gate is SKIPPED, not narrowed. Its denominator is the
    # WHOLE branch diff, so a run that tested only a few packages cannot honestly
    # gate it — and narrowing the denominator to the scoped packages would be a
    # gate that reports a coverage verdict it did not earn. The #2124 pre-test
    # snapshot/digest machinery is therefore left completely UN-ARMED here rather
    # than armed and weakened; the full committed-tree gate still runs it.
    echo "scripts/test: scoped verify (--packages $VERIFY_PACKAGES) — the patch-coverage gate runs in the full committed-tree gate" >&2
    cmd_test_scoped "$buckets"
    return 0
  fi
  local base="" mods=""
  if [ -n "${FISHHAWK_SKIP_PATCH_COVERAGE:-}" ]; then
    echo "scripts/test: FISHHAWK_SKIP_PATCH_COVERAGE set — skipping the patch-coverage gate" >&2
  elif ! base="$(_patch_cov_base)"; then
    echo "scripts/test: no usable diff base (git absent, not a work tree, or unresolvable ref) — skipping the patch-coverage gate" >&2
  elif ! mods="$(_patch_cov_changed_modules "$base")"; then
    echo "scripts/test: could not bucket changed Go files (no merge base, or go/jq unavailable) — skipping the patch-coverage gate" >&2
  elif [ -z "$mods" ]; then
    echo "scripts/test: no changed Go packages vs $base — skipping the patch-coverage gate" >&2
  else
    cmd_test_with_patch_coverage "$mods" "$base"
    _verify_patch_coverage "$base"
    return 0
  fi
  cmd_test
}

cmd_single() {
  if [ "$#" -eq 0 ]; then
    cat >&2 <<'EOF'
usage: scripts/test single <args>
example: scripts/test single -run TestNotifyPlanReady ./backend/internal/issuecomment/...
EOF
    exit 1
  fi
  go test -race "$@"
}

usage() {
  cat <<'EOF'
usage: scripts/test [SUBCOMMAND] [ARGS]

  test                 (default) run `go test -race ./...` in every module
  coverage             run tests + aggregate coverage gate
  lint                 run `golangci-lint run ./...` in every module
  verify               lint + schema-sync + tests + patch-scoped coverage — the runner's verify gate
  verify --packages P  the SCOPED verify form: P is a comma-separated list of
                       repo-relative package DIRECTORIES (e.g.
                       backend/internal/run,cli/internal/spec). Every non-test
                       leg is unchanged; the `go test -race` loop is restricted
                       to those packages and the patch-coverage gate is skipped.
                       Falls back to $FISHHAWK_VERIFY_PACKAGES when absent.
  single ARGS          pass-through to `go test -race ARGS`
  -h | --help | help   show this message
EOF
}

# Bottom dispatch is skipped when sourced lib-only (FISHHAWK_TEST_LIB_ONLY=1),
# so scripts/test-container-lease can exercise the lease helpers without running
# a subcommand. Behavior is unchanged when the var is unset.
if [ -z "${FISHHAWK_TEST_LIB_ONLY:-}" ]; then
  case "${1:-test}" in
    test|"")          cmd_test ;;
    coverage|cover)   cmd_coverage ;;
    lint)             cmd_lint ;;
    verify)           shift; _parse_verify_args "$@"; cmd_verify ;;
    single)           shift; cmd_single "$@" ;;
    -h|--help|help)   usage ;;
    *)
      echo "scripts/test: unknown subcommand: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
fi
