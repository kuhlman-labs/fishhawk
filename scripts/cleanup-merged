#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: scripts/cleanup-merged [--dry-run] [-h|--help]

Fetch origin/main, then delete every local branch already merged into it.
A merged branch still checked out by a worktree is skipped with a warning;
remove it with scripts/dev sweep. main is never deleted.

  --dry-run   fetch and list the branches that would be deleted; delete nothing
  -h, --help  print this help and exit; no fetch, no deletion
USAGE
}

# Parse every argument BEFORE the fetch (#5224 G1): --help used to fall
# through to the deletion, because nothing read the arguments at all.
dry_run=0
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=1
      ;;
    *)
      usage >&2
      echo "unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

git fetch origin main --quiet

# Snapshot the worktree map ONCE before the loop. A git failure yields an empty
# string, so no branch is ever treated as held and the prior delete behavior is
# preserved (fail-open, matching this script's best-effort posture).
worktrees="$(git worktree list --porcelain 2>/dev/null || true)"

# Print the worktree path that currently checks out the given branch, or nothing.
# Parses the porcelain snapshot with awk (NOT a bash associative array — macOS
# bash 3.2 has none). Matches the FULL ref (refs/heads/<name>) to avoid substring
# collisions between similarly-named branches. Feeds awk via a here-string rather
# than a `printf | awk` pipe: awk `exit`s on first match, and under `pipefail` a
# SIGPIPE'd printf would make the pipeline non-zero and abort the script under
# `set -e` — the exact abort class this script exists to avoid.
holding_worktree() {
  awk -v target="refs/heads/$1" '
    /^worktree / { path = substr($0, 10); next }
    $0 == "branch " target { print path; exit }
  ' <<<"$worktrees"
}

count=0
skipped=0
while IFS= read -r branch; do
  [ "$branch" = "main" ] && continue
  if git merge-base --is-ancestor "$branch" origin/main 2>/dev/null; then
    wt="$(holding_worktree "$branch")"
    if [ -n "$wt" ]; then
      # A worktree still holds this merged branch; `git branch -D` would fail
      # ('used by worktree') and abort the script. Skip + warn + continue so the
      # caller (scripts/dev post-merge) reaches its reload. Removal is owned by
      # `scripts/dev sweep` (#1917).
      echo "skipped (merged, held by worktree $wt): $branch — remove it with scripts/dev sweep" >&2
      skipped=$((skipped + 1))
      continue
    fi
    if [ "$dry_run" -eq 1 ]; then
      echo "would delete (merged): $branch"
      count=$((count + 1))
      continue
    fi
    git branch -D "$branch" >/dev/null
    echo "deleted (merged): $branch"
    count=$((count + 1))
  fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

verb="cleaned"
if [ "$dry_run" -eq 1 ]; then
  verb="would clean"
fi
if [ "$skipped" -ne 0 ]; then
  echo "$verb $count branch(es), skipped $skipped held by worktree(s)"
else
  echo "$verb $count branch(es)"
fi
