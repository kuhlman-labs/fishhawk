#!/usr/bin/env bash
# Hermetic test for scripts/test's concurrent-invocation container lease
# refcount (#1792). Sources scripts/test lib-only (FISHHAWK_TEST_LIB_ONLY=1, so
# no subcommand runs), puts a fake `docker` on PATH that records its `rm` calls,
# and drives _reap_shared_container with injectable lease tokens + a temp lease
# dir to assert the refcount contract without Docker or a real container.
# Standalone like scripts/test-cleanup-merged / scripts/test-dev — not wired
# into scripts/test or CI.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0
FAIL=0

# pass() is GUARDED by the #3710 report-only invariant: a case can only record a
# pass if NO `docker volume rm` / `docker volume prune` argv was recorded during
# it. The fake docker routes any such call to $volrmlog and exits 0 (never
# errors), so a future change that adds a volume-removal path to scripts/test
# reddens EVERY case at once rather than slipping past the cases that happen not
# to assert it. Volumes must leave only via `docker rm -f -v` of containers
# scripts/test already removes.
pass() {
  if [ -s "${volrmlog:-/nonexistent}" ]; then
    echo "FAIL: $1 (report-only invariant violated: docker volume removal issued: [$(tr '\n' ';' < "$volrmlog")])"
    FAIL=$((FAIL + 1))
    return 0
  fi
  echo "PASS: $1"; PASS=$((PASS + 1));
}
fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); }

# grep_q: `grep -q` for the read end of a PIPE (#4233). `grep -q` exits on its
# first match and closes the pipe; a writer with bytes still unwritten then gets
# EPIPE/SIGPIPE and `pipefail` fails the pipeline even though grep MATCHED. This
# drains stdin after grep decides. PIPE-ONLY: with a terminal on stdin it blocks.
grep_q() { local rc=0; grep -q "$@" || rc=$?; cat >/dev/null; return "$rc"; }

tmproot=$(mktemp -d)
trap 'rm -rf "$tmproot"' EXIT

# Fake docker on PATH that records `rm` invocations to a log (one line each) and
# serves the current testcontainers-labelled container id set from an injectable
# file ($psfile) for `docker ps -aq --filter label=...` — so a case can script
# which containers "exist" on the daemon at each step (#3122 sweep contract).
#
# Two extra hooks pin the concerns this pass closes:
#   * $psfail exists  → `docker ps` exits NON-ZERO (a present-but-failing daemon),
#     so a case can drive the decline-to-publish transition in
#     _write_generation_snapshot / _labelled_container_ids.
#   * on every `rm`, whether the lease lock symlink named by
#     $FAKE_DOCKER_LOCK_PATH exists AT THAT INSTANT is recorded to $locklog as
#     "<argv> <held|free>" — so a case can assert the sweep's `docker rm` runs
#     while the lease lock is still held (condition 4: sweep INSIDE the lock).
#
# Three more hooks pin the #3710 anonymous-volume half:
#   * EVERY invocation's argv is appended to $argvlog, so a case can assert the
#     shipped `docker rm` spelling and that no volume-removal argv ever issued.
#   * `volume ls` serves an injectable id list ($volfile) but ONLY when the query
#     carries BOTH `dangling=true` AND `label=com.docker.volume.anonymous`; a
#     missing filter exits non-zero with no output, so dropping either filter in
#     _dangling_anonymous_volume_count reddens the warning cases. The $volfail
#     sentinel forces a non-zero exit (a present-but-failing daemon).
#   * ANY `volume` subcommand OTHER than `ls` (i.e. `rm` / `prune`) is recorded to
#     $volrmlog and exits 0, so a future volume-removal path is RECORDED rather
#     than erroring — and every case asserts $volrmlog is EMPTY. That is the
#     machine-enforced form of the report-only invariant: scripts/test must never
#     execute `docker volume rm` or `docker volume prune` (#3710).
bindir="$tmproot/bin"
mkdir -p "$bindir"
rmlog="$tmproot/docker-rm.log"
locklog="$tmproot/docker-rm-lockstate.log"
psfile="$tmproot/docker-ps.txt"
psfail="$tmproot/docker-ps.fail"
argvlog="$tmproot/docker-argv.log"
volrmlog="$tmproot/docker-volume-rm.log"
volfile="$tmproot/docker-volume-ls.txt"
volfail="$tmproot/docker-volume-ls.fail"
: > "$psfile"
: > "$volfile"
cat > "$bindir/docker" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$argvlog"
if [ "\$1" = "rm" ]; then
  printf '%s\n' "\$*" >> "$rmlog"
  lockstate=free
  if [ -n "\${FAKE_DOCKER_LOCK_PATH:-}" ] && [ -L "\${FAKE_DOCKER_LOCK_PATH}" ]; then
    lockstate=held
  fi
  printf '%s %s\n' "\$*" "\$lockstate" >> "$locklog"
  exit 0
fi
if [ "\$1" = "ps" ]; then
  [ -f "$psfail" ] && exit 1
  [ -f "$psfile" ] && cat "$psfile"
  exit 0
fi
if [ "\$1" = "volume" ]; then
  if [ "\$2" != "ls" ]; then
    # rm / prune — RECORD it (never error), so the emptiness assertion is what
    # fails if a volume-removal path is ever added.
    printf '%s\n' "\$*" >> "$volrmlog"
    exit 0
  fi
  [ -f "$volfail" ] && exit 1
  # Validate the filters: BOTH must be present or the query fails with no output.
  case " \$* " in *" dangling=true "*) ;; *) exit 1 ;; esac
  case " \$* " in *" label=com.docker.volume.anonymous "*) ;; *) exit 1 ;; esac
  [ -f "$volfile" ] && cat "$volfile"
  exit 0
fi
exit 0
EOF
chmod +x "$bindir/docker"
export PATH="$bindir:$PATH"

# Source the lib. scripts/test enables \`set -e\`; turn it back off so assertions
# that run commands expected to fail don't abort the test.
FISHHAWK_TEST_LIB_ONLY=1 source "$REPO_ROOT/scripts/test"
set +e

# Per-case reset: fresh lease dir, no lock, no snapshot, empty docker-rm log and
# an empty labelled-container set. Resetting $psfile is what keeps the #3122 sweep
# (now wired into the last-holder reap) from removing a prior case's leftover ids
# and perturbing the existing rm-count assertions.
reset_case() {
  LEASE_DIR="$tmproot/case-$1"
  rm -rf "$LEASE_DIR" "$LEASE_DIR.lock" "$LEASE_DIR.snapshot" "$LEASE_DIR.snapshot.tmp."* 2>/dev/null
  : > "$rmlog"
  : > "$locklog"
  : > "$psfile"
  : > "$argvlog"
  : > "$volrmlog"
  : > "$volfile"
  rm -f "$psfail" 2>/dev/null      # clear the docker-ps-fails sentinel
  rm -f "$volfail" 2>/dev/null     # clear the docker-volume-ls-fails sentinel
  unset FAKE_DOCKER_LOCK_PATH      # clear the per-case lock-state probe
  unset FISHHAWK_TEST_VOLUME_WARN_AT
}

# True when NO `docker volume rm` / `docker volume prune` argv was ever recorded.
# The report-only invariant (#3710): scripts/test removes volumes only as a side
# effect of `docker rm -f -v` on containers it already removes.
no_volume_removal() { [ ! -s "$volrmlog" ]; }

# Number of docker rm invocations recorded so far.
rm_count() {
  if [ -s "$rmlog" ]; then
    wc -l < "$rmlog" | tr -d ' '
  else
    echo 0
  fi
}

# (a) ref-held: reap while ANOTHER invocation's live lease is registered records
# NO docker rm — the exact #1792 bug. Our own token has no lease; a live-PID
# lease from a concurrent invocation keeps the dir non-empty.
reset_case a
mkdir -p "$LEASE_DIR"
: > "$LEASE_DIR/$$"                       # concurrent invocation's lease (live PID)
export FISHHAWK_TEST_LEASE_TOKEN=2000000 # our token — no lease file of its own
_reap_shared_container
if [ "$(rm_count)" -eq 0 ]; then
  pass "ref-held: no docker rm while another lease is live"
else
  fail "ref-held: expected 0 docker rm, got $(rm_count)"
fi

# (b) last-holder: reap as the final lease holder records docker rm exactly once.
reset_case b
export FISHHAWK_TEST_LEASE_TOKEN=$$
mkdir -p "$LEASE_DIR"
: > "$LEASE_DIR/$(_lease_token)"          # our lease, the only one
_reap_shared_container
if [ "$(rm_count)" -eq 1 ] && grep -qx 'rm -f -v fishhawk-test-postgres' "$rmlog" \
   && no_volume_removal; then
  pass "last-holder: docker rm -f -v fishhawk-test-postgres exactly once, no volume removal"
else
  fail "last-holder: expected 1 'rm -f -v fishhawk-test-postgres', got $(rm_count) (rmlog=[$(tr '\n' ';' < "$rmlog")], volrm=[$(tr '\n' ';' < "$volrmlog")])"
fi

# (c) stale-lease: a dead-PID lease is pruned so it neither blocks the reap nor
# pins the container — reap proceeds to docker rm.
reset_case c
export FISHHAWK_TEST_LEASE_TOKEN=$$
mkdir -p "$LEASE_DIR"
dead_pid=$(bash -c 'echo $$')            # a PID that has already exited
: > "$LEASE_DIR/$dead_pid"                # stale lease from a crashed invocation
: > "$LEASE_DIR/$(_lease_token)"          # our own lease
_reap_shared_container
if [ "$(rm_count)" -eq 1 ] && [ ! -d "$LEASE_DIR" ]; then
  pass "stale-lease: dead-PID lease pruned, reap proceeds to docker rm"
else
  fail "stale-lease: expected dead lease pruned + 1 docker rm, got $(rm_count) (dir exists: $([ -d "$LEASE_DIR" ] && echo yes || echo no))"
fi

# (d) stale-lock-broken: a lock left by a DEAD owner PID is broken so the
# operation proceeds — binding condition (2)/(4). The lock is a symlink whose
# target IS the owner PID. Reap is the last holder, so a successful break lets it
# docker rm exactly once and release the lock.
reset_case d
export FISHHAWK_TEST_LEASE_TOKEN=$$
mkdir -p "$LEASE_DIR"
: > "$LEASE_DIR/$(_lease_token)"          # our lease → reap is last holder
dead_owner=$(bash -c 'echo $$')          # dead PID as the lock's recorded owner
ln -s "$dead_owner" "$LEASE_DIR.lock"     # stale lock owned by a dead PID
_reap_shared_container
if [ "$(rm_count)" -eq 1 ] && [ ! -L "$LEASE_DIR.lock" ]; then
  pass "stale-lock-broken: dead-owner lock broken, reap proceeds and releases lock"
else
  fail "stale-lock-broken: expected lock broken + 1 docker rm, got $(rm_count) (lock exists: $([ -L "$LEASE_DIR.lock" ] && echo yes || echo no))"
fi

# (e) fail-safe on a live-but-stuck lock: a lock held by a LIVE owner is never
# broken; the bounded retry cap is exhausted and reap fails SAFE — NO docker rm,
# the container is left for the next invocation's attach-reuse — binding cond (3).
reset_case e
export FISHHAWK_TEST_LEASE_TOKEN=$$
export FISHHAWK_TEST_LEASE_LOCK_CAP=2     # short cap so the test is fast
mkdir -p "$LEASE_DIR"
: > "$LEASE_DIR/$(_lease_token)"
ln -s "$$" "$LEASE_DIR.lock"              # live owner (this process), atomic lock
_reap_shared_container
if [ "$(rm_count)" -eq 0 ]; then
  pass "fail-safe: live-but-stuck lock leaves the container (no docker rm)"
else
  fail "fail-safe: expected 0 docker rm under a live-stuck lock, got $(rm_count)"
fi
unset FISHHAWK_TEST_LEASE_LOCK_CAP
rm -rf "$LEASE_DIR.lock"                  # release the synthetic live lock

# (g) live-delayed-acquire safety (#1792 fixup): the old mkdir-then-stamp lock had
# a window where a holder had mkdir'd the lock but not yet written its owner PID;
# a concurrent breaker could rm that "ownerless" dir after the grace window and
# enter the critical section ALONGSIDE the delayed-but-live holder, so both could
# reap the shared container concurrently. The lock is now an atomically-created
# symlink whose target IS the owner PID, so a live holder's lock carries its owner
# from the instant it exists and is NEVER observed as ownerless. Assert the
# now-impossible race is closed: a lock held by a LIVE owner is NOT broken by a
# concurrent _lease_lock attempt — it exhausts its cap and fails (return 1) with
# the live lock intact, so no second party can enter the critical section.
reset_case g
export FISHHAWK_TEST_LEASE_TOKEN=$$
export FISHHAWK_TEST_LEASE_LOCK_CAP=2      # short cap so the test is fast
sleep 60 &                                 # a live "delayed" holder
live_holder=$!
disown "$live_holder" 2>/dev/null || true  # silence job-control "Terminated" noise
ln -s "$live_holder" "$LEASE_DIR.lock"      # its atomic lock: target = live PID
_lease_lock                                # a concurrent invocation racing for it
lock_rc=$?
kill "$live_holder" 2>/dev/null
if [ "$lock_rc" -ne 0 ] && [ -L "$LEASE_DIR.lock" ] \
   && [ "$(readlink "$LEASE_DIR.lock" 2>/dev/null)" = "$live_holder" ]; then
  pass "live-delayed-acquire: live holder's atomic lock never broken (no ownerless window)"
else
  fail "live-delayed-acquire: expected acquire to fail with live lock intact (rc=$lock_rc, lock exists: $([ -L "$LEASE_DIR.lock" ] && echo yes || echo no))"
fi
unset FISHHAWK_TEST_LEASE_LOCK_CAP
rm -rf "$LEASE_DIR.lock"                    # release the synthetic live lock

# (h) register-timeout lifecycle: when the lock is live-stuck, _register_lease
# records NO lease and returns non-zero, and _arm_container_lease then does NOT
# arm the reap trap — so this invocation can never docker-rm the shared container
# out from under a concurrent invocation whose live lease it never got the lock
# to see. Guards the register-timeout hole the direct reap fail-safe (e) misses.
reset_case h
export FISHHAWK_TEST_LEASE_TOKEN=$$
export FISHHAWK_TEST_LEASE_LOCK_CAP=2     # short cap so the test is fast
mkdir -p "$LEASE_DIR"
sleep 60 &                                # a concurrent invocation still testing
other=$!
disown "$other" 2>/dev/null || true       # silence job-control "Terminated" noise
: > "$LEASE_DIR/$other"                   # its live lease keeps the dir non-empty
ln -s "$$" "$LEASE_DIR.lock"              # live owner (this process) → stuck
_register_lease
reg_rc=$?
saved_trap="$(trap -p EXIT)"              # preserve the test's own cleanup trap
_arm_container_lease
armed_trap="$(trap -p EXIT)"
eval "$saved_trap"                        # restore cleanup trap (untouched if unarmed)
kill "$other" 2>/dev/null
if [ "$reg_rc" -ne 0 ] && [ ! -e "$LEASE_DIR/$(_lease_token)" ] \
   && [ -e "$LEASE_DIR/$other" ] \
   && ! printf '%s' "$armed_trap" | grep_q _reap_shared_container \
   && [ "$(rm_count)" -eq 0 ]; then
  pass "register-timeout: stuck lock records no lease, reap unarmed, container kept"
else
  fail "register-timeout: expected no lease + reap unarmed + 0 docker rm (reg_rc=$reg_rc, rm=$(rm_count))"
fi
unset FISHHAWK_TEST_LEASE_LOCK_CAP

# ---------------------------------------------------------------------------
# #3122 generation-keyed orphan snapshot + sweep cases. These drive the SHIPPED
# _register_lease / _reap_shared_container end to end (not a leaf helper), with
# the fake docker's labelled set scripted per step via $psfile.
# ---------------------------------------------------------------------------

# (i) INTERLEAVING — the case that would have caught a per-INVOCATION snapshot.
# Holder A opens the generation (snapshot empty); container cA is created DURING
# the generation; holder B joins and REUSES A's snapshot (does NOT capture cA as
# pre-existing); A exits ref-held (sweeps nothing); B exits last-holder and MUST
# sweep cA. Reverting to a per-invocation snapshot leaves B snapshotting cA as
# pre-existing, sparing it → this reddens naming cA's surviving id.
reset_case i
sleep 60 & pidA=$!; disown "$pidA" 2>/dev/null || true
sleep 60 & pidB=$!; disown "$pidB" 2>/dev/null || true
unset FISHHAWK_TEST_LEASE_TOKEN
: > "$psfile"                                        # daemon starts with no labelled containers
FISHHAWK_TEST_LEASE_TOKEN=$pidA _register_lease      # A opens the generation, snapshot empty
printf 'cA\n' > "$psfile"                            # cA created mid-generation
FISHHAWK_TEST_LEASE_TOKEN=$pidB _register_lease      # B joins, reuses A's snapshot
FISHHAWK_TEST_LEASE_TOKEN=$pidA _reap_shared_container  # A ref-held (B live) → no rm, no sweep
a_rm=$(rm_count)
kill "$pidA" 2>/dev/null
FISHHAWK_TEST_LEASE_TOKEN=$pidB _reap_shared_container  # B last-holder → sweep cA
kill "$pidB" 2>/dev/null
unset FISHHAWK_TEST_LEASE_TOKEN
if [ "$a_rm" -eq 0 ] && grep -qx 'rm -f -v cA' "$rmlog"; then
  pass "interleaving: cA created mid-generation is swept by the last holder"
else
  fail "interleaving: expected A ref-held (0 rm) + B sweeps cA (a_rm=$a_rm, rmlog=[$(tr '\n' ';' < "$rmlog")])"
fi

# (ii) PRE-GENERATION SPARING — a container that predates the first holder is in
# the snapshot and is NOT swept, and the preflight reports it. Proves the sweep is
# not "remove everything labelled".
reset_case ii
printf 'cPre\n' > "$psfile"                          # predates the generation
export FISHHAWK_TEST_LEASE_TOKEN=$$
export FISHHAWK_TEST_ORPHAN_WARN_AT=0                # force the preflight to warn
warnout=$(_register_lease 2>&1)                      # opens generation, snapshots cPre, warns
unset FISHHAWK_TEST_ORPHAN_WARN_AT
printf 'cPre\ncNew\n' > "$psfile"                    # cNew appears during the generation
_reap_shared_container                               # last-holder sweep
unset FISHHAWK_TEST_LEASE_TOKEN
# The warning's OPERATOR CLEANUP HINT is the third `docker rm` site (#3710): a
# hand cleanup must not leak either, so assert the printed command carries `-v`.
if grep -qx 'rm -f -v cNew' "$rmlog" && ! grep -qx 'rm -f -v cPre' "$rmlog" \
   && printf '%s' "$warnout" | grep_q 'pre-existing' \
   && printf '%s' "$warnout" | grep_q -F 'docker rm -f -v $(docker ps -aq' \
   && no_volume_removal; then
  pass "pre-generation sparing: cPre spared + reported, cNew swept, hint carries -v"
else
  fail "pre-generation sparing: expected cNew swept, cPre spared+reported with a -v hint (rmlog=[$(tr '\n' ';' < "$rmlog")], warn=[$warnout])"
fi

# (iii) SNAPSHOT PLACEMENT — the snapshot is a SIBLING of $LEASE_DIR, not inside
# it, so the last-holder rmdir still succeeds. Moving the snapshot inside
# $LEASE_DIR makes rmdir fail (non-empty dir), the last-holder branch never runs,
# and this reddens (no rm, dir survives).
reset_case iii
export FISHHAWK_TEST_LEASE_TOKEN=$$
_register_lease
placement_ok=0
if [ -f "$LEASE_DIR.snapshot" ] && [ ! -e "$LEASE_DIR/snapshot" ] && [ ! -e "$LEASE_DIR/$(basename "$LEASE_DIR").snapshot" ]; then
  placement_ok=1
fi
_reap_shared_container
unset FISHHAWK_TEST_LEASE_TOKEN
if [ "$placement_ok" -eq 1 ] && [ ! -d "$LEASE_DIR" ] && [ "$(rm_count)" -ge 1 ]; then
  pass "snapshot placement: sibling path, last-holder rmdir still succeeds"
else
  fail "snapshot placement: expected sibling snapshot + successful rmdir (placement_ok=$placement_ok, dir exists: $([ -d "$LEASE_DIR" ] && echo yes || echo no), rm=$(rm_count))"
fi

# (iv) NO-SNAPSHOT DEGRADE — a last holder with the snapshot deleted (crash
# leftover) sweeps NOTHING: only fishhawk-test-postgres is removed. Deleting the
# snapshot-missing guard in _sweep_generation_orphans makes it grep a missing file
# for every id, sweeping cX → this reddens.
reset_case iv
printf 'cX\n' > "$psfile"
export FISHHAWK_TEST_LEASE_TOKEN=$$
_register_lease
rm -f "$LEASE_DIR.snapshot"                           # snapshot gone (crash / missing)
_reap_shared_container
unset FISHHAWK_TEST_LEASE_TOKEN
if grep -qx 'rm -f -v fishhawk-test-postgres' "$rmlog" && ! grep -qx 'rm -f -v cX' "$rmlog"; then
  pass "no-snapshot degrade: sweep is a no-op, only the shared container removed"
else
  fail "no-snapshot degrade: expected only fishhawk-test-postgres removed (rmlog=[$(tr '\n' ';' < "$rmlog")])"
fi

# (v) OPT-OUT — FISHHAWK_TEST_NO_ORPHAN_SWEEP=1 disables the sweep; a mid-
# generation container is left in place. cY is added AFTER _register_lease so it
# is ABSENT from the (empty) snapshot — i.e. it would be swept as generation-
# created WITHOUT the opt-out. Adding cY before registration (the earlier vacuous
# shape) captured it in the snapshot, sparing it regardless of the opt-out, so the
# case asserted nothing about the opt-out; this ordering makes it load-bearing.
reset_case v
export FISHHAWK_TEST_LEASE_TOKEN=$$
_register_lease                     # opens generation, snapshot empty
printf 'cY\n' > "$psfile"           # cY created mid-generation, NOT in the snapshot
export FISHHAWK_TEST_NO_ORPHAN_SWEEP=1
_reap_shared_container
unset FISHHAWK_TEST_NO_ORPHAN_SWEEP
unset FISHHAWK_TEST_LEASE_TOKEN
if grep -qx 'rm -f -v fishhawk-test-postgres' "$rmlog" && ! grep -qx 'rm -f -v cY' "$rmlog"; then
  pass "opt-out: FISHHAWK_TEST_NO_ORPHAN_SWEEP spares a mid-generation container"
else
  fail "opt-out: expected no sweep of cY (rmlog=[$(tr '\n' ';' < "$rmlog")])"
fi

# (vi) SNAPSHOT LIFECYCLE — the snapshot is RETAINED after a ref-held exit and
# DELETED after the last-holder branch.
reset_case vi
sleep 60 & other=$!; disown "$other" 2>/dev/null || true
unset FISHHAWK_TEST_LEASE_TOKEN
FISHHAWK_TEST_LEASE_TOKEN=$other _register_lease      # opens generation, writes snapshot
export FISHHAWK_TEST_LEASE_TOKEN=6000001             # our token: no lease of its own
_reap_shared_container                               # ref-held (other's lease live) → retain snapshot
retained=0; [ -f "$LEASE_DIR.snapshot" ] && retained=1
kill "$other" 2>/dev/null
FISHHAWK_TEST_LEASE_TOKEN=$other _reap_shared_container  # last-holder → delete snapshot
deleted=0; [ ! -f "$LEASE_DIR.snapshot" ] && deleted=1
unset FISHHAWK_TEST_LEASE_TOKEN
if [ "$retained" -eq 1 ] && [ "$deleted" -eq 1 ]; then
  pass "snapshot lifecycle: retained after ref-held, deleted after last-holder"
else
  fail "snapshot lifecycle: expected retain-then-delete (retained=$retained, deleted=$deleted)"
fi

# (viii) DECLINE-TO-PUBLISH ON A FAILED QUERY (#3122 high/regression). When docker
# is PRESENT but its `ps` query FAILS at generation-open, _write_generation_snapshot
# must NOT publish an empty snapshot: otherwise a later daemon recovery makes the
# last-holder sweep treat every labelled container as generation-created and remove
# it. Assert (1) no snapshot is published while the query fails, and (2) after the
# daemon "recovers" (cZ now visible), the last-holder sweep degrades to a NO-OP and
# spares cZ. Restoring `|| true` in _labelled_container_ids reddens this: the empty
# snapshot publishes and cZ is swept.
reset_case viii
: > "$psfail"                                         # docker present, ps query FAILS
export FISHHAWK_TEST_LEASE_TOKEN=$$
_register_lease                                      # opens generation; snapshot must NOT publish
published_on_failure=0; [ -f "$LEASE_DIR.snapshot" ] && published_on_failure=1
rm -f "$psfail"                                      # daemon recovers
printf 'cZ\n' > "$psfile"                            # cZ now visible to the sweep
_reap_shared_container                               # last-holder: no snapshot → no-op sweep
unset FISHHAWK_TEST_LEASE_TOKEN
if [ "$published_on_failure" -eq 0 ] && grep -qx 'rm -f -v fishhawk-test-postgres' "$rmlog" \
   && ! grep -qx 'rm -f -v cZ' "$rmlog"; then
  pass "decline-to-publish: failed ps writes no snapshot, recovered daemon not swept"
else
  fail "decline-to-publish: expected no snapshot on failure + cZ spared (published=$published_on_failure, rmlog=[$(tr '\n' ';' < "$rmlog")])"
fi

# (ix) SWEEP RUNS INSIDE THE LOCK (#3122 condition 4 / verification concern). The
# last holder must run _sweep_generation_orphans and the snapshot deletion while
# still HOLDING the lease lock, so a concurrent invocation cannot arm between the
# rmdir and the snapshot removal and have its fresh snapshot deleted. The fake
# docker records, at each `rm`, whether the lock symlink still exists; assert the
# sweep's `docker rm cW` fired with the lock HELD. Moving the sweep/snapshot
# deletion after _lease_unlock reddens this — at rm time the lock is gone (free).
reset_case ix
export FAKE_DOCKER_LOCK_PATH="$LEASE_DIR.lock"       # probe the real lock path
export FISHHAWK_TEST_LEASE_TOKEN=$$
_register_lease                                      # opens generation, snapshot empty
printf 'cW\n' > "$psfile"                            # cW created mid-generation
_reap_shared_container                               # last-holder: sweeps cW under the lock
unset FISHHAWK_TEST_LEASE_TOKEN
unset FAKE_DOCKER_LOCK_PATH
if grep -qx 'rm -f -v cW held' "$locklog" && grep -qx 'rm -f -v fishhawk-test-postgres held' "$locklog"; then
  pass "sweep-under-lock: sweep + shared-container rm run while the lease lock is held"
else
  fail "sweep-under-lock: expected 'rm -f -v cW held' + 'rm -f -v fishhawk-test-postgres held' (locklog=[$(tr '\n' ';' < "$locklog")])"
fi

# ---------------------------------------------------------------------------
# #3710 anonymous-volume cases. Two halves: the shipped `docker rm` argv carries
# `-v` at every removal site, and the report-only backlog warning (which must
# NEVER remove a volume).
# ---------------------------------------------------------------------------

# (x) VOLUME-REMOVING REAP — the done-means of the `-v` half, asserted on the
# SHIPPED ARGV rather than on a comment. Drive a last-holder reap with one
# generation orphan present and assert BOTH recorded lines are exactly the `-v`
# spelling. Deleting the `-v` token from either _reap_shared_container or
# _sweep_generation_orphans makes the stub record `rm -f <id>` and this reddens on
# the behavioural assertion.
reset_case x
export FISHHAWK_TEST_LEASE_TOKEN=$$
_register_lease                     # opens generation, snapshot empty
printf 'cV\n' > "$psfile"           # cV created mid-generation → swept by the last holder
_reap_shared_container
unset FISHHAWK_TEST_LEASE_TOKEN
if grep -qx 'rm -f -v fishhawk-test-postgres' "$rmlog" && grep -qx 'rm -f -v cV' "$rmlog" \
   && ! grep -qx 'rm -f fishhawk-test-postgres' "$rmlog" && ! grep -qx 'rm -f cV' "$rmlog" \
   && no_volume_removal; then
  pass "volume-removing reap: both removal sites ship 'docker rm -f -v'"
else
  fail "volume-removing reap: expected 'rm -f -v fishhawk-test-postgres' + 'rm -f -v cV' (rmlog=[$(tr '\n' ';' < "$rmlog")], volrm=[$(tr '\n' ';' < "$volrmlog")])"
fi

# (xi) VOLUME WARNING ABOVE THRESHOLD — a count strictly ABOVE
# FISHHAWK_TEST_VOLUME_WARN_AT prints the count and names `docker volume prune -f`
# on stderr, and removes NOTHING. The stub's `volume ls` branch requires BOTH the
# `dangling=true` and `label=com.docker.volume.anonymous` filters, so dropping
# either from _dangling_anonymous_volume_count fails the query, the helper takes
# its decline path, and this case reddens with empty stderr.
reset_case xi
printf 'v1\nv2\nv3\n' > "$volfile"
export FISHHAWK_TEST_VOLUME_WARN_AT=2
volout=$(_preflight_volume_warn 2>&1 >/dev/null)
unset FISHHAWK_TEST_VOLUME_WARN_AT
if printf '%s' "$volout" | grep_q '3 dangling anonymous Docker volume' \
   && printf '%s' "$volout" | grep_q -F 'docker volume prune -f' \
   && no_volume_removal; then
  pass "volume warning: fires above threshold with the count and the prune command"
else
  fail "volume warning: expected a count-bearing warning naming 'docker volume prune -f' (out=[$volout], volrm=[$(tr '\n' ';' < "$volrmlog")])"
fi

# (xii) VOLUME WARNING SILENT BRANCHES — all three arms the threshold contract
# claims, in one case so each is load-bearing:
#   arm 1: count EXACTLY AT the threshold → silent (pins `>` and not `>=`);
#   arm 2: count strictly BELOW the threshold → silent;
#   arm 3: a NON-NUMERIC FISHHAWK_TEST_VOLUME_WARN_AT falls back to the default
#          100 — a count of 3 is below it, so silent; had the fallback not fired,
#          `[ 3 -gt garbage ]` would error rather than stay silent, and a fallback
#          to 0 would print. Paired with arm 4, which proves the DEFAULT is 100
#          and not merely "something above 3": 101 volumes under the same garbage
#          value must WARN.
reset_case xii
printf 'v1\nv2\nv3\n' > "$volfile"
export FISHHAWK_TEST_VOLUME_WARN_AT=3                # arm 1: exactly at threshold
at_out=$(_preflight_volume_warn 2>&1 >/dev/null)
export FISHHAWK_TEST_VOLUME_WARN_AT=4                # arm 2: strictly below
below_out=$(_preflight_volume_warn 2>&1 >/dev/null)
export FISHHAWK_TEST_VOLUME_WARN_AT=not-a-number     # arm 3: garbage → default 100
garbage_out=$(_preflight_volume_warn 2>&1 >/dev/null)
seq 1 101 | sed 's/^/v/' > "$volfile"                # arm 4: 101 > default 100
garbage_warn_out=$(_preflight_volume_warn 2>&1 >/dev/null)
unset FISHHAWK_TEST_VOLUME_WARN_AT
if [ -z "$at_out" ] && [ -z "$below_out" ] && [ -z "$garbage_out" ] \
   && printf '%s' "$garbage_warn_out" | grep_q '101 dangling anonymous Docker volume' \
   && no_volume_removal; then
  pass "volume warning: silent at threshold, below threshold, and non-numeric knob falls back to 100"
else
  fail "volume warning: expected silence at/below threshold and a 100 fallback (at=[$at_out], below=[$below_out], garbage=[$garbage_out], garbage_warn=[$garbage_warn_out])"
fi

# (xiii) VOLUME QUERY FAILS — docker PRESENT but `volume ls` exits non-zero
# (daemon down / transient error). _dangling_anonymous_volume_count declines to
# publish (returns non-zero, prints nothing) and the warning stays SILENT: never
# a bogus "0 dangling volumes" line, and never a removal.
reset_case xiii
: > "$volfail"                                       # docker present, volume ls FAILS
printf 'v1\nv2\nv3\n' > "$volfile"
export FISHHAWK_TEST_VOLUME_WARN_AT=0                # would warn on ANY positive count
failout=$(_preflight_volume_warn 2>&1 >/dev/null)
unset FISHHAWK_TEST_VOLUME_WARN_AT
rm -f "$volfail"
if [ -z "$failout" ] && no_volume_removal; then
  pass "volume warning: a failing 'docker volume ls' is silent, never a bogus zero count"
else
  fail "volume warning: expected silence on a failed query (out=[$failout])"
fi

# (xv) WARNING CALL SITE — binding condition (1). Cases (xi)-(xiii) invoke
# _preflight_volume_warn DIRECTLY, so none of them can observe whether it is
# actually WIRED. This case drives the REAL generation-opening path,
# _register_lease on a fresh lease dir, and captures its stderr. Deleting the
# _preflight_volume_warn call from _register_lease reddens ONLY this case.
reset_case xv
seq 1 7 | sed 's/^/v/' > "$volfile"
export FISHHAWK_TEST_LEASE_TOKEN=$$
export FISHHAWK_TEST_VOLUME_WARN_AT=5
export FISHHAWK_TEST_ORPHAN_WARN_AT=99               # keep the container preflight quiet
callsite_out=$(_register_lease 2>&1 >/dev/null)
unset FISHHAWK_TEST_ORPHAN_WARN_AT
unset FISHHAWK_TEST_VOLUME_WARN_AT
unset FISHHAWK_TEST_LEASE_TOKEN
if printf '%s' "$callsite_out" | grep_q '7 dangling anonymous Docker volume' \
   && printf '%s' "$callsite_out" | grep_q -F 'docker volume prune -f' \
   && no_volume_removal; then
  pass "warning call site: _register_lease's generation-open path emits the volume warning"
else
  fail "warning call site: expected _register_lease to emit the volume warning (out=[$callsite_out], volrm=[$(tr '\n' ';' < "$volrmlog")])"
fi

# (vii) BRANCH INVARIANCE — a LOAD-BEARING check (was a vacuous unconditional
# `pass`). The pre-existing refcount cases (a)-(h) and the #3122 sweep cases
# (i)-(vi),(viii),(ix) all run in this same harness against the modified
# _register_lease/_reap_shared_container, so their green status IS the invariance
# evidence. Asserting the EXACT count of prior passes with zero failures turns the
# marker into a gate: a silently-skipped or reddened prior case drops PASS below
# the expected total here. Bump expected_prior when adding a case above.
expected_prior=20   # (a)(b)(c)(d)(e)(g)(h)=7 + (i)(ii)(iii)(iv)(v)(vi)(viii)(ix)=8
                    # + #3710: (x)(xi)(xii)(xiii)(xv)=5. (xiv) is GUARDED/skippable
                    # (it runs only when docker is genuinely off PATH) and records
                    # neither a pass nor a fail, so it is deliberately NOT counted.
if [ "$FAIL" -eq 0 ] && [ "$PASS" -eq "$expected_prior" ]; then
  pass "branch invariance: all $expected_prior prior refcount+sweep cases ran and passed"
else
  fail "branch invariance: expected $expected_prior prior passes and 0 failures (PASS=$PASS, FAIL=$FAIL)"
fi

# (xiv) DOCKER ABSENT — _preflight_volume_warn's first guard. Re-run it under a
# PATH carrying only an empty bin dir plus the system dirs; with no `docker` to
# resolve, the helper returns silently and removes nothing. Placed AFTER (vii) and
# SKIPPED (never counted as a pass) when a host docker still resolves on that
# reduced PATH, so it can never fabricate coverage it did not get.
reset_case xiv
emptybin="$tmproot/emptybin"
mkdir -p "$emptybin"
printf 'v1\nv2\nv3\n' > "$volfile"
# `hash -r` inside each subshell drops bash's cached path for `docker`, which
# would otherwise let `command -v docker` resolve the real binary even though the
# reduced PATH no longer contains its directory — a cache hit that silently
# skipped this case.
if ( PATH="$emptybin:/usr/bin:/bin"; hash -r; command -v docker >/dev/null 2>&1 ); then
  echo "SKIP: docker-absent: a host docker still resolves on the reduced PATH"
else
  absent_out=$( PATH="$emptybin:/usr/bin:/bin"; hash -r; FISHHAWK_TEST_VOLUME_WARN_AT=0 _preflight_volume_warn 2>&1 >/dev/null )
  if [ -z "$absent_out" ] && no_volume_removal; then
    pass "docker-absent: volume warning is a silent no-op with no docker on PATH"
  else
    fail "docker-absent: expected silence with no docker on PATH (out=[$absent_out])"
  fi
fi

# (f) parse-clean: scripts/test itself parses with no syntax errors.
if bash -n "$REPO_ROOT/scripts/test" 2>/dev/null; then
  pass "bash -n scripts/test parses clean"
else
  fail "bash -n scripts/test reported a syntax error"
fi

echo ""
echo "Results: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
