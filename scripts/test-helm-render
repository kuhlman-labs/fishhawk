#!/usr/bin/env bash
# Render gate for deploy/helm/fishhawk (E62.2 / #2301). Drives the REAL chart
# through `helm template` / `helm lint` and asserts on SHIPPED RENDERED OUTPUT.
#
# Why this exists as a behavioural gate: almost everything in that chart is YAML
# defaults and rendered identifiers whose correctness no compiler enforces, so a
# comment-only or no-op touch would satisfy the scope-completeness gate while the
# real edit was dropped. Every case below asserts what an operator's `helm
# install` would actually produce.
#
# House style follows scripts/test-site-voice / scripts/test-container-lease:
# PASS/FAIL counters, non-zero exit on any FAIL. Bash (not zsh), so
# _verify_gate_harnesses needs no interpreter guard. Parsing is awk/grep only —
# no yq, no PyYAML. Run by `scripts/test verify` via _verify_gate_harnesses, and
# standalone.
#
# SKIP CONTRACT: `helm` is not guaranteed on every dev host or CI runner, so an
# absent binary prints one line and exits 0 rather than red-lining verify with
# exit 127. The cost is honest — on a helm-less host the chart is unguarded, the
# same residual _verify_gate_harnesses already accepts for zsh/test-dev.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHART="$REPO_ROOT/deploy/helm/fishhawk"
PASS=0
FAIL=0

pass() { echo "PASS: $1"; PASS=$((PASS + 1)); }
fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); }

if ! command -v helm >/dev/null 2>&1; then
  echo "scripts/test-helm-render: helm absent from PATH — skipping the chart render gate"
  exit 0
fi
if [ ! -d "$CHART" ]; then
  echo "scripts/test-helm-render: $CHART not found — skipping the chart render gate"
  exit 0
fi

tmproot=$(mktemp -d)
trap 'rm -rf "$tmproot"' EXIT

out=""
err=""
status=0

# render <args...> — run `helm template` against the chart, capturing stdout and
# stderr SEPARATELY so a failure case can assert on the guard's message without
# the rendered manifest polluting the match.
render() {
  out=$("$(command -v helm)" template fishhawk "$CHART" "$@" 2>"$tmproot/stderr")
  status=$?
  err=$(cat "$tmproot/stderr")
}

# assert_contains <label> <haystack> <needle>
assert_contains() {
  if printf '%s' "$2" | grep -qF -- "$3"; then pass "$1"; else
    fail "$1 (expected to find: $3)"
  fi
}

# assert_field_absent <label> <haystack> <field>
# Matches the field at YAML KEY position (^<indent><field>:), not anywhere in the
# text — the rendered manifest carries explanatory comments that name the field,
# and a substring match would be satisfied by those comments alone.
assert_field_absent() {
  if printf '%s' "$2" | grep -qE "^[[:space:]]*$3:"; then
    fail "$1 (unexpectedly rendered the field: $3)"
  else pass "$1"; fi
}

# assert_absent <label> <haystack> <needle>
assert_absent() {
  if printf '%s' "$2" | grep -qF -- "$3"; then
    fail "$1 (unexpectedly found: $3)"
  else pass "$1"; fi
}

# assert_render_ok <label>
assert_render_ok() {
  if [ "$status" -eq 0 ]; then pass "$1"; else fail "$1 (render exited $status: $(printf '%s' "$err" | tail -2))"; fi
}

# assert_render_fails <label> <expected-text-in-stderr>
# Asserts BOTH a non-zero exit AND the expected key/number in stderr, so a render
# that fails for an UNRELATED reason cannot green the case.
assert_render_fails() {
  if [ "$status" -eq 0 ]; then
    fail "$1 (render succeeded; expected a failure naming: $2)"
  elif printf '%s' "$err" | grep -qF -- "$2"; then
    pass "$1"
  else
    fail "$1 (failed, but stderr did not name: $2 — got: $(printf '%s' "$err" | tail -2))"
  fi
}

# assert_equals <label> <actual> <expected>
assert_equals() {
  if [ "$2" = "$3" ]; then pass "$1"; else
    fail "$1 (expected: $3 — got: $2)"
  fi
}

# yaml_block <manifest> <key> — the FIRST block nested under `<key>:`, i.e. every
# subsequent line indented STRICTLY deeper than the key itself, stopping at the
# next sibling-or-shallower key.
#
# Why the harness parses structurally instead of grepping the whole document: a
# bare `grep -F "name: fishhawk-secrets"` over a rendered Deployment is satisfied
# by `volumes: - secret: secretName: ...` (the PEM projection references the same
# Secret), by a comment naming it, or by an `envFrom:` on a DIFFERENT container —
# so deleting the container's `envFrom.secretRef` leaves such an assertion GREEN
# and the sufficiency proof r5 is meant to be becomes vacuous. Scoping to the
# block makes the assertion fail exactly when the reference stops reaching the
# container's environment.
yaml_block() {
  printf '%s' "$1" | awk -v key="$2" '
    !f && $0 ~ "^[[:space:]]*" key ":[[:space:]]*$" {
      match($0, /^[[:space:]]*/); ind = RLENGTH; f = 1; next
    }
    f {
      if ($0 ~ /^[[:space:]]*$/) next
      match($0, /^[[:space:]]*/)
      if (RLENGTH <= ind) exit
      print
    }
  '
}

# envfrom_ref <envFrom-block> <kind> — the `name:` value of the `- <kind>:` list
# entry inside an envFrom block (kind is configMapRef or secretRef). Prints
# nothing when the entry is absent, so an assert_equals against it goes red.
envfrom_ref() {
  printf '%s' "$1" | awk -v kind="$2" '
    $0 ~ "^[[:space:]]*-[[:space:]]*" kind ":[[:space:]]*$" { f = 1; next }
    f && /^[[:space:]]*name:[[:space:]]*/ {
      sub(/^[[:space:]]*name:[[:space:]]*/, ""); gsub(/"/, ""); print; exit
    }
    f && /^[[:space:]]*-[[:space:]]*[A-Za-z]+:/ { f = 0 }
  '
}

# ---------------------------------------------------------------------------
# r1 — values-prod renders, carries no copy-paste caveat, and its DERIVED URLs
#      and ingress wiring match the chosen hostname. "It rendered" is not the
#      criterion: a partner's install has to produce WORKING URLs.
# ---------------------------------------------------------------------------
PROD_HOST="app.fishhawk.example"
render -f "$CHART/values-prod.yaml"
assert_render_ok "r1 values-prod renders"
if grep -qF "Not copy-paste-deployable as-is" "$CHART/values-prod.yaml"; then
  fail "r1 values-prod still carries the copy-paste caveat"
else
  pass "r1 values-prod copy-paste caveat is gone"
fi
render -f "$CHART/values-prod.yaml" --show-only templates/configmap.yaml
assert_contains "r1 derived FISHHAWKD_EXTERNAL_URL matches the chosen host" "$out" \
  "FISHHAWKD_EXTERNAL_URL: \"https://$PROD_HOST\""
assert_contains "r1 derived FISHHAWKD_OAUTH_CALLBACK_URL carries the registered callback path" "$out" \
  "FISHHAWKD_OAUTH_CALLBACK_URL: \"https://$PROD_HOST/v0/auth/github/callback\""
render -f "$CHART/values-prod.yaml" --show-only templates/ingress.yaml
assert_contains "r1 ingress class" "$out" "ingressClassName: nginx"
assert_contains "r1 ingress TLS host" "$out" "- \"$PROD_HOST\""
assert_contains "r1 ingress rule host" "$out" "host: \"$PROD_HOST\""
assert_contains "r1 cert-manager issuer annotation" "$out" \
  "cert-manager.io/cluster-issuer: letsencrypt-prod"

# The registered callback PATH is a cross-boundary claim: assert the chart's
# derived path is the one fishhawkd actually registers, not just a plausible one.
if grep -rqF "/v0/auth/github/callback" "$REPO_ROOT/backend/cmd/fishhawkd/" 2>/dev/null; then
  pass "r1 derived callback path matches the path fishhawkd registers"
else
  fail "r1 derived callback path /v0/auth/github/callback not found in backend/cmd/fishhawkd/"
fi

# ---------------------------------------------------------------------------
# r2 — fishhawk.validateSecretContract, ONE CASE PER NAMED FAILURE MODE.
#      Each bad state is seeded BY CONSTRUCTION in a values file, not by calling
#      the guard in the setup, so the RED lands on the behavioural assertion.
# ---------------------------------------------------------------------------
# r2a chartManaged, a required field ABSENT from secrets.values. config.oauthClientId
# is set so FISHHAWKD_OAUTH_CLIENT_SECRET is REQUIRED (derived requiredness,
# #2915) and this case still pins the absent-required-field failure rather than
# passing because OAuth is off.
cat > "$tmproot/r2a.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://r2a.example/v0/auth/github/callback"
secrets:
  mode: chartManaged
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
    githubAppPrivateKey: "pem"
YAML
render -f "$tmproot/r2a.yaml"
assert_render_fails "r2a chartManaged, required secrets.values field ABSENT" \
  "FISHHAWKD_OAUTH_CLIENT_SECRET"

# r2b chartManaged, the SAME field present but an EMPTY STRING. Deliberately
# distinct from r2a: present-but-empty must not pass.
cat > "$tmproot/r2b.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://r2b.example/v0/auth/github/callback"
secrets:
  mode: chartManaged
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    oauthClientSecret: ""
    anthropicApiKey: "a"
    githubAppPrivateKey: "pem"
YAML
render -f "$tmproot/r2b.yaml"
assert_render_fails "r2b chartManaged, required secrets.values field EMPTY STRING" \
  "FISHHAWKD_OAUTH_CLIENT_SECRET"

# r2c externalSecrets, a required secretKey not covered by data[].
cat > "$tmproot/r2c.yaml" <<'YAML'
profile: prod
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://r2c.example/v0/auth/github/callback"
secrets:
  mode: externalSecrets
  githubApp:
    privateKeyFile:
      enabled: false
  externalSecrets:
    secretStoreRef:
      name: fishhawk-store
    data:
      - secretKey: FISHHAWKD_DATABASE_URL
        remoteRef:
          key: fishhawk/db
      - secretKey: FISHHAWKD_GITHUB_WEBHOOK_SECRET
        remoteRef:
          key: fishhawk/webhook
      - secretKey: FISHHAWKD_ANTHROPIC_API_KEY
        remoteRef:
          key: fishhawk/anthropic
YAML
render -f "$tmproot/r2c.yaml"
assert_render_fails "r2c externalSecrets, required secretKey not mapped by data[]" \
  "FISHHAWKD_OAUTH_CLIENT_SECRET"

# r2d existing, existingSecret empty.
render --set secrets.mode=existing --set existingSecret=""
assert_render_fails "r2d existing, existingSecret empty" \
  "secrets.mode=existing requires existingSecret"

# r2e the PEM record participates in the contract at all — the C7 defect was that
# an env-keyed map had NO entry for the dotted PEM key, so it was never validated.
# No oauthClientSecret and no client id: OAuth is entirely off, so validateOAuthTrio
# is silent and the RED lands on the PEM contract, not an incidental partial trio.
cat > "$tmproot/r2e.yaml" <<'YAML'
profile: local
secrets:
  mode: chartManaged
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
    githubAppPrivateKey: ""
YAML
render -f "$tmproot/r2e.yaml"
assert_render_fails "r2e chartManaged, PEM required (privateKeyFile.enabled) but empty" \
  "githubAppPrivateKey"

# r2f chartManaged with the WHOLE secrets.values map overridden to null. `index`
# on an untyped nil raises "error calling index: index of untyped nil" — a raw
# Go-template trace, not the guard's named message — so the guard substitutes an
# empty dict and the operator gets the same actionable failure an absent single
# field produces. Asserting the NAMED text (not merely a non-zero exit) is what
# discriminates: without `| default dict` the render still fails, but with the
# opaque trace instead.
cat > "$tmproot/r2f.yaml" <<'YAML'
profile: local
secrets:
  mode: chartManaged
  values: null
YAML
render -f "$tmproot/r2f.yaml"
assert_render_fails "r2f chartManaged with a NULL secrets.values map names the missing field" \
  "requires a non-empty secrets.values.databaseUrl"
assert_absent "r2f null secrets.values does not surface a raw Go-template index error" "$err" \
  "index of untyped nil"

# ---------------------------------------------------------------------------
# r3 — requests AND limits on the fishhawkd container and on the migrate Job.
#      Limits included, so the criterion and its deciding test agree.
# ---------------------------------------------------------------------------
r3_resources() { # <label> <show-only template>
  render --show-only "$2"
  local block
  block=$(printf '%s' "$out" | awk '/^ *resources:/{f=1} f{print} /^ *volumeMounts:|^ *livenessProbe:/{if(f)exit}')
  assert_contains "$1 requests present" "$block" "requests:"
  assert_contains "$1 limits present" "$block" "limits:"
  assert_contains "$1 requests.cpu" "$block" "cpu: 100m"
  assert_contains "$1 limits.memory" "$block" "memory: 512Mi"
}
r3_resources "r3 fishhawkd container" templates/deployment.yaml
r3_resources "r3 migrate Job" templates/migrate-job.yaml

# ---------------------------------------------------------------------------
# r4 — migrate Job timing + restartPolicy, and the validateMigrateTiming guard.
# ---------------------------------------------------------------------------
render --show-only templates/migrate-job.yaml
assert_render_ok "r4 migrate Job renders by default"
assert_contains "r4 restartPolicy Never (failed-pod logs persist for kubectl logs)" "$out" "restartPolicy: Never"
assert_absent   "r4 restartPolicy is not OnFailure" "$out" "restartPolicy: OnFailure"
assert_contains "r4 backoffLimit 2 (derived time-to-Failed inside Helm's 300s default)" "$out" "backoffLimit: 2"
assert_field_absent "r4 activeDeadlineSeconds omitted by default" "$out" "activeDeadlineSeconds"

# A too-tight deadline must fail the render naming BOTH numbers: the deadline the
# operator set and the derived time-to-Failed it would beat.
render --set migrate.activeDeadlineSeconds=60 --show-only templates/migrate-job.yaml
assert_render_fails "r4 too-tight activeDeadlineSeconds names the deadline" "migrate.activeDeadlineSeconds=60"
assert_render_fails "r4 too-tight activeDeadlineSeconds names the derived time-to-Failed" "210s"

# THE BOUNDARY. The derived figure is a LOWER bound, so a deadline EQUAL to it
# already loses the race — validateMigrateTiming compares with `le`, not `lt`,
# and this case pins that as a decided behaviour rather than an accident of which
# operator was reached for. Without it the harness tests only 60 (far below) and
# 600 (far above), and flipping le→lt stays green.
render --set migrate.activeDeadlineSeconds=210 --show-only templates/migrate-job.yaml
assert_render_fails "r4 activeDeadlineSeconds EQUAL to the derived time-to-Failed is rejected" "migrate.activeDeadlineSeconds=210"
# One above the boundary renders — so the case above fails on the boundary rule,
# not on 210 being unrenderable for some unrelated reason.
render --set migrate.activeDeadlineSeconds=211 --show-only templates/migrate-job.yaml
assert_render_ok "r4 activeDeadlineSeconds one second ABOVE the boundary renders"
assert_contains "r4 boundary+1 deadline is emitted" "$out" "activeDeadlineSeconds: 211"

# activeDeadlineSeconds=0 is UNSET, not a zero-second ceiling: the guard is inert
# and the Job emits no such field (a 0 would be rejected by the Job controller's
# own exclusive-minimum-0 validation). Documented in values.yaml + the helper.
render --set migrate.activeDeadlineSeconds=0 --show-only templates/migrate-job.yaml
assert_render_ok "r4 activeDeadlineSeconds=0 is treated as unset and renders"
assert_field_absent "r4 activeDeadlineSeconds=0 emits no activeDeadlineSeconds field" "$out" "activeDeadlineSeconds"

# A generous deadline renders and is emitted verbatim.
render --set migrate.activeDeadlineSeconds=600 --show-only templates/migrate-job.yaml
assert_render_ok "r4 generous activeDeadlineSeconds renders"
assert_contains "r4 generous activeDeadlineSeconds is emitted" "$out" "activeDeadlineSeconds: 600"

# ---------------------------------------------------------------------------
# r5 — THE WIRING CASE (C8). Object-level assertions on the ConfigMap/Secret are
#      sufficient ONLY while the chart consumes them via envFrom. This case pins
#      that idiom on rendered output for all three workload shapes plus the
#      migrate Job. If the chart ever moves to explicit env entries, r5 goes red
#      instead of the sufficiency claim silently becoming false.
# ---------------------------------------------------------------------------
r5_envfrom() { # <label> <secret-name> <args...>
  local label="$1" secret="$2"; shift 2
  render "$@"
  local block
  block=$(yaml_block "$out" "envFrom")
  if [ -n "$block" ]; then pass "$label carries an envFrom block"; else fail "$label has no envFrom block"; fi
  # Both names are read from INSIDE the envFrom block, under their own ref kind.
  # Deleting either list entry empties the corresponding lookup and reddens the
  # case; a Secret still referenced only by the PEM volume does not satisfy it,
  # and a move from envFrom to explicit `env` entries reddens all three.
  assert_equals "$label envFrom configMapRef names the ConfigMap" \
    "$(envfrom_ref "$block" configMapRef)" "fishhawk-config"
  assert_equals "$label envFrom secretRef names the Secret" \
    "$(envfrom_ref "$block" secretRef)" "$secret"
}
r5_envfrom "r5 allInOne Deployment" fishhawk-secrets --show-only templates/deployment.yaml
r5_envfrom "r5 split -api Deployment" fishhawk-secrets --set deployment.mode=split --show-only templates/deployment-api.yaml
r5_envfrom "r5 split -worker Deployment" fishhawk-secrets --set deployment.mode=split --show-only templates/deployment-worker.yaml
r5_envfrom "r5 migrate Job" fishhawk-secrets --show-only templates/migrate-job.yaml
# The secretRef name tracks fishhawk.secretName across modes, not a literal.
r5_envfrom "r5 chartManaged secretRef name" fishhawk-secrets \
  -f "$CHART/values-local.yaml" --show-only templates/deployment.yaml

# Cell keys land where they are consumed from: the two NON-secret halves in the
# ConfigMap, the two SECRET halves in the credential contract.
render -f "$CHART/values-cell.yaml" --show-only templates/configmap.yaml
assert_contains "r5 cell FISHHAWKD_HOME_REGION in the ConfigMap" "$out" 'FISHHAWKD_HOME_REGION: "us"'
assert_contains "r5 cell FISHHAWKD_MODEL_BASE_URL in the ConfigMap" "$out" 'FISHHAWKD_MODEL_BASE_URL: "https://inference.us.fishhawk.example"'
assert_absent "r5 cell handoff secret is NOT in the ConfigMap" "$out" "FISHHAWKD_HANDOFF_SECRET"
assert_absent "r5 cell model API key is NOT in the ConfigMap" "$out" "FISHHAWKD_MODEL_API_KEY"

# The cell secret halves are REQUIRED by the contract in each of the three modes.
# existing: only existingSecret is checkable at render time, so assert the two
# other modes reject a cell profile that omits them.
cat > "$tmproot/r5cell-cm.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://cell.example/v0/auth/github/callback"
cell:
  homeRegion: us
  modelBaseUrl: https://inference.us.example
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    oauthClientSecret: "o"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r5cell-cm.yaml"
assert_render_fails "r5 cell profile, chartManaged missing FISHHAWKD_HANDOFF_SECRET" "FISHHAWKD_HANDOFF_SECRET"
cat > "$tmproot/r5cell-es.yaml" <<'YAML'
profile: prod
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://cell.example/v0/auth/github/callback"
cell:
  homeRegion: us
  modelBaseUrl: https://inference.us.example
secrets:
  mode: externalSecrets
  githubApp:
    privateKeyFile:
      enabled: false
  externalSecrets:
    secretStoreRef:
      name: fishhawk-store
    data:
      - secretKey: FISHHAWKD_DATABASE_URL
        remoteRef: {key: fishhawk/db}
      - secretKey: FISHHAWKD_GITHUB_WEBHOOK_SECRET
        remoteRef: {key: fishhawk/webhook}
      - secretKey: FISHHAWKD_OAUTH_CLIENT_SECRET
        remoteRef: {key: fishhawk/oauth}
      - secretKey: FISHHAWKD_ANTHROPIC_API_KEY
        remoteRef: {key: fishhawk/anthropic}
      - secretKey: FISHHAWKD_HANDOFF_SECRET
        remoteRef: {key: fishhawk/handoff}
YAML
render -f "$tmproot/r5cell-es.yaml"
assert_render_fails "r5 cell profile, externalSecrets missing FISHHAWKD_MODEL_API_KEY" "FISHHAWKD_MODEL_API_KEY"
# And a COMPLETE cell mapping renders — so the two cases above fail on the
# missing key, not on the cell profile being unrenderable at all.
cat "$tmproot/r5cell-es.yaml" > "$tmproot/r5cell-es-ok.yaml"
cat >> "$tmproot/r5cell-es-ok.yaml" <<'YAML'
      - secretKey: FISHHAWKD_MODEL_API_KEY
        remoteRef: {key: fishhawk/model}
YAML
render -f "$tmproot/r5cell-es-ok.yaml"
assert_render_ok "r5 cell profile, complete externalSecrets mapping renders"

# FISHHAWKD_DATABASE_URL, asserted PER PROFILE against the path that profile uses.
# postgres.enabled → a container-level env entry (which overrides envFrom);
# otherwise → a REQUIRED Secret key with no container-level entry.
# Scoped to the container's own `env:` block, not the whole document: the key
# name also appears in the ConfigMap-adjacent comments and (in chartManaged) in
# the Secret, so a document-wide substring match would not distinguish "a
# container-level env entry" from "mentioned somewhere".
render -f "$CHART/values-local.yaml" --show-only templates/deployment.yaml
envblk=$(yaml_block "$out" "env")
assert_contains "r5 local (postgres.enabled) DB URL is a container-level env entry" "$envblk" "name: FISHHAWKD_DATABASE_URL"
assert_contains "r5 local container-level DB URL points at the in-cluster Service" "$envblk" "@fishhawk-postgres:5432/fishhawk?sslmode=disable"
render -f "$CHART/values-prod.yaml" --show-only templates/deployment.yaml
envblk=$(yaml_block "$out" "env")
assert_absent "r5 prod DB URL is NOT a container-level env entry (it arrives via the Secret)" "$envblk" "name: FISHHAWKD_DATABASE_URL"
render -f "$CHART/values-local.yaml" --show-only templates/secret.yaml
assert_contains "r5 local chartManaged Secret still carries the DB URL key" "$out" "FISHHAWKD_DATABASE_URL"
# The requiredness predicate itself: with postgres.enabled the DB URL is NOT
# required (r6's local profile renders); without it, it IS.
cat > "$tmproot/r5db.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://db.example/v0/auth/github/callback"
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    githubWebhookSecret: "w"
    oauthClientSecret: "o"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r5db.yaml"
assert_render_fails "r5 DB URL required when postgres.enabled is false" "FISHHAWKD_DATABASE_URL"
render -f "$tmproot/r5db.yaml" --set postgres.enabled=true
assert_render_ok "r5 DB URL NOT required when postgres.enabled (in-cluster env overrides envFrom)"

# The PEM's dotted secretKey is a Secret key and a projected FILE, never an env
# key — envFrom skips it as an invalid identifier, so validating it as env would
# be wrong.
render -f "$CHART/values-local.yaml" --show-only templates/secret.yaml
assert_contains "r5 PEM dotted key is a Secret key" "$out" '"github-app-private-key.pem":'
render -f "$CHART/values-local.yaml" --show-only templates/deployment.yaml
assert_absent "r5 PEM dotted key is NOT emitted as an env key" "$out" "name: github-app-private-key.pem"
assert_contains "r5 PEM dotted key backs the volume items: projection" "$out" 'key: "github-app-private-key.pem"'

# ---------------------------------------------------------------------------
# r6 — every profile renders; the cell profile additionally under all three
#      secret modes.
# ---------------------------------------------------------------------------
for prof in values-local values-prod values-cell values-single-tenant; do
  render -f "$CHART/$prof.yaml"
  assert_render_ok "r6 $prof renders"
done
render -f "$CHART/values-cell.yaml"
assert_render_ok "r6 cell profile, secrets.mode=existing"
render -f "$tmproot/r5cell-es-ok.yaml"
assert_render_ok "r6 cell profile, secrets.mode=externalSecrets"
cat > "$tmproot/r6cell-cm.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://cell.example/v0/auth/github/callback"
cell:
  homeRegion: us
  modelBaseUrl: https://inference.us.example
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    oauthClientSecret: "o"
    anthropicApiKey: "a"
    handoffSecret: "h"
    modelApiKey: "m"
YAML
render -f "$tmproot/r6cell-cm.yaml"
assert_render_ok "r6 cell profile, secrets.mode=chartManaged"
render -f "$tmproot/r6cell-cm.yaml" --show-only templates/secret.yaml
assert_contains "r6 cell chartManaged Secret carries the handoff secret" "$out" '"FISHHAWKD_HANDOFF_SECRET": "h"'
assert_contains "r6 cell chartManaged Secret carries the model API key" "$out" '"FISHHAWKD_MODEL_API_KEY": "m"'

# ---------------------------------------------------------------------------
# r7 — helm lint per profile.
# ---------------------------------------------------------------------------
for prof in values-local values-prod values-cell values-single-tenant; do
  if lint_out=$("$(command -v helm)" lint "$CHART" -f "$CHART/$prof.yaml" 2>&1); then
    pass "r7 helm lint $prof"
  else
    fail "r7 helm lint $prof: $(printf '%s' "$lint_out" | tail -3)"
  fi
done

# ---------------------------------------------------------------------------
# r8 — THE MODE-1 FAIL-CLOSED CASE. fishhawkd REFUSES to start when any
#      FISHHAWKD_SINGLE_TENANT_* key is set while the ACCOUNT KEY is empty — a
#      deployment with no admitting account is one nobody can sign in to. That
#      posture is only reachable if the chart hands the half-configured profile
#      to the pod UNCHANGED. So: render with singleTenant fields set and
#      accountKey EMPTY, and assert the keys are emitted verbatim, the account
#      key is NOT defaulted to something benign, and the render does NOT silently
#      drop the partial config into a clean hosted posture.
# ---------------------------------------------------------------------------
cat > "$tmproot/r8-halfconfigured.yaml" <<'YAML'
profile: prod
singleTenant:
  accountKey: ""
  granularity: enterprise
  autoJoinRole: member
  displayName: Acme Corp
  provider: github
YAML
render -f "$tmproot/r8-halfconfigured.yaml" --show-only templates/configmap.yaml
assert_render_ok "r8 half-configured single-tenant profile still renders (the chart does not pre-empt fishhawkd's startup check)"
assert_contains "r8 GRANULARITY is emitted UNCHANGED" "$out" 'FISHHAWKD_SINGLE_TENANT_GRANULARITY: "enterprise"'
assert_contains "r8 AUTO_JOIN_ROLE is emitted UNCHANGED" "$out" 'FISHHAWKD_SINGLE_TENANT_AUTO_JOIN_ROLE: "member"'
assert_contains "r8 DISPLAY_NAME is emitted UNCHANGED" "$out" 'FISHHAWKD_SINGLE_TENANT_DISPLAY_NAME: "Acme Corp"'
assert_contains "r8 PROVIDER is emitted UNCHANGED" "$out" 'FISHHAWKD_SINGLE_TENANT_PROVIDER: "github"'
# The account key must be ABSENT, not defaulted: a chart-side default would make
# fishhawkd boot into an account the operator never chose, and the documented
# startup error would become unreachable.
assert_absent "r8 ACCOUNT_KEY is NOT defaulted to a benign value" "$out" "FISHHAWKD_SINGLE_TENANT_ACCOUNT_KEY"
# And the FULLY configured profile does emit it — so r8's absence assertion is
# about the empty key, not about the chart never emitting the key at all.
render -f "$CHART/values-single-tenant.yaml" --show-only templates/configmap.yaml
assert_contains "r8 fully configured profile emits the ACCOUNT_KEY" "$out" 'FISHHAWKD_SINGLE_TENANT_ACCOUNT_KEY: "acme-corp"'

# ---------------------------------------------------------------------------
# r9 — NOTES.txt. `helm template` EXECUTES NOTES.txt (a template error there
#      fails the render, so r6 already covers it) but does not EMIT it, and
#      --show-only cannot select it. So this case uses `helm install --dry-run`
#      to assert the CONTENT: the operator-facing key list is derived from
#      fishhawk.secretKeySpec, not a second hand-authored list that could drift.
# ---------------------------------------------------------------------------
notes() { # <args...>
  out=$("$(command -v helm)" install --dry-run --generate-name "$CHART" "$@" 2>"$tmproot/stderr")
  status=$?
  err=$(cat "$tmproot/stderr")
  out=$(printf '%s' "$out" | awk '/^NOTES:/{f=1} f{print}')
}
notes -f "$CHART/values-cell.yaml"
assert_render_ok "r9 NOTES renders for the cell profile"
# The env-key list is the REQUIRED set for THIS configuration, derived from the
# spec — not a second hand-authored list. Scope the membership assertions to the
# "Env keys" block, because the PEM's dotted key legitimately appears later
# under the FILE key heading at the same indent.
envblock=$(printf '%s' "$out" | awk '/Env keys \(delivered via envFrom\)/{f=1;next} f&&/^[^ ]/{exit} f&&/File key/{exit} f{print}')
assert_contains "r9 NOTES lists a required env key" "$envblock" "- FISHHAWKD_OAUTH_CLIENT_SECRET"
assert_contains "r9 NOTES lists the cell handoff secret for a cell profile" "$envblock" "- FISHHAWKD_HANDOFF_SECRET"
assert_contains "r9 NOTES lists the cell model API key for a cell profile" "$envblock" "- FISHHAWKD_MODEL_API_KEY"
# values-cell sets no config.s3Bucket, so the AWS pair is NOT required and must
# be OMITTED rather than listed — this is the derived-not-fixed discriminator.
assert_absent "r9 NOTES omits a NOT-required key (derived, not a fixed list)" "$envblock" "AWS_ACCESS_KEY_ID"
assert_contains "r9 NOTES states the existing-mode render-time limit" "$out" "CANNOT see a pre-created Secret"
# The key-confirmation command must inspect key NAMES without emitting VALUES.
# `describe` prints "<key>: N bytes"; `-o jsonpath={.data}` / `-o yaml` / `-o
# json` would dump every base64-encoded credential to the terminal and to any
# log capturing it. The value-disclosure assertion is scoped to the RUNNABLE
# kubectl lines, not the whole NOTES text, because the surrounding prose names
# the unsafe flags in order to warn against them.
assert_contains "r9 NOTES gives a key-name-only kubectl confirmation command" "$out" \
  "describe secret fishhawk-secrets"
kubectl_cmds=$(printf '%s' "$out" | grep -E '^[[:space:]]+kubectl ' || true)
if [ -n "$kubectl_cmds" ]; then pass "r9 NOTES carries at least one runnable kubectl command"; else
  fail "r9 NOTES carries no runnable kubectl command line to check"
fi
for unsafe in "jsonpath" "-o yaml" "-o json"; do
  assert_absent "r9 NOTES kubectl commands never print Secret VALUES ($unsafe)" "$kubectl_cmds" "$unsafe"
done
assert_contains "r9 NOTES prints the cell region" "$out" "FISHHAWKD_HOME_REGION   = us"
# The PEM's dotted key is listed as a FILE key, never among the env keys.
assert_contains "r9 NOTES lists the PEM as a file key" "$out" "github-app-private-key.pem"
assert_absent "r9 NOTES does not list the PEM among the env keys" "$envblock" "github-app-private-key.pem"
# A non-cell profile must NOT advertise the cell credentials at all.
notes -f "$CHART/values-single-tenant.yaml"
assert_render_ok "r9 NOTES renders for the single-tenant profile"
envblock=$(printf '%s' "$out" | awk '/Env keys \(delivered via envFrom\)/{f=1;next} f&&/^[^ ]/{exit} f&&/File key/{exit} f{print}')
assert_absent "r9 NOTES omits the cell handoff secret off a cell profile" "$envblock" "FISHHAWKD_HANDOFF_SECRET"
assert_absent "r9 NOTES omits the cell model key off a cell profile" "$envblock" "FISHHAWKD_MODEL_API_KEY"
assert_contains "r9 NOTES still lists the baseline required keys off a cell profile" "$envblock" "- FISHHAWKD_DATABASE_URL"

# ---------------------------------------------------------------------------
# r10 — THE OAUTH TRIO, POSITIVE + OFF POSTURE (E69.4 / #2915). fishhawkd
#       enforces all-three-or-none (client id + client secret + callback URL,
#       serve.go); the chart must configure the trio COMPLETELY or leave it
#       entirely off. "It rendered" is not the criterion — assert the three
#       halves land together in the shipped ConfigMap + Secret.
# ---------------------------------------------------------------------------
render -f "$CHART/values-local.yaml" --show-only templates/configmap.yaml
assert_contains "r10 values-local ConfigMap carries FISHHAWKD_OAUTH_CLIENT_ID" "$out" \
  'FISHHAWKD_OAUTH_CLIENT_ID: "dev-oauth-client-id"'
assert_contains "r10 values-local ConfigMap carries the callback URL" "$out" \
  'FISHHAWKD_OAUTH_CALLBACK_URL: "http://localhost:8080/v0/auth/github/callback"'
render -f "$CHART/values-local.yaml" --show-only templates/secret.yaml
assert_contains "r10 values-local chartManaged Secret carries FISHHAWKD_OAUTH_CLIENT_SECRET" "$out" \
  "FISHHAWKD_OAUTH_CLIENT_SECRET"
# values-prod: id present, callback DERIVED from the host (the client-id gate is
# what makes the callback derive at all).
render -f "$CHART/values-prod.yaml" --show-only templates/configmap.yaml
assert_contains "r10 values-prod ConfigMap carries FISHHAWKD_OAUTH_CLIENT_ID" "$out" \
  'FISHHAWKD_OAUTH_CLIENT_ID: "substitute-your-oauth-client-id"'
assert_contains "r10 values-prod derived callback matches the host" "$out" \
  "FISHHAWKD_OAUTH_CALLBACK_URL: \"https://$PROD_HOST/v0/auth/github/callback\""

# OFF posture: no client id + an ENABLED ingress renders NO client id and NO
# callback (the client-id gate on the derivation), and renders SUCCESSFULLY with
# secrets.values.oauthClientSecret ABSENT — the derived-requiredness
# discriminator (a hardcoded `required: true` fails this render on the missing
# secret; reverting the callback gate leaks a lone callback key here).
cat > "$tmproot/r10-off.yaml" <<'YAML'
profile: local
ingress:
  enabled: true
  host: off.fishhawk.example
  tls:
    enabled: true
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r10-off.yaml"
assert_render_ok "r10 OFF posture renders with no client id and no client secret (derived requiredness)"
render -f "$tmproot/r10-off.yaml" --show-only templates/configmap.yaml
assert_field_absent "r10 OFF posture emits no FISHHAWKD_OAUTH_CLIENT_ID" "$out" "FISHHAWKD_OAUTH_CLIENT_ID"
assert_field_absent "r10 OFF posture emits no FISHHAWKD_OAUTH_CALLBACK_URL even with the ingress enabled" "$out" "FISHHAWKD_OAUTH_CALLBACK_URL"

# ---------------------------------------------------------------------------
# r11 — THE OAUTH TRIO, ONE CASE PER NAMED FAILURE MODE. Each partial
#       combination is seeded BY CONSTRUCTION and asserts BOTH a non-zero exit
#       AND the guard's named message, so a render failing for an unrelated
#       reason cannot green it.
# ---------------------------------------------------------------------------
# r11a id set + callback empty (ingress off, no explicit callback) -> validateOAuthTrio (i).
cat > "$tmproot/r11a.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    oauthClientSecret: "o"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r11a.yaml"
assert_render_fails "r11a id set + callback empty is rejected" \
  "config.oauthClientId is set but the OAuth callback URL is empty"
# Binding condition 3: the message must name BOTH ways out.
assert_render_fails "r11a message names the explicit-callback route" "set config.oauthCallbackUrl"
assert_render_fails "r11a message names the ingress-derivation route" "enable the ingress"

# r11b explicit callback set + id empty (existing mode) -> validateOAuthTrio (ii).
# Also the risk-note case: existing mode + explicit callback + no id must fail.
cat > "$tmproot/r11b.yaml" <<'YAML'
profile: prod
config:
  oauthCallbackUrl: "https://r11b.example/v0/auth/github/callback"
secrets:
  mode: existing
existingSecret: fishhawk-secrets
YAML
render -f "$tmproot/r11b.yaml"
assert_render_fails "r11b explicit callback + id empty is rejected" "an OAuth callback URL is configured"
assert_render_fails "r11b message names config.oauthClientId as the missing piece" "config.oauthClientId is empty"

# r11c chartManaged secret supplied + id empty -> validateOAuthTrio (iii).
cat > "$tmproot/r11c.yaml" <<'YAML'
profile: local
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    oauthClientSecret: "o"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r11c.yaml"
assert_render_fails "r11c chartManaged secret supplied + id empty is rejected" "an OAuth client secret is supplied"

# r11d externalSecrets data[] maps the secret + id empty -> validateOAuthTrio (iii).
cat > "$tmproot/r11d.yaml" <<'YAML'
profile: prod
secrets:
  mode: externalSecrets
  githubApp:
    privateKeyFile:
      enabled: false
  externalSecrets:
    secretStoreRef:
      name: fishhawk-store
    data:
      - secretKey: FISHHAWKD_DATABASE_URL
        remoteRef: {key: fishhawk/db}
      - secretKey: FISHHAWKD_GITHUB_WEBHOOK_SECRET
        remoteRef: {key: fishhawk/webhook}
      - secretKey: FISHHAWKD_ANTHROPIC_API_KEY
        remoteRef: {key: fishhawk/anthropic}
      - secretKey: FISHHAWKD_OAUTH_CLIENT_SECRET
        remoteRef: {key: fishhawk/oauth}
YAML
render -f "$tmproot/r11d.yaml"
assert_render_fails "r11d externalSecrets data[] maps the secret + id empty is rejected" "an OAuth client secret is supplied"

# r11e id set + chartManaged secret ABSENT -> validateSecretContract's DERIVED
# requiredness (proving the derivation turns the secret requirement ON), NOT a
# second trio branch. One message per condition.
cat > "$tmproot/r11e.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
  oauthCallbackUrl: "https://r11e.example/v0/auth/github/callback"
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r11e.yaml"
assert_render_fails "r11e id set + chartManaged secret absent -> validateSecretContract (derived requiredness)" \
  "FISHHAWKD_OAUTH_CLIENT_SECRET"

# r11f THE "JUST THE CLIENT ID" PATH (#2915 binding condition 3 + the untested-edge
# concern). Only config.oauthClientId is set: callback empty (no ingress, no
# explicit callback) AND the client secret ABSENT (the id makes it required). Both
# validateOAuthTrio branch (i) AND validateSecretContract would fire; the guards
# must be ORDERED so the operator sees the CALLBACK remedy (naming both routes),
# not the secret-contract message. validateOAuthTrio runs before
# validateSecretContract in service.yaml precisely for this case. Asserting the
# trio message is present (helm `fail` halts at the first, so only one message
# reaches stderr) proves the trio guard won the ordering.
cat > "$tmproot/r11f.yaml" <<'YAML'
profile: local
config:
  oauthClientId: "cid"
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r11f.yaml"
assert_render_fails "r11f just-client-id surfaces the callback remedy, not the secret-contract failure" \
  "config.oauthClientId is set but the OAuth callback URL is empty"
assert_render_fails "r11f just-client-id message names the explicit-callback route" "set config.oauthCallbackUrl"
assert_render_fails "r11f just-client-id message names the ingress-derivation route" "enable the ingress"
# And the secret-contract message is NOT what surfaced (proves the ordering, not
# just that SOME guard fired). Without the reorder this would be the message.
assert_absent "r11f the secret-contract message did NOT pre-empt the callback remedy" "$err" \
  "requires a non-empty secrets.values.oauthClientSecret"

# r11g THE EXPLICIT-NULL OAUTH-OFF EDGE (untested-edge concern, #2915). An
# operator who writes `config.oauthClientId: null` (or `--set config.oauthClientId=null`)
# means OAuth OFF — the same posture configmap.yaml and fishhawk.oauthCallbackUrl
# already give a null id. Without the `| default ""` normalization in
# fishhawk.secretKeySpec + fishhawk.validateOAuthTrio, `toString nil` is "<nil>",
# which reads as OAuth-ON: the client secret is marked required and validateOAuthTrio
# branch (i) fires, so the render FAILS on a secret nothing emits. With it the
# render succeeds and NO client-id key is emitted. Deleting either `| default ""`
# reddens this case.
cat > "$tmproot/r11g.yaml" <<'YAML'
profile: local
config:
  oauthClientId: null
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r11g.yaml"
assert_render_ok "r11g explicit-null oauthClientId is treated as OAuth-off and renders (no secret required, trio silent)"
render -f "$tmproot/r11g.yaml" --show-only templates/configmap.yaml
assert_field_absent "r11g explicit-null oauthClientId emits no FISHHAWKD_OAUTH_CLIENT_ID" "$out" "FISHHAWKD_OAUTH_CLIENT_ID"

# ---------------------------------------------------------------------------
# r12 — config.extraEnv passthrough + its three guards + the ANTI-DRIFT loop.
# ---------------------------------------------------------------------------
# A passthrough key renders verbatim in the ConfigMap (r5 already proves envFrom
# delivers the whole ConfigMap to the pod). Values are coerced to strings.
render --set config.extraEnv.FISHHAWKD_CUSTOM_THING=hello \
       --set config.extraEnv.FISHHAWKD_NUMERIC=5 \
       --set config.extraEnv.FISHHAWKD_BOOL=true \
       --show-only templates/configmap.yaml
assert_render_ok "r12 extraEnv passthrough renders"
assert_contains "r12 extraEnv string value renders verbatim" "$out" 'FISHHAWKD_CUSTOM_THING: "hello"'
assert_contains "r12 extraEnv numeric value is coerced to a quoted string" "$out" 'FISHHAWKD_NUMERIC: "5"'
assert_contains "r12 extraEnv bool value is coerced to a quoted string" "$out" 'FISHHAWKD_BOOL: "true"'
# helm lint the passthrough so the coercion is proven against the linter too.
if lint_out=$("$(command -v helm)" lint "$CHART" --set config.extraEnv.FISHHAWKD_NUMERIC=5 2>&1); then
  pass "r12 helm lint accepts a numeric extraEnv value (coerced to a string)"
else
  fail "r12 helm lint rejected a numeric extraEnv value: $(printf '%s' "$lint_out" | tail -3)"
fi

# r12a a key colliding with a chart-managed key fails, naming the key.
render --set config.extraEnv.FISHHAWKD_ADDR=x
assert_render_fails "r12a extraEnv key colliding with a chart-managed key is rejected" "FISHHAWKD_ADDR"
assert_render_fails "r12a collision message says so" "collides with a chart-managed ConfigMap key"

# r12b a key that is not a valid env identifier fails, naming the rule.
cat > "$tmproot/r12b.yaml" <<'YAML'
profile: prod
config:
  extraEnv:
    "1INVALID": "x"
secrets:
  mode: existing
existingSecret: fishhawk-secrets
YAML
render -f "$tmproot/r12b.yaml"
assert_render_fails "r12b extraEnv key that is not a valid identifier is rejected" "1INVALID"
assert_render_fails "r12b invalid-identifier message names the rule" "not a valid environment variable identifier"

# r12c a SECRET-bearing key routed through config.extraEnv is rejected (#2915
# security concern): FISHHAWKD_OAUTH_CLIENT_SECRET is a fishhawk.secretKeySpec key
# but NOT a fishhawk.managedConfigKeys key, so the collision guard alone would let
# it through and write the secret into the ConfigMap in plaintext. The fixture is
# `existing` mode with a set existingSecret and no OAuth id/callback so the other
# guards pass and the RED lands on validateExtraEnv, not an unrelated failure.
cat > "$tmproot/r12c.yaml" <<'YAML'
profile: prod
config:
  extraEnv:
    FISHHAWKD_OAUTH_CLIENT_SECRET: "leak-me"
secrets:
  mode: existing
existingSecret: fishhawk-secrets
YAML
render -f "$tmproot/r12c.yaml"
assert_render_fails "r12c extraEnv carrying a known secret key is rejected, naming the key" "FISHHAWKD_OAUTH_CLIENT_SECRET"
assert_render_fails "r12c secret-key message says it is delivered via the Secret" "SECRET-bearing key the chart delivers via the Secret"
# The leaked value must NOT appear in the rendered output — the render failed, so
# nothing rendered, but assert the value never reached stdout regardless.
assert_absent "r12c the secret value never renders into the ConfigMap" "$out" "leak-me"

# r12d an UNMAPPED secret-shaped key is rejected by the SUFFIX guard (#2915,
# operator-authored). r12c above only covers keys the chart already knows via
# fishhawk.secretKeySpec — but config.extraEnv exists precisely for the keys it
# does NOT know, so that deny-list is structurally the wrong population. The key
# must be one the chart genuinely has no secretKeySpec record for, or it would be
# caught by the KNOWN-key guard (r12c) first and never reach the suffix range:
# FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET is NOW a mapped key (E45.32 / #2922), so
# this case uses a still-unmapped secret-shaped key (an integration token the
# chart has no field for). COUNTERFACTUAL: delete the suffix `range` in
# fishhawk.validateExtraEnv and this render SUCCEEDS with
# FISHHAWKD_JIRA_API_TOKEN: "leak-me-too" in the ConfigMap. Verified by execution.
cat > "$tmproot/r12d.yaml" <<'YAML'
profile: prod
config:
  extraEnv:
    FISHHAWKD_JIRA_API_TOKEN: "leak-me-too"
secrets:
  mode: existing
existingSecret: fishhawk-secrets
YAML
render -f "$tmproot/r12d.yaml"
assert_render_fails "r12d extraEnv carrying an unmapped secret-shaped key is rejected, naming the key" "FISHHAWKD_JIRA_API_TOKEN"
assert_render_fails "r12d suffix message names the matched suffix" "ends in \"_TOKEN\""
assert_absent "r12d the unmapped secret value never renders into the ConfigMap" "$out" "leak-me-too"

# r12f the newly-mapped GitLab client secret is now caught by the KNOWN-key guard,
# NOT the suffix guard — E45.32 / #2922 turned it into a fishhawk.secretKeySpec
# record. Pin that transition so r12d's key choice stays honest: routing it through
# extraEnv draws the "SECRET-bearing key the chart delivers via the Secret"
# message, the same as any other mapped secret key.
cat > "$tmproot/r12f.yaml" <<'YAML'
profile: prod
config:
  extraEnv:
    FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET: "leak-me-too"
secrets:
  mode: existing
existingSecret: fishhawk-secrets
YAML
render -f "$tmproot/r12f.yaml"
assert_render_fails "r12f a now-mapped GitLab secret routed through extraEnv is rejected as a known secret key" \
  "SECRET-bearing key the chart delivers via the Secret"
assert_absent "r12f the GitLab secret value never renders into the ConfigMap" "$out" "leak-me-too"

# r12e the suffix guard must NOT false-positive on an ordinary non-secret key.
# Bare "_KEY" is deliberately absent from the suffix list because it matches
# names like a partition or sort key; "_PRIVATE_KEY"/"_API_KEY" carry the same
# signal without that cost. This case is what stops a later widening to "_KEY"
# from landing silently.
cat > "$tmproot/r12e.yaml" <<'YAML'
profile: prod
config:
  extraEnv:
    FISHHAWKD_PARTITION_KEY: "p1"
    FISHHAWKD_SOME_FLAG: "on"
secrets:
  mode: existing
existingSecret: fishhawk-secrets
YAML
render -f "$tmproot/r12e.yaml"
assert_render_ok "r12e an ordinary _KEY-suffixed non-secret key still renders"
assert_contains "r12e the non-secret key reaches the ConfigMap" "$out" "FISHHAWKD_PARTITION_KEY"

# ANTI-DRIFT (binding condition 4): the fixture enables an ingress AND sets a
# client id so the DERIVED keys (FISHHAWKD_OAUTH_CLIENT_ID / _CALLBACK_URL /
# _EXTERNAL_URL) are in the emitted set — otherwise the loop under-covers exactly
# the keys this change adds. Render the all-config-keys ConfigMap, extract every
# emitted FISHHAWKD_* key at KEY position (a comment naming a key must not count),
# and assert `--set config.extraEnv.<KEY>=x` collides for EACH. A key added to
# configmap.yaml without a fishhawk.managedConfigKeys entry reddens this loop.
cat > "$tmproot/r12-allkeys.yaml" <<'YAML'
profile: local
ingress:
  enabled: true
  host: allkeys.fishhawk.example
  tls:
    enabled: true
config:
  addr: ":8080"
  s3Region: "us-east-1"
  s3Endpoint: "http://m:9000"
  s3Bucket: "b"
  oauthClientId: "cid"
  oauthRedirectAfterLogin: "/"
  oidcAudience: "aud"
  oidcJwksUrl: "https://jwks.example"
  githubAppId: "1"
  planReviewModel: "m"
  budgetTimezone: "UTC"
  githubApiUrl: "https://a/api/v3"
  githubUploadUrl: "https://a/uploads"
  oauthAuthorizeUrl: "https://a/authorize"
  oauthTokenUrl: "https://a/token"
  oauthUserUrl: "https://a/user"
  oauthOrgsUrl: "https://a/orgs"
cell:
  homeRegion: us
  modelBaseUrl: "https://inf.example"
singleTenant:
  accountKey: acme
  granularity: enterprise
  autoJoinRole: member
  displayName: Acme
  provider: github
gitlab:
  baseUrl: "https://gitlab.example.com"
  oauthClientId: "gl-cid"
  oauthCallbackUrl: "https://allkeys.fishhawk.example/v0/auth/gitlab/callback"
  deviceClientId: "gl-dev"
  installationHostAllowlist: "gitlab.example.com"
secrets:
  mode: chartManaged
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    oauthClientSecret: "o"
    anthropicApiKey: "a"
    awsAccessKeyId: "ak"
    awsSecretAccessKey: "sk"
    githubAppPrivateKey: "pem"
    handoffSecret: "h"
    modelApiKey: "mk"
    gitlabToken: "glt"
    gitlabWebhookSecret: "glw"
    gitlabOauthClientSecret: "gls"
YAML
render -f "$tmproot/r12-allkeys.yaml" --show-only templates/configmap.yaml
assert_render_ok "r12 all-config-keys fixture renders"
emitted_keys=$(printf '%s' "$out" | grep -oE '^[[:space:]]*FISHHAWKD_[A-Z0-9_]+:' | sed 's/[[:space:]:]//g' | sort -u)
# Sanity (binding condition 4): the derived keys this change adds MUST be in the
# emitted set, or the loop below silently under-covers them.
assert_contains "r12 anti-drift fixture emits the derived FISHHAWKD_OAUTH_CLIENT_ID" "$emitted_keys" "FISHHAWKD_OAUTH_CLIENT_ID"
assert_contains "r12 anti-drift fixture emits the derived FISHHAWKD_OAUTH_CALLBACK_URL" "$emitted_keys" "FISHHAWKD_OAUTH_CALLBACK_URL"
# And the five GitLab ConfigMap keys this change adds, so the anti-drift loop
# below actually exercises the managedConfigKeys entries for them (E45.32 / #2922).
for glk in FISHHAWKD_GITLAB_BASE_URL FISHHAWKD_GITLAB_OAUTH_CLIENT_ID FISHHAWKD_GITLAB_OAUTH_CALLBACK_URL FISHHAWKD_GITLAB_DEVICE_CLIENT_ID FISHHAWKD_GITLAB_INSTALLATION_HOST_ALLOWLIST; do
  assert_contains "r12 anti-drift fixture emits $glk" "$emitted_keys" "$glk"
done
drift_ok=1
while IFS= read -r k; do
  [ -n "$k" ] || continue
  render -f "$tmproot/r12-allkeys.yaml" --set "config.extraEnv.$k=x"
  if [ "$status" -eq 0 ]; then
    fail "r12 anti-drift: config.extraEnv.$k did NOT collide (fishhawk.managedConfigKeys is missing $k)"
    drift_ok=0
  fi
done <<< "$emitted_keys"
if [ "$drift_ok" -eq 1 ]; then
  pass "r12 anti-drift: every emitted FISHHAWKD_* key collides with config.extraEnv (managedConfigKeys is complete)"
fi

# ---------------------------------------------------------------------------
# r13 — CROSS-BOUNDARY. The chart configures a SEPARATE binary, so pin the
#       joint-validation claim to the contract it mirrors: fishhawkd reads
#       FISHHAWKD_OAUTH_CLIENT_ID and enforces all-three-or-none at startup
#       (serve.go). Same technique r1 uses for the callback path.
# ---------------------------------------------------------------------------
if grep -rqF "FISHHAWKD_OAUTH_CLIENT_ID" "$REPO_ROOT/backend/cmd/fishhawkd/" 2>/dev/null; then
  pass "r13 FISHHAWKD_OAUTH_CLIENT_ID is the env source fishhawkd reads"
else
  fail "r13 FISHHAWKD_OAUTH_CLIENT_ID not found in backend/cmd/fishhawkd/"
fi
if grep -rqF "must all be set" "$REPO_ROOT/backend/cmd/fishhawkd/" 2>/dev/null; then
  pass "r13 fishhawkd enforces the all-three-or-none OAuth refusal the chart mirrors"
else
  fail "r13 all-three-or-none OAuth refusal text not found in backend/cmd/fishhawkd/"
fi
# GitLab cross-boundary (E45.32 / #2922): the chart mirrors resolveGitLabOAuth's
# base-URL requirement, so pin that the env var AND the refusal text the guard's
# branch (iv) quotes actually live in the binary — not a plausible invention.
if grep -rqF "FISHHAWKD_GITLAB_BASE_URL" "$REPO_ROOT/backend/cmd/fishhawkd/" 2>/dev/null; then
  pass "r13 FISHHAWKD_GITLAB_BASE_URL is the env source fishhawkd reads"
else
  fail "r13 FISHHAWKD_GITLAB_BASE_URL not found in backend/cmd/fishhawkd/"
fi
if grep -rqF "must name the GitLab instance host" "$REPO_ROOT/backend/cmd/fishhawkd/" 2>/dev/null; then
  pass "r13 fishhawkd's resolveGitLabOAuth base-URL refusal is the contract the chart's branch (iv) mirrors"
else
  fail "r13 resolveGitLabOAuth base-URL refusal text not found in backend/cmd/fishhawkd/"
fi

# ---------------------------------------------------------------------------
# r14 — THE GITLAB FAMILY (E45.32 / #2922). The chart must make GitLab
#       CONFIGURABLE (ConfigMap + Secret) without disturbing a GitHub-only
#       deploy, and mirror fishhawkd's resolveGitLabOAuth all-three-or-none +
#       base-URL contract at render time. Every case asserts SHIPPED RENDERED
#       OUTPUT; each failure case asserts BOTH a non-zero exit AND the
#       branch-specific message. Bad state is seeded BY CONSTRUCTION (a values
#       file omitting a field), so a RED lands on the render assertion.
# ---------------------------------------------------------------------------
# A chartManaged baseline used by several r14 cases (GitHub OAuth off, PEM off).
r14_base='profile: local
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"'

# r14a THE GITHUB-ONLY CLAIM (binding condition 1, restated): a deploy that sets
# NO gitlab.* emits NO FISHHAWKD_GITLAB_* key in the ConfigMap and NO GitLab key
# in the chartManaged Secret. assert_field_absent matches at YAML KEY position, so
# the explanatory comment block that names the keys cannot green it. values-local
# is chartManaged with the full baseline but no gitlab config — the real
# GitHub-only posture.
render -f "$CHART/values-local.yaml" --show-only templates/configmap.yaml
assert_render_ok "r14a GitHub-only ConfigMap renders"
for glk in FISHHAWKD_GITLAB_BASE_URL FISHHAWKD_GITLAB_OAUTH_CLIENT_ID FISHHAWKD_GITLAB_OAUTH_CALLBACK_URL FISHHAWKD_GITLAB_DEVICE_CLIENT_ID FISHHAWKD_GITLAB_INSTALLATION_HOST_ALLOWLIST; do
  assert_field_absent "r14a GitHub-only ConfigMap omits $glk" "$out" "$glk"
done
render -f "$CHART/values-local.yaml" --show-only templates/secret.yaml
assert_absent "r14a GitHub-only chartManaged Secret carries no GitLab key" "$out" "FISHHAWKD_GITLAB"

# r14b A COMPLETE GITLAB CONFIG renders all five ConfigMap keys with their values
# AND all three secret keys inside the Secret's stringData block.
cat > "$tmproot/r14b.yaml" <<'YAML'
profile: local
gitlab:
  baseUrl: "https://gitlab.example.com"
  oauthClientId: "gl-cid"
  oauthCallbackUrl: "https://app.example/v0/auth/gitlab/callback"
  deviceClientId: "gl-dev"
  installationHostAllowlist: "gitlab.example.com,gitlab.internal"
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
    gitlabToken: "glt"
    gitlabWebhookSecret: "glw"
    gitlabOauthClientSecret: "gls"
YAML
render -f "$tmproot/r14b.yaml" --show-only templates/configmap.yaml
assert_render_ok "r14b complete GitLab config ConfigMap renders"
assert_contains "r14b ConfigMap base URL" "$out" 'FISHHAWKD_GITLAB_BASE_URL: "https://gitlab.example.com"'
assert_contains "r14b ConfigMap OAuth client id" "$out" 'FISHHAWKD_GITLAB_OAUTH_CLIENT_ID: "gl-cid"'
assert_contains "r14b ConfigMap callback URL" "$out" 'FISHHAWKD_GITLAB_OAUTH_CALLBACK_URL: "https://app.example/v0/auth/gitlab/callback"'
assert_contains "r14b ConfigMap device client id" "$out" 'FISHHAWKD_GITLAB_DEVICE_CLIENT_ID: "gl-dev"'
assert_contains "r14b ConfigMap installation host allowlist" "$out" 'FISHHAWKD_GITLAB_INSTALLATION_HOST_ALLOWLIST: "gitlab.example.com,gitlab.internal"'
render -f "$tmproot/r14b.yaml" --show-only templates/secret.yaml
secretblk=$(yaml_block "$out" "stringData")
assert_contains "r14b Secret carries FISHHAWKD_GITLAB_TOKEN" "$secretblk" '"FISHHAWKD_GITLAB_TOKEN": "glt"'
assert_contains "r14b Secret carries FISHHAWKD_GITLAB_WEBHOOK_SECRET" "$secretblk" '"FISHHAWKD_GITLAB_WEBHOOK_SECRET": "glw"'
assert_contains "r14b Secret carries FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET" "$secretblk" '"FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET": "gls"'

# r14c THE LOGIN-GATE-ONLY POSTURE (binding condition 5, the anti-#2915 case):
# gitlab.baseUrl set, everything else empty, no gitlabToken supplied — must render
# OK and emit FISHHAWKD_GITLAB_BASE_URL. This is the case that goes RED if anyone
# later hardcodes required:true on the gitlabToken record: the chart must not
# mandate a half it cannot complete.
printf '%s\ngitlab:\n  baseUrl: "https://gitlab.example.com"\n' "$r14_base" > "$tmproot/r14c.yaml"
render -f "$tmproot/r14c.yaml"
assert_render_ok "r14c login-gate-only posture (baseUrl alone, no token) renders"
render -f "$tmproot/r14c.yaml" --show-only templates/configmap.yaml
assert_contains "r14c login-gate-only posture emits FISHHAWKD_GITLAB_BASE_URL" "$out" 'FISHHAWKD_GITLAB_BASE_URL: "https://gitlab.example.com"'
assert_field_absent "r14c login-gate-only posture emits no client id" "$out" "FISHHAWKD_GITLAB_OAUTH_CLIENT_ID"

# r14d validateGitLabOAuthTrio branch (i): id set + callback empty. baseUrl is SET
# so branch (iv) does NOT also match — the case is unambiguous about which message
# it pins (binding condition 3). Asserts the callback message AND that it names
# the explicit-only route (deliberately no ingress derivation).
printf '%s\ngitlab:\n  baseUrl: "https://gitlab.example.com"\n  oauthClientId: "cid"\n' "$r14_base" > "$tmproot/r14d.yaml"
render -f "$tmproot/r14d.yaml"
assert_render_fails "r14d branch (i) id set + callback empty is rejected" \
  "gitlab.oauthClientId is set but gitlab.oauthCallbackUrl is empty"
assert_render_fails "r14d branch (i) names the explicit-callback route" "Set gitlab.oauthCallbackUrl explicitly"
assert_render_fails "r14d branch (i) states the callback is NOT ingress-derived" "does NOT derive it from the ingress"

# r14e validateGitLabOAuthTrio branch (ii): callback set + id empty.
printf '%s\ngitlab:\n  baseUrl: "https://gitlab.example.com"\n  oauthCallbackUrl: "https://app.example/v0/auth/gitlab/callback"\n' "$r14_base" > "$tmproot/r14e.yaml"
render -f "$tmproot/r14e.yaml"
assert_render_fails "r14e branch (ii) callback set + id empty is rejected" \
  "gitlab.oauthCallbackUrl is set but gitlab.oauthClientId is empty"

# r14f validateGitLabOAuthTrio branch (iii): chartManaged secret supplied + id empty.
printf '%s\n    gitlabOauthClientSecret: "gls"\ngitlab:\n  baseUrl: "https://gitlab.example.com"\n' "$r14_base" > "$tmproot/r14f.yaml"
render -f "$tmproot/r14f.yaml"
assert_render_fails "r14f branch (iii) chartManaged secret supplied + id empty is rejected" \
  "a GitLab OAuth client secret is supplied"

# r14g validateGitLabOAuthTrio branch (iv): id set + baseUrl empty, with a COMPLETE
# trio (id + callback + secret all set) so ONLY branch (iv) matches — no ordering
# ambiguity (binding condition 3).
printf '%s\n    gitlabOauthClientSecret: "gls"\ngitlab:\n  oauthClientId: "cid"\n  oauthCallbackUrl: "https://app.example/v0/auth/gitlab/callback"\n' "$r14_base" > "$tmproot/r14g.yaml"
render -f "$tmproot/r14g.yaml"
assert_render_fails "r14g branch (iv) complete trio + baseUrl empty is rejected" \
  "gitlab.oauthClientId is set but gitlab.baseUrl is empty"
assert_render_fails "r14g branch (iv) names FISHHAWKD_GITLAB_BASE_URL as the missing host" "FISHHAWKD_GITLAB_BASE_URL"

# r14h chartManaged DERIVED requiredness: id set + client secret ABSENT (callback +
# baseUrl set so the trio guard is silent) surfaces validateSecretContract naming
# FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET — proving the derivation turned requiredness
# ON. Setting the record to required:false reddens this.
printf '%s\ngitlab:\n  baseUrl: "https://gitlab.example.com"\n  oauthClientId: "cid"\n  oauthCallbackUrl: "https://app.example/v0/auth/gitlab/callback"\n' "$r14_base" > "$tmproot/r14h.yaml"
render -f "$tmproot/r14h.yaml"
assert_render_fails "r14h chartManaged id set + client secret absent -> validateSecretContract (derived requiredness)" \
  "FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET"

# r14i externalSecrets analog of branch (iii): data[] maps
# FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET with gitlab.oauthClientId empty.
cat > "$tmproot/r14i.yaml" <<'YAML'
profile: prod
gitlab:
  baseUrl: "https://gitlab.example.com"
secrets:
  mode: externalSecrets
  githubApp:
    privateKeyFile:
      enabled: false
  externalSecrets:
    secretStoreRef:
      name: fishhawk-store
    data:
      - secretKey: FISHHAWKD_DATABASE_URL
        remoteRef: {key: fishhawk/db}
      - secretKey: FISHHAWKD_GITHUB_WEBHOOK_SECRET
        remoteRef: {key: fishhawk/webhook}
      - secretKey: FISHHAWKD_ANTHROPIC_API_KEY
        remoteRef: {key: fishhawk/anthropic}
      - secretKey: FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET
        remoteRef: {key: fishhawk/gitlab-oauth}
YAML
render -f "$tmproot/r14i.yaml"
assert_render_fails "r14i externalSecrets data[] maps the GitLab secret + id empty is rejected" \
  "a GitLab OAuth client secret is supplied"

# r14j THE EXPLICIT-NULL EDGE: gitlab.oauthClientId: null renders OK with no
# FISHHAWKD_GITLAB_OAUTH_CLIENT_ID key and no secret demanded. Deleting either
# `| default ""` (in fishhawk.secretKeySpec or fishhawk.validateGitLabOAuthTrio)
# reddens this — `toString nil` is "<nil>", which would read as GitLab-OAuth-ON.
cat > "$tmproot/r14j.yaml" <<'YAML'
profile: local
gitlab:
  oauthClientId: null
secrets:
  mode: chartManaged
  githubApp:
    privateKeyFile:
      enabled: false
  values:
    databaseUrl: "postgres://u:p@h:5432/d?sslmode=disable"
    githubWebhookSecret: "w"
    anthropicApiKey: "a"
YAML
render -f "$tmproot/r14j.yaml"
assert_render_ok "r14j explicit-null gitlab.oauthClientId is treated as OAuth-off and renders"
render -f "$tmproot/r14j.yaml" --show-only templates/configmap.yaml
assert_field_absent "r14j explicit-null gitlab.oauthClientId emits no FISHHAWKD_GITLAB_OAUTH_CLIENT_ID" "$out" "FISHHAWKD_GITLAB_OAUTH_CLIENT_ID"

# r14k a NON-required GitLab secret record still emits when supplied:
# gitlabToken/gitlabWebhookSecret with no OAuth config render into the chartManaged
# Secret. Proves secret.yaml's range emits on `supplied`, not on `required`.
printf '%s\n    gitlabToken: "glt"\n    gitlabWebhookSecret: "glw"\ngitlab:\n  baseUrl: "https://gitlab.example.com"\n' "$r14_base" > "$tmproot/r14k.yaml"
render -f "$tmproot/r14k.yaml" --show-only templates/secret.yaml
assert_render_ok "r14k non-required GitLab secrets render"
secretblk=$(yaml_block "$out" "stringData")
assert_contains "r14k Secret carries the supplied non-required FISHHAWKD_GITLAB_TOKEN" "$secretblk" '"FISHHAWKD_GITLAB_TOKEN": "glt"'
assert_contains "r14k Secret carries the supplied non-required FISHHAWKD_GITLAB_WEBHOOK_SECRET" "$secretblk" '"FISHHAWKD_GITLAB_WEBHOOK_SECRET": "glw"'

# r14l POSITIVE externalSecrets (binding condition 2): data[] carrying all three
# GitLab keys, with the GitLab OAuth trio complete, renders OK — proving the same
# machinery works in externalSecrets mode, not just chartManaged.
cat > "$tmproot/r14l.yaml" <<'YAML'
profile: prod
gitlab:
  baseUrl: "https://gitlab.example.com"
  oauthClientId: "gl-cid"
  oauthCallbackUrl: "https://app.example/v0/auth/gitlab/callback"
secrets:
  mode: externalSecrets
  githubApp:
    privateKeyFile:
      enabled: false
  externalSecrets:
    secretStoreRef:
      name: fishhawk-store
    data:
      - secretKey: FISHHAWKD_DATABASE_URL
        remoteRef: {key: fishhawk/db}
      - secretKey: FISHHAWKD_GITHUB_WEBHOOK_SECRET
        remoteRef: {key: fishhawk/webhook}
      - secretKey: FISHHAWKD_ANTHROPIC_API_KEY
        remoteRef: {key: fishhawk/anthropic}
      - secretKey: FISHHAWKD_GITLAB_TOKEN
        remoteRef: {key: fishhawk/gitlab-token}
      - secretKey: FISHHAWKD_GITLAB_WEBHOOK_SECRET
        remoteRef: {key: fishhawk/gitlab-webhook}
      - secretKey: FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET
        remoteRef: {key: fishhawk/gitlab-oauth}
YAML
render -f "$tmproot/r14l.yaml"
assert_render_ok "r14l positive externalSecrets: all three GitLab keys in data[] renders OK"
render -f "$tmproot/r14l.yaml" --show-only templates/externalsecret.yaml
assert_contains "r14l ExternalSecret maps FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET" "$out" "FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET"

# r14m POSITIVE existing-secret (binding condition 2): the GitLab OAuth trio
# complete in `existing` mode renders OK — the secret half is UNKNOWN at render
# time (the chart sees nothing about a pre-created Secret), so the trio guard's
# secret branch stays silent and the id/callback/baseUrl combination is what is
# checked. Proves the same machinery works in existing mode too.
cat > "$tmproot/r14m.yaml" <<'YAML'
profile: prod
gitlab:
  baseUrl: "https://gitlab.example.com"
  oauthClientId: "gl-cid"
  oauthCallbackUrl: "https://app.example/v0/auth/gitlab/callback"
secrets:
  mode: existing
existingSecret: fishhawk-secrets
YAML
render -f "$tmproot/r14m.yaml"
assert_render_ok "r14m positive existing-secret: complete GitLab trio renders OK"
render -f "$tmproot/r14m.yaml" --show-only templates/configmap.yaml
assert_contains "r14m existing-mode ConfigMap carries the GitLab OAuth client id" "$out" 'FISHHAWKD_GITLAB_OAUTH_CLIENT_ID: "gl-cid"'

# r14n externalSecrets DERIVED requiredness (binding condition 4): id set,
# FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET ABSENT from data[] (callback + baseUrl set so
# the trio guard is silent) surfaces validateSecretContract naming the missing key
# — the externalSecrets twin of r14h. externalSecrets is the mode a real operator
# is most likely to use, so it gets its own case.
cat > "$tmproot/r14n.yaml" <<'YAML'
profile: prod
gitlab:
  baseUrl: "https://gitlab.example.com"
  oauthClientId: "gl-cid"
  oauthCallbackUrl: "https://app.example/v0/auth/gitlab/callback"
secrets:
  mode: externalSecrets
  githubApp:
    privateKeyFile:
      enabled: false
  externalSecrets:
    secretStoreRef:
      name: fishhawk-store
    data:
      - secretKey: FISHHAWKD_DATABASE_URL
        remoteRef: {key: fishhawk/db}
      - secretKey: FISHHAWKD_GITHUB_WEBHOOK_SECRET
        remoteRef: {key: fishhawk/webhook}
      - secretKey: FISHHAWKD_ANTHROPIC_API_KEY
        remoteRef: {key: fishhawk/anthropic}
YAML
render -f "$tmproot/r14n.yaml"
assert_render_fails "r14n externalSecrets id set + client secret absent from data[] -> validateSecretContract" \
  "FISHHAWKD_GITLAB_OAUTH_CLIENT_SECRET"

# r14o helm lint the complete-GitLab fixture, so the additions are proven against
# the linter too.
if lint_out=$("$(command -v helm)" lint "$CHART" -f "$tmproot/r14b.yaml" 2>&1); then
  pass "r14o helm lint the complete-GitLab fixture"
else
  fail "r14o helm lint complete-GitLab fixture: $(printf '%s' "$lint_out" | tail -3)"
fi

echo
echo "scripts/test-helm-render: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ] || exit 1
