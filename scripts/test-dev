#!/usr/bin/env zsh
# Hermetic unit test for scripts/dev library helpers.
# Sources scripts/dev with DEV_LIB_ONLY=1 (dispatch suppressed) and asserts the
# MCP-activation signalling and cmd_reload wiring without starting the stack.
# Must be zsh: scripts/dev uses zsh-only features (typeset -A, subscript flags).
# Run by `scripts/test verify` (via _verify_gate_harnesses, #2455) and still
# runnable standalone. Not in CI: CI is ubuntu-latest and wiring it there means
# editing .github/workflows/**, which is human-authored by convention.
set -uo pipefail

REPO_ROOT="${0:A:h:h}"
PASS=0
FAIL=0

pass() { print "PASS: $1"; PASS=$(( PASS + 1 )) }
fail() { print "FAIL: $1"; FAIL=$(( FAIL + 1 )) }

# Source the library. scripts/dev enables `set -e`; turn it back off so the
# assertions below (which run commands expected to fail) don't abort the test.
DEV_LIB_ONLY=1 source "${REPO_ROOT}/scripts/dev"
set +e

# Sourcing scripts/dev sets the global REPO_ROOT to this repo. The #1917
# worktree/sweep fixtures below re-point REPO_ROOT (and cwd) at throwaway git
# repos to drive the git-backed helpers hermetically; capture the originals so
# each fixture block can restore them.
orig_repo_root="$REPO_ROOT"
orig_pwd="$PWD"

# 1. _signal_mcp_activation is now KIND-form (ADR-060 / #1922): one banner per
# kind (schema_major | shim_rebuilt | reconnect | auto_swap | none). Assert the
# shipped text of each, not mere helper presence.
out="$(_signal_mcp_activation schema_major)"
if print -r -- "$out" | grep -q 'schema MAJOR'; then
  pass "schema_major banner names the schema MAJOR bump"
else
  fail "schema_major banner should name the schema MAJOR bump (got: $out)"
fi

out="$(_signal_mcp_activation shim_rebuilt)"
if [[ "$out" == *fishhawk-mcp-shim* ]] && print -r -- "$out" | grep -q -- '/mcp'; then
  pass "shim_rebuilt banner names fishhawk-mcp-shim and /mcp"
else
  fail "shim_rebuilt banner should name fishhawk-mcp-shim and /mcp (got: $out)"
fi

out="$(_signal_mcp_activation reconnect)"
if [[ "$out" == *fishhawk-mcp* ]] && print -r -- "$out" | grep -qi reconnect \
   && print -r -- "$out" | grep -q 'ACTION REQUIRED'; then
  pass "reconnect banner keeps the ACTION REQUIRED fishhawk-mcp reconnect text"
else
  fail "reconnect banner should keep the ACTION REQUIRED fishhawk-mcp reconnect text (got: $out)"
fi

# auto_swap: a single line naming the EXPECTED swap + the GitSHA check that
# confirms or refutes it, and it must NOT carry the manual ACTION REQUIRED nag
# (the shim swaps automatically). Since #2831 it must also NOT assert the swap
# as an accomplished fact — scripts/dev cannot observe the harness-owned shim,
# so a false "no /mcp needed" is exactly the silent-stale trap this closes.
out="$(_signal_mcp_activation auto_swap)"
if print -r -- "$out" | grep -qi 'hot-swap' && print -r -- "$out" | grep -q 'GitSHA' \
   && ! print -r -- "$out" | grep -q 'ACTION REQUIRED'; then
  pass "auto_swap note names automatic swap + GitSHA and omits ACTION REQUIRED"
else
  fail "auto_swap note should name automatic swap + GitSHA and omit ACTION REQUIRED (got: $out)"
fi
if print -r -- "$out" | grep -q -- '/mcp' && print -r -- "$out" | grep -q -- '--status'; then
  pass "auto_swap note names the /mcp fallback and the --status diagnostic"
else
  fail "auto_swap note should name the /mcp fallback and --status (got: $out)"
fi
if ! print -r -- "$out" | grep -qi 'no /mcp needed'; then
  pass "auto_swap note does not claim the swap already happened"
else
  fail "auto_swap note must state the EXPECTATION, not the accomplished fact (got: $out)"
fi
if [[ "$(print -r -- "$out" | grep -c .)" == 1 ]]; then
  pass "auto_swap note is a single line"
else
  fail "auto_swap note should be a single line (got: $out)"
fi

# 2. Unchanged path (none): single explicit no-op line.
out="$(_signal_mcp_activation none)"
if [[ "$out" == *"no MCP reconnect needed"* ]]; then
  pass "none banner says 'no MCP reconnect needed'"
else
  fail "none banner should say 'no MCP reconnect needed' (got: $out)"
fi
# Unknown/absent kind degrades to the no-op line.
out="$(_signal_mcp_activation)"
if [[ "$out" == *"no MCP reconnect needed"* ]]; then
  pass "absent kind degrades to 'no MCP reconnect needed'"
else
  fail "absent kind should degrade to 'no MCP reconnect needed' (got: $out)"
fi

# 3. cmd_reload core behavior: invokes cmd_down then cmd_up, forwarding flags.
reload_body="$(typeset -f cmd_reload)"
if print -r -- "$reload_body" | grep -q cmd_down; then
  pass "cmd_reload invokes cmd_down"
else
  fail "cmd_reload should invoke cmd_down"
fi
if print -r -- "$reload_body" | grep -q cmd_up; then
  pass "cmd_reload invokes cmd_up"
else
  fail "cmd_reload should invoke cmd_up"
fi
if print -r -- "$reload_body" | grep -q '"\$@"'; then
  pass "cmd_reload forwards flags (\"\$@\") to cmd_up"
else
  fail "cmd_reload should forward \"\$@\" to cmd_up"
fi
# reload must force a full rebuild (--all) so the empty post-merge
# origin/main...HEAD diff doesn't silently skip runner/CLI/mcp.
if print -r -- "$reload_body" | grep -q -- '--all'; then
  pass "cmd_reload forces a full rebuild (--all)"
else
  fail "cmd_reload should force --all"
fi

# 3b. cmd_post_merge wiring: ff-only pull, cleanup-merged, optional issue check,
# then reload LAST. Body-grep only (mirrors section 3) — a live post-merge mutates
# git state and the running stack and is not hermetic.
post_body="$(typeset -f cmd_post_merge)"
if print -r -- "$post_body" | grep -q -- '--ff-only'; then
  pass "cmd_post_merge pulls main with --ff-only"
else
  fail "cmd_post_merge should pull --ff-only"
fi
if print -r -- "$post_body" | grep -q 'cleanup-merged'; then
  pass "cmd_post_merge invokes scripts/cleanup-merged"
else
  fail "cmd_post_merge should invoke cleanup-merged"
fi
if print -r -- "$post_body" | grep -q 'gh issue view'; then
  pass "cmd_post_merge confirms the optional issue via gh issue view"
else
  fail "cmd_post_merge should reference gh issue view"
fi
if print -r -- "$post_body" | grep -q 'cmd_reload'; then
  pass "cmd_post_merge composes cmd_reload"
else
  fail "cmd_post_merge should invoke cmd_reload"
fi

# 3c. _path_affects_build (#2403): the ONE doc-only carve-out shared by
# _detect_rebuild_set and both banner matchers. A path whose basename is exactly
# README.md cannot alter a built binary; everything else counts as
# build-affecting (fail-safe to over-notify). The embedded-asset rows are the
# guard that rules out a `*.md` blanket deny or a Go-source allow-list — each is
# //go:embed'ed and DOES change the binary.
for p in \
  backend/cmd/fishhawk-mcp-shim/README.md \
  backend/cmd/fishhawk-mcp/README.md \
  README.md
do
  if _path_affects_build "$p"; then
    fail "_path_affects_build should classify $p as doc-only"
  else
    pass "_path_affects_build: $p is doc-only"
  fi
done
for p in \
  backend/cmd/fishhawk-mcp-shim/main.go \
  backend/internal/mcpserver/runbook.md \
  backend/internal/spec/schemas/workflow-v2.schema.json \
  backend/internal/spec/presets/workflow-preset-low.yaml
do
  if _path_affects_build "$p"; then
    pass "_path_affects_build: $p is build-affecting"
  else
    fail "_path_affects_build should classify $p as build-affecting"
  fi
done

# 4. _diff_touches_mcp: pure matcher mirrors the rebuild matrix's mcp routing.
if _diff_touches_mcp "backend/cmd/fishhawk-mcp/main.go"; then
  pass "_diff_touches_mcp matches backend/cmd/fishhawk-mcp/"
else
  fail "_diff_touches_mcp should match backend/cmd/fishhawk-mcp/"
fi
if _diff_touches_mcp "backend/internal/plan/validate.go"; then
  pass "_diff_touches_mcp matches shared lib backend/internal/plan/"
else
  fail "_diff_touches_mcp should match backend/internal/plan/"
fi
if _diff_touches_mcp "backend/internal/spec/load.go"; then
  pass "_diff_touches_mcp matches shared lib backend/internal/spec/"
else
  fail "_diff_touches_mcp should match backend/internal/spec/"
fi
# #612 case: --all rebuilt mcp, but the merge delta touched only runner source.
if _diff_touches_mcp "runner/internal/plan/coerce.go"; then
  fail "_diff_touches_mcp should NOT match runner-only delta"
else
  pass "_diff_touches_mcp stays quiet for runner-only delta"
fi
# Cross-glob non-collision (ADR-060 / #1922): the mcp glob must NOT match a shim
# path — the literal `/` after `fishhawk-mcp` blocks the prefix.
if _diff_touches_mcp "backend/cmd/fishhawk-mcp-shim/main.go"; then
  fail "_diff_touches_mcp should NOT match a fishhawk-mcp-shim path"
else
  pass "_diff_touches_mcp stays quiet for a fishhawk-mcp-shim path (cross-glob non-collision)"
fi
# #2403: a README-only diff under an mcp trigger glob must NOT fire the banner —
# a README is not a `go build` input, so the binary is byte-identical.
if _diff_touches_mcp "backend/cmd/fishhawk-mcp/README.md"; then
  fail "_diff_touches_mcp should NOT match a README-only backend/cmd/fishhawk-mcp diff (#2403)"
else
  pass "_diff_touches_mcp stays quiet for a README-only backend/cmd/fishhawk-mcp diff (#2403)"
fi
if _diff_touches_mcp "backend/internal/mcpserver/README.md"; then
  fail "_diff_touches_mcp should NOT match a README-only backend/internal/mcpserver diff (#2403)"
else
  pass "_diff_touches_mcp stays quiet for a README-only backend/internal/mcpserver diff (#2403)"
fi
# The embedded-asset guard: these are //go:embed'ed (onboarding.go:47,
# parse.go:20, preset.go:18) and DO change the binary, so the carve-out must be
# a README deny-list — never a blanket `*.md` deny or a Go-source allow-list.
if _diff_touches_mcp "backend/internal/mcpserver/runbook.md"; then
  pass "_diff_touches_mcp still matches the //go:embed'ed runbook.md (#2403 false-negative guard)"
else
  fail "_diff_touches_mcp must still match backend/internal/mcpserver/runbook.md (it is //go:embed'ed)"
fi
if _diff_touches_mcp "backend/internal/spec/schemas/workflow-v2.schema.json"; then
  pass "_diff_touches_mcp still matches an //go:embed'ed schema (#2403 false-negative guard)"
else
  fail "_diff_touches_mcp must still match backend/internal/spec/schemas/workflow-v2.schema.json"
fi
if _diff_touches_mcp "backend/internal/spec/presets/workflow-preset-low.yaml"; then
  pass "_diff_touches_mcp still matches an //go:embed'ed preset (#2403 false-negative guard)"
else
  fail "_diff_touches_mcp must still match backend/internal/spec/presets/workflow-preset-low.yaml"
fi
# Non-vacuity: a doc line must never MASK a real source line in the same diff.
if _diff_touches_mcp "$(print -l 'backend/cmd/fishhawk-mcp/README.md' 'backend/cmd/fishhawk-mcp/main.go')"; then
  pass "_diff_touches_mcp still matches a mixed README + main.go diff (doc line masks nothing)"
else
  fail "_diff_touches_mcp should match a mixed README + main.go diff"
fi

# 4a. _diff_touches_shim: the shim's OWN trigger glob only — not the shared libs,
# and (cross-glob non-collision) not a plain fishhawk-mcp path.
if _diff_touches_shim "backend/cmd/fishhawk-mcp-shim/main.go"; then
  pass "_diff_touches_shim matches backend/cmd/fishhawk-mcp-shim/"
else
  fail "_diff_touches_shim should match backend/cmd/fishhawk-mcp-shim/"
fi
if _diff_touches_shim "backend/cmd/fishhawk-mcp/main.go"; then
  fail "_diff_touches_shim should NOT match a plain fishhawk-mcp path"
else
  pass "_diff_touches_shim stays quiet for a fishhawk-mcp path (cross-glob non-collision)"
fi
# The shim deliberately does NOT join the shared-lib case.
if _diff_touches_shim "backend/internal/plan/validate.go"; then
  fail "_diff_touches_shim should NOT match a shared-lib path"
else
  pass "_diff_touches_shim stays quiet for a shared-lib path (shim not in the shared-lib case)"
fi
# #2403, the REPORTED bug: PR #2397 edited only
# backend/cmd/fishhawk-mcp-shim/README.md and drew a spurious ACTION REQUIRED.
if _diff_touches_shim "backend/cmd/fishhawk-mcp-shim/README.md"; then
  fail "_diff_touches_shim should NOT match a README-only shim diff (#2403)"
else
  pass "_diff_touches_shim stays quiet for a README-only shim diff (#2403)"
fi
# Non-vacuity: a doc line must never MASK a real source line in the same diff.
if _diff_touches_shim "$(print -l 'backend/cmd/fishhawk-mcp-shim/README.md' 'backend/cmd/fishhawk-mcp-shim/main.go')"; then
  pass "_diff_touches_shim still matches a mixed README + main.go diff (doc line masks nothing)"
else
  fail "_diff_touches_shim should match a mixed README + main.go diff"
fi

# 4c. The extracted MCP tool library (E66.7 / #2408): an mcpserver-only change
# must fire the fishhawk-mcp banner (it feeds fishhawk-mcp) but NOT the shim.
if _diff_touches_mcp "backend/internal/mcpserver/tools.go"; then
  pass "_diff_touches_mcp matches backend/internal/mcpserver/ (E66.7 / #2408)"
else
  fail "_diff_touches_mcp should match backend/internal/mcpserver/"
fi
if _diff_touches_shim "backend/internal/mcpserver/tools.go"; then
  fail "_diff_touches_shim should NOT match a backend/internal/mcpserver path"
else
  pass "_diff_touches_shim stays quiet for a backend/internal/mcpserver path (cross-glob non-collision)"
fi

# 4b. _sha_with_dirty: pure dirty-suffix helper (#1007). Empty porcelain text
# means a clean tree -> bare sha; any output means dirty -> '-dirty' suffix.
out="$(_sha_with_dirty abc1234 "")"
if [[ "$out" == "abc1234" ]]; then
  pass "_sha_with_dirty leaves a clean-tree sha bare"
else
  fail "_sha_with_dirty should leave a clean-tree sha bare (got: $out)"
fi
out="$(_sha_with_dirty abc1234 " M scripts/dev")"
if [[ "$out" == "abc1234-dirty" ]]; then
  pass "_sha_with_dirty appends -dirty for non-empty porcelain"
else
  fail "_sha_with_dirty should append -dirty (got: $out)"
fi

# 4c. _build_ldflags: each binary stamps GitSHA into the right version package,
# AND that package actually declares `var GitSHA` — load-bearing: -ldflags -X
# on a package path without the var is a SILENT no-op, not a build error, so a
# package move/rename must fail here instead of shipping unstamped binaries.
typeset -A gitsha_pkg
gitsha_pkg=(
  fishhawkd         backend/internal/version
  fishhawk-mcp      backend/internal/version
  fishhawk-mcp-shim backend/internal/version
  fishhawk-runner   runner/internal/version
  fishhawk          cli/internal/version
)
for bin in fishhawkd fishhawk-mcp fishhawk-mcp-shim fishhawk-runner fishhawk; do
  rel="${gitsha_pkg[$bin]}"
  out="$(_build_ldflags "$bin" abc1234)"
  if [[ "$out" == "-X github.com/kuhlman-labs/fishhawk/${rel}.GitSHA=abc1234" ]]; then
    pass "_build_ldflags ${bin} -> ${rel}.GitSHA"
  else
    fail "_build_ldflags ${bin} should stamp ${rel}.GitSHA (got: $out)"
  fi
  if grep -q '^var GitSHA' "${REPO_ROOT}/${rel}/version.go"; then
    pass "${rel}/version.go declares var GitSHA (-X target exists)"
  else
    fail "${rel}/version.go should declare var GitSHA — the ${bin} -X stamp is a silent no-op without it"
  fi
done
if _build_ldflags no-such-binary abc1234 >/dev/null; then
  fail "_build_ldflags should return non-zero for an unknown binary name"
else
  pass "_build_ldflags rejects an unknown binary name"
fi

# 4d. Wiring body-greps: _build_binary must stamp via _build_ldflags, and the
# k8s image build must pass the sha through the GIT_SHA build arg.
bb_body="$(typeset -f _build_binary)"
if print -r -- "$bb_body" | grep -q '_build_ldflags'; then
  pass "_build_binary applies _build_ldflags to go build"
else
  fail "_build_binary should pass _build_ldflags output to go build"
fi
if print -r -- "$bb_body" | grep -q '_dev_git_sha'; then
  pass "_build_binary derives the sha via _dev_git_sha"
else
  fail "_build_binary should call _dev_git_sha"
fi
k8s_body="$(typeset -f cmd_k8s_up)"
if print -r -- "$k8s_body" | grep -q -- '--build-arg GIT_SHA'; then
  pass "cmd_k8s_up passes --build-arg GIT_SHA to docker build"
else
  fail "cmd_k8s_up should pass --build-arg GIT_SHA"
fi

# 5. _decide_mcp_signal: all three branches plus the reflog-unavailable fallback.
# Args: <mcp_rebuilt> <force_all> <reflog_ok> <merge_diff_text>
if [[ "$(_decide_mcp_signal 0 1 1 'backend/cmd/fishhawk-mcp/main.go')" == 0 ]]; then
  pass "_decide_mcp_signal: mcp not rebuilt -> 0"
else
  fail "_decide_mcp_signal: mcp not rebuilt should be 0"
fi
if [[ "$(_decide_mcp_signal 1 1 1 'backend/cmd/fishhawk-mcp/main.go')" == 1 ]]; then
  pass "_decide_mcp_signal: rebuilt + --all + diff touches mcp -> 1"
else
  fail "_decide_mcp_signal: rebuilt + --all + mcp delta should be 1"
fi
if [[ "$(_decide_mcp_signal 1 1 1 'runner/internal/plan/coerce.go')" == 0 ]]; then
  pass "_decide_mcp_signal: rebuilt + --all + diff misses mcp -> 0"
else
  fail "_decide_mcp_signal: rebuilt + --all + non-mcp delta should be 0"
fi
if [[ "$(_decide_mcp_signal 1 1 0 '')" == 1 ]]; then
  pass "_decide_mcp_signal: rebuilt + --all + no reflog -> 1 (fallback)"
else
  fail "_decide_mcp_signal: reflog-unavailable fallback should be 1"
fi
if [[ "$(_decide_mcp_signal 1 0 1 'runner/internal/plan/coerce.go')" == 1 ]]; then
  pass "_decide_mcp_signal: rebuilt under branch-diff up -> 1"
else
  fail "_decide_mcp_signal: branch-diff up rebuild should be 1"
fi

# 5b. Schema-MAJOR bump signal (#1422). The 5th arg forces the banner even when
# mcp was not rebuilt and even when the merge diff misses mcp source — the exact
# false-negative #1422 reported. A 0 (no major change) preserves every prior
# branch result.
if [[ "$(_decide_mcp_signal 0 0 1 'runner/internal/plan/coerce.go' 1)" == 1 ]]; then
  pass "_decide_mcp_signal: schema-major bump forces 1 even when mcp not rebuilt"
else
  fail "_decide_mcp_signal: schema-major bump should force 1 when mcp not rebuilt"
fi
if [[ "$(_decide_mcp_signal 1 1 1 'runner/internal/plan/coerce.go' 1)" == 1 ]]; then
  pass "_decide_mcp_signal: schema-major bump forces 1 even when --all diff misses mcp"
else
  fail "_decide_mcp_signal: schema-major bump should force 1 when diff misses mcp"
fi
if [[ "$(_decide_mcp_signal 0 1 1 'backend/cmd/fishhawk-mcp/main.go' 0)" == 0 ]]; then
  pass "_decide_mcp_signal: major-changed=0 preserves the mcp-not-rebuilt -> 0 branch"
else
  fail "_decide_mcp_signal: major-changed=0 should preserve mcp-not-rebuilt -> 0"
fi
if [[ "$(_decide_mcp_signal 1 1 1 'runner/internal/plan/coerce.go' 0)" == 0 ]]; then
  pass "_decide_mcp_signal: major-changed=0 preserves the --all diff-misses-mcp -> 0 branch"
else
  fail "_decide_mcp_signal: major-changed=0 should preserve --all diff-misses-mcp -> 0"
fi
# Default 5th arg (omitted) is treated as 0 — backward-compatible with old callers.
if [[ "$(_decide_mcp_signal 0 1 1 'backend/cmd/fishhawk-mcp/main.go')" == 0 ]]; then
  pass "_decide_mcp_signal: omitted 5th arg defaults to no-force (0)"
else
  fail "_decide_mcp_signal: omitted 5th arg should default to no-force"
fi

# 5c. _extract_workflow_version_major: pulls the integer major from a version line.
if [[ "$(_extract_workflow_version_major $'version: "0.7"\nworkflows: {}\n')" == 0 ]]; then
  pass "_extract_workflow_version_major: 0.7 -> 0"
else
  fail "_extract_workflow_version_major: 0.7 should yield 0"
fi
if [[ "$(_extract_workflow_version_major $'version: "1.0"\nworkflows: {}\n')" == 1 ]]; then
  pass "_extract_workflow_version_major: 1.0 -> 1"
else
  fail "_extract_workflow_version_major: 1.0 should yield 1"
fi
if [[ -z "$(_extract_workflow_version_major $'workflows: {}\n')" ]]; then
  pass "_extract_workflow_version_major: no version line -> empty"
else
  fail "_extract_workflow_version_major: missing version line should yield empty"
fi

# 5d. _workflow_major_changed: 1 on a major bump, 0 on same major / same minor.
if [[ "$(_workflow_major_changed $'version: "0.7"\n' $'version: "1.0"\n')" == 1 ]]; then
  pass "_workflow_major_changed: 0.7 -> 1.0 (major bump) -> 1"
else
  fail "_workflow_major_changed: 0.7 -> 1.0 should be 1"
fi
if [[ "$(_workflow_major_changed $'version: "0.3"\n' $'version: "0.7"\n')" == 0 ]]; then
  pass "_workflow_major_changed: 0.3 -> 0.7 (same major) -> 0"
else
  fail "_workflow_major_changed: 0.3 -> 0.7 should be 0"
fi
if [[ "$(_workflow_major_changed '' $'version: "1.0"\n')" == 1 ]]; then
  pass "_workflow_major_changed: one side empty (first spec) -> 1"
else
  fail "_workflow_major_changed: one-side-empty should be 1"
fi
if [[ "$(_workflow_major_changed '' '')" == 0 ]]; then
  pass "_workflow_major_changed: both empty -> 0"
else
  fail "_workflow_major_changed: both-empty should be 0"
fi

# 5e. _decide_shim_signal (ADR-060 / #1922): mirrors _decide_mcp_signal's ladder
# minus the schema-major fold. Args: <shim_rebuilt> <force_all> <reflog_ok> <merge_diff>
if [[ "$(_decide_shim_signal 0 1 1 'backend/cmd/fishhawk-mcp-shim/main.go')" == 0 ]]; then
  pass "_decide_shim_signal: shim not rebuilt -> 0"
else
  fail "_decide_shim_signal: shim not rebuilt should be 0"
fi
if [[ "$(_decide_shim_signal 1 1 1 'backend/cmd/fishhawk-mcp-shim/main.go')" == 1 ]]; then
  pass "_decide_shim_signal: rebuilt + --all + diff touches shim -> 1"
else
  fail "_decide_shim_signal: rebuilt + --all + shim delta should be 1"
fi
if [[ "$(_decide_shim_signal 1 1 1 'runner/internal/plan/coerce.go')" == 0 ]]; then
  pass "_decide_shim_signal: rebuilt + --all + diff misses shim -> 0"
else
  fail "_decide_shim_signal: rebuilt + --all + non-shim delta should be 0"
fi
if [[ "$(_decide_shim_signal 1 1 0 '')" == 1 ]]; then
  pass "_decide_shim_signal: rebuilt + --all + no reflog -> 1 (conservative fire)"
else
  fail "_decide_shim_signal: reflog-unavailable fallback should be 1"
fi
if [[ "$(_decide_shim_signal 1 0 1 'runner/internal/plan/coerce.go')" == 1 ]]; then
  pass "_decide_shim_signal: rebuilt under branch-diff up -> 1"
else
  fail "_decide_shim_signal: branch-diff up rebuild should be 1"
fi

# 5f. _shim_registered_from: override wins; empty override consults the text.
if [[ "$(_shim_registered_from 1 '')" == 1 ]]; then
  pass "_shim_registered_from: override 1 -> 1"
else
  fail "_shim_registered_from: override 1 should be 1"
fi
if [[ "$(_shim_registered_from 0 'fishhawk-mcp-shim')" == 0 ]]; then
  pass "_shim_registered_from: override 0 wins over matching text -> 0"
else
  fail "_shim_registered_from: override 0 should be 0"
fi
if [[ "$(_shim_registered_from '' 'command: /path/to/bin/fishhawk-mcp-shim')" == 1 ]]; then
  pass "_shim_registered_from: empty override + matching text -> 1"
else
  fail "_shim_registered_from: empty override + matching text should be 1"
fi
if [[ "$(_shim_registered_from '' 'command: /path/to/bin/fishhawk-mcp')" == 0 ]]; then
  pass "_shim_registered_from: empty override + non-matching text -> 0"
else
  fail "_shim_registered_from: empty override + non-matching text should be 0"
fi
# Empty override + empty text (absent/errored `claude mcp get`) degrades to 0 —
# the fail-safe direction that keeps the manual reconnect banner.
if [[ "$(_shim_registered_from '' '')" == 0 ]]; then
  pass "_shim_registered_from: empty override + empty text degrades to 0 (fail-safe)"
else
  fail "_shim_registered_from: empty override + empty text should degrade to 0"
fi

# 5g. _select_mcp_banner precedence (ADR-060 / #1922). Args:
# <schema_major> <shim_signal> <mcp_signal> <shim_registered>
if [[ "$(_select_mcp_banner 1 0 0 0)" == schema_major ]]; then
  pass "_select_mcp_banner: schema_major kind"
else
  fail "_select_mcp_banner: schema_major input should select schema_major"
fi
if [[ "$(_select_mcp_banner 0 1 0 0)" == shim_rebuilt ]]; then
  pass "_select_mcp_banner: shim_rebuilt kind"
else
  fail "_select_mcp_banner: shim signal should select shim_rebuilt"
fi
if [[ "$(_select_mcp_banner 0 0 1 0)" == reconnect ]]; then
  pass "_select_mcp_banner: reconnect kind (mcp signal, shim unregistered)"
else
  fail "_select_mcp_banner: mcp signal + unregistered shim should select reconnect"
fi
if [[ "$(_select_mcp_banner 0 0 1 1)" == auto_swap ]]; then
  pass "_select_mcp_banner: auto_swap kind (mcp signal, shim registered)"
else
  fail "_select_mcp_banner: mcp signal + registered shim should select auto_swap"
fi
if [[ "$(_select_mcp_banner 0 0 0 0)" == none ]]; then
  pass "_select_mcp_banner: none kind"
else
  fail "_select_mcp_banner: nothing-changed should select none"
fi
# Contested precedences: schema_major beats shim_rebuilt; shim_rebuilt beats auto_swap.
if [[ "$(_select_mcp_banner 1 1 1 1)" == schema_major ]]; then
  pass "_select_mcp_banner: schema_major beats shim_rebuilt"
else
  fail "_select_mcp_banner: schema_major should win over shim_rebuilt"
fi
if [[ "$(_select_mcp_banner 0 1 1 1)" == shim_rebuilt ]]; then
  pass "_select_mcp_banner: shim_rebuilt beats auto_swap"
else
  fail "_select_mcp_banner: shim_rebuilt should win over auto_swap"
fi

# 5g-bis. DONE-MEANS (#2403), end to end across all three layers: the predicate
# feeds _diff_touches_shim feeds _decide_shim_signal feeds _select_mcp_banner in
# one assertion. Args `1 1 1` = rebuilt under --all with a good reflog, exactly
# the observed `reload`/`post-merge` shape that produced the spurious banner on
# PR #2397. Doc-only merge diff -> the `none` banner, no ACTION REQUIRED.
shim_signal="$(_decide_shim_signal 1 1 1 'backend/cmd/fishhawk-mcp-shim/README.md')"
if [[ "$(_select_mcp_banner 0 "$shim_signal" 0 0)" == none ]]; then
  pass "done-means (#2403): a README-only shim diff selects the 'none' banner"
else
  fail "done-means (#2403): a README-only shim diff should select 'none' (got shim_signal=$shim_signal)"
fi
# Non-vacuity control for the case above: the SAME call shape with a real source
# line must still select shim_rebuilt, so `none` cannot pass by the pipeline
# being inert.
shim_signal="$(_decide_shim_signal 1 1 1 'backend/cmd/fishhawk-mcp-shim/main.go')"
if [[ "$(_select_mcp_banner 0 "$shim_signal" 0 0)" == shim_rebuilt ]]; then
  pass "done-means control (#2403): a main.go shim diff still selects 'shim_rebuilt'"
else
  fail "done-means control (#2403): a main.go shim diff should select 'shim_rebuilt' (got shim_signal=$shim_signal)"
fi

# 5h. _detect_rebuild_set wiring (ADR-060 / #1922): the shim carries its own
# trigger glob, and the shared-lib case must NOT short-circuit past the shim.
drs_body="$(typeset -f _detect_rebuild_set)"
if print -r -- "$drs_body" | grep -q 'backend/cmd/fishhawk-mcp-shim/\*'; then
  pass "_detect_rebuild_set carries the fishhawk-mcp-shim trigger glob"
else
  fail "_detect_rebuild_set should carry backend/cmd/fishhawk-mcp-shim/* glob"
fi

# 5h-bis. The extracted MCP tool library glob (E66.7 / #2408): _detect_rebuild_set
# must carry backend/internal/mcpserver/*, and — load-bearing — that arm must
# appear BEFORE the broad `backend/cmd/fishhawkd/*|backend/internal/*` arm. zsh
# `case` is first-match-wins: the broad arm marks only fishhawkd, so an mcpserver
# arm placed after it would never fire and an mcpserver edit would silently skip
# the fishhawk-mcp rebuild. No runtime test would notice; the ordering grep does.
if print -r -- "$drs_body" | grep -q 'backend/internal/mcpserver/\*'; then
  pass "_detect_rebuild_set carries the backend/internal/mcpserver/* glob"
else
  fail "_detect_rebuild_set should carry backend/internal/mcpserver/* glob"
fi
# NOTE: zsh `typeset -f` reprints a case pattern with spaces around `|`
# (`(backend/cmd/fishhawkd/* | backend/internal/*)`), so match each arm by a
# unique substring rather than the source-literal `a|b` form. `backend/cmd/fishhawkd/`
# appears only in the broad arm; `backend/internal/mcpserver/` only in the new one.
mcpserver_ln="$(print -r -- "$drs_body" | grep -n 'backend/internal/mcpserver/' | head -1 | cut -d: -f1)"
fishhawkd_ln="$(print -r -- "$drs_body" | grep -n 'backend/cmd/fishhawkd/' | head -1 | cut -d: -f1)"
if [[ -n "$mcpserver_ln" && -n "$fishhawkd_ln" && "$mcpserver_ln" -lt "$fishhawkd_ln" ]]; then
  pass "_detect_rebuild_set: mcpserver arm precedes the broad backend/internal/* arm (first-match-wins)"
else
  fail "_detect_rebuild_set: mcpserver arm (line ${mcpserver_ln:-none}) must precede the backend/internal/* arm (line ${fishhawkd_ln:-none})"
fi
# The shared-lib case must fall through (no early `return`) so a diff touching
# both a shared lib AND the shim still marks the shim. Behavioral proof: drive
# _detect_rebuild_set through a stubbed git that emits exactly that two-line diff.
# The subshell isolates the PATH git stub and rebuild_set; its EXIT STATUS carries
# the assertion result back to the parent so pass/fail is counted in the parent
# shell (a pass/fail inside the subshell would increment a copy of the counter
# that is discarded on subshell exit, making the assertion unable to turn the
# suite red).
if (
  set +e
  tmp_stub="$(mktemp -d)"
  cat > "${tmp_stub}/git" <<'STUB'
#!/usr/bin/env zsh
case "$*" in
  *rev-parse*) exit 0 ;;
  *diff*) print "backend/internal/plan/x.go"; print "backend/cmd/fishhawk-mcp-shim/main.go"; exit 0 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "${tmp_stub}/git"
  PATH="${tmp_stub}:$PATH"
  typeset -gA rebuild_set
  rebuild_set=()
  _detect_rebuild_set
  ok=0
  if [[ -z "${rebuild_set[fishhawk-mcp-shim]:-}" || -z "${rebuild_set[fishhawk-mcp]:-}" ]]; then
    print "  (mcp=${rebuild_set[fishhawk-mcp]:-unset} shim=${rebuild_set[fishhawk-mcp-shim]:-unset})"
    ok=1
  fi
  rm -rf "$tmp_stub"
  exit $ok
); then
  pass "_detect_rebuild_set: shared-lib + shim two-line diff marks BOTH (no early-return drop)"
else
  fail "_detect_rebuild_set: shared-lib + shim diff should mark the shim (see diagnostic above)"
fi

# 5h-ter (#2403): the THIRD carve-out site — this is what fixes the plain
# (branch-diff) `up`, where _decide_shim_signal/_decide_mcp_signal key the signal
# off rebuilt_list membership and never consult the matchers. A README-only diff
# must route to NO binary, while fishhawkd still rebuilds as the unconditional
# baseline. Same subshell-exit-status contract as the fixture above.
if (
  set +e
  tmp_stub="$(mktemp -d)"
  cat > "${tmp_stub}/git" <<'STUB'
#!/usr/bin/env zsh
case "$*" in
  *rev-parse*) exit 0 ;;
  *diff*) print "backend/cmd/fishhawk-mcp-shim/README.md"; exit 0 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "${tmp_stub}/git"
  PATH="${tmp_stub}:$PATH"
  typeset -gA rebuild_set
  rebuild_set=()
  _detect_rebuild_set
  ok=0
  if [[ -n "${rebuild_set[fishhawk-mcp-shim]:-}" || "${rebuild_set[fishhawkd]:-}" != "__baseline__" ]]; then
    print "  (shim=${rebuild_set[fishhawk-mcp-shim]:-unset} fishhawkd=${rebuild_set[fishhawkd]:-unset})"
    ok=1
  fi
  rm -rf "$tmp_stub"
  exit $ok
); then
  pass "_detect_rebuild_set: README-only diff marks no shim, fishhawkd stays __baseline__ (#2403)"
else
  fail "_detect_rebuild_set: README-only diff should leave the shim unmarked (see diagnostic above)"
fi

# Non-vacuity for the fixture above: a README + main.go two-line diff must STILL
# mark the shim — the per-line skip must not swallow a real source line.
if (
  set +e
  tmp_stub="$(mktemp -d)"
  cat > "${tmp_stub}/git" <<'STUB'
#!/usr/bin/env zsh
case "$*" in
  *rev-parse*) exit 0 ;;
  *diff*) print "backend/cmd/fishhawk-mcp-shim/README.md"; print "backend/cmd/fishhawk-mcp-shim/main.go"; exit 0 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "${tmp_stub}/git"
  PATH="${tmp_stub}:$PATH"
  typeset -gA rebuild_set
  rebuild_set=()
  _detect_rebuild_set
  ok=0
  if [[ "${rebuild_set[fishhawk-mcp-shim]:-}" != "backend/cmd/fishhawk-mcp-shim/main.go" ]]; then
    print "  (shim=${rebuild_set[fishhawk-mcp-shim]:-unset})"
    ok=1
  fi
  rm -rf "$tmp_stub"
  exit $ok
); then
  pass "_detect_rebuild_set: README + main.go diff still marks the shim (doc line masks nothing)"
else
  fail "_detect_rebuild_set: README + main.go diff should mark the shim (see diagnostic above)"
fi

# 5i. Build/banner wiring body-greps: _build_binary src_paths, cmd_up's forced
# --all set, the build loop, and cmd_up's banner-decision call sites all carry
# the shim.
if print -r -- "$bb_body" | grep -q 'fishhawk-mcp-shim'; then
  pass "_build_binary src_paths includes fishhawk-mcp-shim"
else
  fail "_build_binary src_paths should include fishhawk-mcp-shim"
fi
up_body_all="$(typeset -f cmd_up)"
if print -r -- "$up_body_all" | grep -q 'fishhawk-mcp-shim __all__'; then
  pass "cmd_up forced --all set includes fishhawk-mcp-shim"
else
  fail "cmd_up forced --all set should include fishhawk-mcp-shim __all__"
fi
if print -r -- "$up_body_all" | grep -q 'for binary in fishhawkd fishhawk-mcp fishhawk-mcp-shim'; then
  pass "cmd_up build loop iterates fishhawk-mcp-shim"
else
  fail "cmd_up build loop should iterate fishhawk-mcp-shim"
fi
if print -r -- "$up_body_all" | grep -q '_select_mcp_banner'; then
  pass "cmd_up consults _select_mcp_banner for the activation kind"
else
  fail "cmd_up should consult _select_mcp_banner"
fi
if print -r -- "$up_body_all" | grep -q '_detect_shim_registered'; then
  pass "cmd_up consults _detect_shim_registered"
else
  fail "cmd_up should consult _detect_shim_registered"
fi
if print -r -- "$up_body_all" | grep -q '_signal_mcp_activation "$mcp_banner_kind"'; then
  pass "cmd_up emits the selected banner kind as the last line"
else
  fail "cmd_up should call _signal_mcp_activation with the selected kind"
fi

# 7. _healthz_url: derives the port from FISHHAWKD_ADDR, default 8080.
unset FISHHAWKD_ADDR
if [[ "$(_healthz_url)" == "http://localhost:8080/healthz" ]]; then
  pass "_healthz_url defaults to port 8080 when FISHHAWKD_ADDR unset"
else
  fail "_healthz_url should default to 8080 (got: $(_healthz_url))"
fi
FISHHAWKD_ADDR=':9090'
if [[ "$(_healthz_url)" == "http://localhost:9090/healthz" ]]; then
  pass "_healthz_url respects ':9090' override"
else
  fail "_healthz_url should use port 9090 for ':9090' (got: $(_healthz_url))"
fi
FISHHAWKD_ADDR='127.0.0.1:9091'
if [[ "$(_healthz_url)" == "http://localhost:9091/healthz" ]]; then
  pass "_healthz_url respects '127.0.0.1:9091' override"
else
  fail "_healthz_url should use port 9091 for '127.0.0.1:9091' (got: $(_healthz_url))"
fi
unset FISHHAWKD_ADDR

# 7b. _k8s_image_ref / _k8s_healthz_url: pure k8s bring-up helpers, no cluster.
if [[ "$(_k8s_image_ref)" == "ghcr.io/kuhlman-labs/fishhawkd:dev-local" ]]; then
  pass "_k8s_image_ref returns the local dev-local image tag"
else
  fail "_k8s_image_ref should return ghcr.io/kuhlman-labs/fishhawkd:dev-local (got: $(_k8s_image_ref))"
fi
if [[ "$(_k8s_healthz_url)" == "http://localhost:8080/healthz" ]]; then
  pass "_k8s_healthz_url defaults to port 8080"
else
  fail "_k8s_healthz_url should default to 8080 (got: $(_k8s_healthz_url))"
fi
if [[ "$(_k8s_healthz_url 9090)" == "http://localhost:9090/healthz" ]]; then
  pass "_k8s_healthz_url respects an explicit forwarded port"
else
  fail "_k8s_healthz_url should honor port 9090 (got: $(_k8s_healthz_url 9090))"
fi

# 8. _await_healthz: returns non-zero quickly for an already-exited pid (the
# spawn-then-die early-exit path) without needing a live server.
( exit 0 ) &
dead_pid=$!
wait "$dead_pid" 2>/dev/null
if _await_healthz "$dead_pid" "http://localhost:1/healthz" 10; then
  fail "_await_healthz should return non-zero for an already-exited pid"
else
  pass "_await_healthz returns non-zero promptly for a dead pid"
fi

# 9. cmd_up readiness gate: body must poll _await_healthz, tail the log, and
# exit 1 on failure — mirroring the existing cmd_reload body-grep assertions.
up_body="$(typeset -f cmd_up)"
if print -r -- "$up_body" | grep -q '_await_healthz'; then
  pass "cmd_up gates the spawn on _await_healthz"
else
  fail "cmd_up should call _await_healthz after spawning fishhawkd"
fi
if print -r -- "$up_body" | grep -q 'tail -n 15'; then
  pass "cmd_up tails the log on a failed readiness gate"
else
  fail "cmd_up should tail the log on readiness-gate failure"
fi
if print -r -- "$up_body" | grep -q 'exit 1'; then
  pass "cmd_up exits non-zero on a failed readiness gate"
else
  fail "cmd_up should exit 1 on readiness-gate failure"
fi

# 9a. cmd_up serve launch re-enables the child-completion sweeper (#1238): the
# fan-in backstop is off by default in fishhawkd, so the local serve must pass
# --enable-child-completion-sweeper or a settled decomposed parent stays parked
# in awaiting_children with no consolidated branch/PR. Body-grep so a future
# edit that drops the flag fails here.
if print -r -- "$up_body" | grep -q -- '--enable-child-completion-sweeper'; then
  pass "cmd_up serve enables the child-completion sweeper (local fan-in backstop)"
else
  fail "cmd_up serve should pass --enable-child-completion-sweeper so local decompositions fan in"
fi

# 9b. cmd_k8s_up readiness gate: like cmd_up, the body must poll _await_healthz,
# tail the pod logs, and exit 1 on failure so a future edit can't silently drop
# the fail-loud guarantee of the Docker-Desktop bring-up.
k8s_up_body="$(typeset -f cmd_k8s_up)"
if print -r -- "$k8s_up_body" | grep -q '_await_healthz'; then
  pass "cmd_k8s_up gates the bring-up on _await_healthz"
else
  fail "cmd_k8s_up should call _await_healthz after the port-forward"
fi
if print -r -- "$k8s_up_body" | grep -q 'kubectl logs'; then
  pass "cmd_k8s_up tails pod logs on a failed readiness gate"
else
  fail "cmd_k8s_up should tail kubectl logs on readiness-gate failure"
fi
if print -r -- "$k8s_up_body" | grep -q 'exit 1'; then
  pass "cmd_k8s_up exits non-zero on a failed readiness gate"
else
  fail "cmd_k8s_up should exit 1 on readiness-gate failure"
fi
# The rollout leg must catch its own failure (`if ! kubectl rollout status`)
# rather than letting set -e abort before diagnostics run — otherwise a
# CrashLoopBackOff pod exits with no `kubectl logs` tail. Lock that guard so a
# future edit can't silently regress the rollout-failure leg of the contract.
if print -r -- "$k8s_up_body" | grep -q 'if ! kubectl rollout status'; then
  pass "cmd_k8s_up guards the rollout failure and tails diagnostics"
else
  fail "cmd_k8s_up should wrap kubectl rollout status in an 'if !' failure guard"
fi
# The jaeger trace-collector forward (dev-only) must be Service-guarded so a
# jaeger-disabled override is a clean skip, and its pid tracked in its own file
# so k8s-down can kill exactly that forward.
if print -r -- "$k8s_up_body" | grep -q 'kubectl get svc fishhawk-jaeger'; then
  pass "cmd_k8s_up guards the jaeger forward on the Service existing"
else
  fail "cmd_k8s_up should guard the jaeger port-forward on 'kubectl get svc fishhawk-jaeger'"
fi
if print -r -- "$k8s_up_body" | grep -q 'K8S_JAEGER_PF_PID_FILE'; then
  pass "cmd_k8s_up tracks the jaeger forward pid in K8S_JAEGER_PF_PID_FILE"
else
  fail "cmd_k8s_up should record the jaeger forward pid in K8S_JAEGER_PF_PID_FILE"
fi

# 9b-bis (#2913). The helm leg must catch its OWN failure. The minio
# bucket-bootstrap Job is a post-install/post-upgrade HOOK, so a nonexistent
# mcImage tag makes `helm upgrade` block until its --timeout and exit non-zero
# reporting only a timeout — with no named ImagePullBackOff. So cmd_k8s_up must
# wrap helm in an `if ! helm upgrade` guard that dumps hook pod state and exits 1,
# mirroring the rollout and /healthz legs. Body-greps first; deleting the guard
# reddens these.
if print -r -- "$k8s_up_body" | grep -q 'if ! helm upgrade'; then
  pass "cmd_k8s_up guards the helm upgrade failure with an 'if ! helm upgrade' branch"
else
  fail "cmd_k8s_up should wrap helm upgrade in an 'if ! helm upgrade' failure guard"
fi
if print -r -- "$k8s_up_body" | grep -q '_k8s_dump_hook_diagnostics'; then
  pass "cmd_k8s_up dumps hook pod state on a helm failure"
else
  fail "cmd_k8s_up should call _k8s_dump_hook_diagnostics on a helm failure"
fi

# 9b-ter. FUNCTIONAL test of _k8s_dump_hook_diagnostics against a FAKE kubectl on
# PATH. Fixture 1: a hook pod stuck in ImagePullBackOff on the exact nonexistent
# mc tag from #2913 — stderr must name BOTH ImagePullBackOff and the offending
# image. Same subshell-exit-status contract as the git-stub fixtures above (a
# pass/fail inside the subshell would increment a discarded counter copy).
if (
  set +e
  kstub="$(mktemp -d)"
  bad_img="minio/mc:RELEASE.2025-01-20T14-49-07Z"
  cat > "${kstub}/kubectl" <<STUB
#!/usr/bin/env zsh
case "\$*" in
  "get jobs"*)             print "NAME                     STATUS   COMPLETIONS"; print "fishhawk-minio-bucket    Running  0/1"; exit 0 ;;
  "get pods --no-headers") print "fishhawk-minio-bucket-abc   0/1   ImagePullBackOff   0   3m"; exit 0 ;;
  "get pods"*)             print "NAME                          READY   STATUS             RESTARTS   AGE"; print "fishhawk-minio-bucket-abc     0/1     ImagePullBackOff   0          3m"; exit 0 ;;
  "describe pod "*)        print "    State:          Waiting"; print "      Reason:       ImagePullBackOff"; print "    Image:          ${bad_img}"; exit 0 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "${kstub}/kubectl"
  PATH="${kstub}:$PATH"
  diag_err="$(_k8s_dump_hook_diagnostics 2>&1 1>/dev/null)"
  ok=0
  if ! print -r -- "$diag_err" | grep -q 'ImagePullBackOff'; then
    print "  (stderr did not name ImagePullBackOff: $diag_err)"; ok=1
  fi
  if ! print -r -- "$diag_err" | grep -qF -- "$bad_img"; then
    print "  (stderr did not name the offending image $bad_img: $diag_err)"; ok=1
  fi
  rm -rf "$kstub"
  exit $ok
); then
  pass "_k8s_dump_hook_diagnostics names ImagePullBackOff + the offending image for a stuck hook pod"
else
  fail "_k8s_dump_hook_diagnostics should name the pull failure and image (see diagnostic above)"
fi

# Fixture 2: all pods Running — the diagnostic must NOT invent a pull-failure line.
if (
  set +e
  kstub="$(mktemp -d)"
  cat > "${kstub}/kubectl" <<'STUB'
#!/usr/bin/env zsh
case "$*" in
  "get jobs"*)             print "NAME    STATUS    COMPLETIONS"; exit 0 ;;
  "get pods --no-headers") print "fishhawk-abc   1/1   Running   0   3m"; exit 0 ;;
  "get pods"*)             print "NAME           READY   STATUS    RESTARTS   AGE"; print "fishhawk-abc   1/1     Running   0          3m"; exit 0 ;;
  "describe pod "*)        print "    State:          Running"; exit 0 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "${kstub}/kubectl"
  PATH="${kstub}:$PATH"
  diag_err="$(_k8s_dump_hook_diagnostics 2>&1 1>/dev/null)"
  ok=0
  if print -r -- "$diag_err" | grep -q 'image pull failed'; then
    print "  (unexpected pull-failure line with all pods Running: $diag_err)"; ok=1
  fi
  rm -rf "$kstub"
  exit $ok
); then
  pass "_k8s_dump_hook_diagnostics names no pull failure when every pod is Running"
else
  fail "_k8s_dump_hook_diagnostics should not report a pull failure for healthy pods (see diagnostic above)"
fi

# Fixture 3 (#2913 coverage gap): a pod in CrashLoopBackOff (a NON-pull failure)
# whose `describe pod` itself EXITS 1 (empty output). Two properties: (a) the
# ImagePullBackOff/ErrImagePull grep must NOT match, so no 'image pull failed'
# line is invented for a non-pull failure; (b) the `|| true` guards keep the
# diagnostic from aborting under set -e even when describe fails.
if (
  set +e
  kstub="$(mktemp -d)"
  cat > "${kstub}/kubectl" <<'STUB'
#!/usr/bin/env zsh
case "$*" in
  "get jobs"*)             print "NAME                     STATUS    COMPLETIONS"; print "fishhawk-minio-bucket    Running   0/1"; exit 0 ;;
  "get pods --no-headers") print "fishhawk-minio-bucket-abc   0/1   CrashLoopBackOff   3   4m"; exit 0 ;;
  "get pods"*)             print "NAME                        READY   STATUS             RESTARTS   AGE"; print "fishhawk-minio-bucket-abc   0/1     CrashLoopBackOff   3          4m"; exit 0 ;;
  "describe pod "*)        exit 1 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "${kstub}/kubectl"
  PATH="${kstub}:$PATH"
  diag_err="$(_k8s_dump_hook_diagnostics 2>&1 1>/dev/null)"
  ok=0
  if print -r -- "$diag_err" | grep -q 'image pull failed'; then
    print "  (invented a pull-failure line for a CrashLoopBackOff pod: $diag_err)"; ok=1
  fi
  # No-abort under set -e even with a failing describe: the `|| true` guards must
  # keep the diagnostic returning 0 rather than tripping ERR_EXIT.
  if ! ( set -e; _k8s_dump_hook_diagnostics >/dev/null 2>&1 ); then
    print "  (_k8s_dump_hook_diagnostics aborted/failed under set -e with a failing describe)"; ok=1
  fi
  rm -rf "$kstub"
  exit $ok
); then
  pass "_k8s_dump_hook_diagnostics: CrashLoopBackOff + failing describe -> no pull line, no set -e abort"
else
  fail "_k8s_dump_hook_diagnostics should report no pull failure and not abort for CrashLoopBackOff / failing describe (see diagnostic above)"
fi

# 9b-quater (#2913). BEHAVIORAL test of cmd_k8s_up's helm-failure LEG (not just the
# 9b-bis body-greps that prove the guard is wired): a real cmd_k8s_up invocation
# with docker stubbed to succeed, helm stubbed to FAIL, and kubectl stubbed to the
# ImagePullBackOff hook-pod fixture must (a) name the helm failure, (b) drive the
# hook diagnostics (stderr carries ImagePullBackOff + the offending image), and
# (c) return non-zero. cmd_k8s_up's helm-fail branch runs before any port-forward
# or mkdir, so the stubbed run has no side effects on the real repo. Same
# subshell-exit-status contract as the fixtures above.
if (
  set +e
  kstub="$(mktemp -d)"
  bad_img="minio/mc:RELEASE.2025-01-20T14-49-07Z"
  print -r -- $'#!/usr/bin/env zsh\nexit 0' > "${kstub}/docker"   # docker build succeeds
  print -r -- $'#!/usr/bin/env zsh\nexit 1' > "${kstub}/helm"     # helm upgrade fails
  cat > "${kstub}/kubectl" <<STUB
#!/usr/bin/env zsh
case "\$*" in
  "get jobs"*)             print "NAME                     STATUS   COMPLETIONS"; print "fishhawk-minio-bucket    Running  0/1"; exit 0 ;;
  "get pods --no-headers") print "fishhawk-minio-bucket-abc   0/1   ImagePullBackOff   0   3m"; exit 0 ;;
  "get pods"*)             print "NAME                        READY   STATUS             RESTARTS   AGE"; print "fishhawk-minio-bucket-abc   0/1     ImagePullBackOff   0          3m"; exit 0 ;;
  "describe pod "*)        print "    State:          Waiting"; print "      Reason:       ImagePullBackOff"; print "    Image:          ${bad_img}"; exit 0 ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "${kstub}/docker" "${kstub}/helm" "${kstub}/kubectl"
  PATH="${kstub}:$PATH"
  k8s_err="$(cmd_k8s_up 2>&1 1>/dev/null)"
  k8s_rc=$?
  ok=0
  if (( k8s_rc == 0 )); then print "  (cmd_k8s_up returned 0 despite helm failing)"; ok=1; fi
  if ! print -r -- "$k8s_err" | grep -q 'helm upgrade --install fishhawk failed'; then
    print "  (stderr did not name the helm failure: $k8s_err)"; ok=1
  fi
  if ! print -r -- "$k8s_err" | grep -q 'ImagePullBackOff'; then
    print "  (diagnostics did not run — no ImagePullBackOff in stderr: $k8s_err)"; ok=1
  fi
  if ! print -r -- "$k8s_err" | grep -qF -- "$bad_img"; then
    print "  (diagnostics did not name the offending image: $k8s_err)"; ok=1
  fi
  rm -rf "$kstub"
  exit $ok
); then
  pass "cmd_k8s_up: a failing helm names the failure, invokes hook diagnostics (ImagePullBackOff + image), and returns non-zero"
else
  fail "cmd_k8s_up should name the helm failure, invoke diagnostics, and fail non-zero when helm fails (see diagnostic above)"
fi

# 9c. cmd_k8s_down teardown: a genuine helm error must not be swallowed and
# misreported as 'nothing to uninstall'. Only an absent release ('not found')
# is a no-op; any other failure exits non-zero.
k8s_down_body="$(typeset -f cmd_k8s_down)"
if print -r -- "$k8s_down_body" | grep -q 'not found'; then
  pass "cmd_k8s_down treats an absent release ('not found') as a no-op"
else
  fail "cmd_k8s_down should special-case the 'not found' release"
fi
if print -r -- "$k8s_down_body" | grep -q 'exit 1'; then
  pass "cmd_k8s_down exits non-zero on a genuine helm uninstall failure"
else
  fail "cmd_k8s_down should exit 1 on a non-'not found' helm error"
fi
# The jaeger forward (when present) must be torn down alongside the fishhawkd one.
if print -r -- "$k8s_down_body" | grep -q 'K8S_JAEGER_PF_PID_FILE'; then
  pass "cmd_k8s_down kills the tracked jaeger port-forward"
else
  fail "cmd_k8s_down should kill the jaeger forward via K8S_JAEGER_PF_PID_FILE"
fi

# 10. ZERR diagnostic trap (#631): installed, reports the ERROR-SITE file:line
# (not the trap's own body line), propagates the exit code, and the hardening
# can't silently regress.
if (( ${+functions[TRAPZERR]} )); then
  pass "TRAPZERR diagnostic trap is installed"
else
  fail "TRAPZERR should be defined/installed as the ZERR trap"
fi
# Sourcing scripts/dev installed TRAPZERR into THIS test process; neutralize it
# here so its stderr doesn't pollute the test's own output (the assertions below
# intentionally drive a fixture subprocess that exits non-zero, and the harness
# itself exits non-zero on failure). The fixture re-sources scripts/dev, so it
# exercises the real trap in isolation.
unfunction TRAPZERR 2>/dev/null
trap - ZERR

# Error-site precision: a fixture that fails on a KNOWN line (line 5) must be
# named by the diagnostic. Sources the real scripts/dev so the actual TRAPZERR
# fires; funcfiletrace[1] must point at the fixture's failing line, not the trap
# body's line inside scripts/dev.
zerr_fixture="$(mktemp -t test-dev-zerr.XXXXXX)"
cat > "$zerr_fixture" <<EOF
#!/usr/bin/env zsh
set -euo pipefail
DEV_LIB_ONLY=1 source "${REPO_ROOT}/scripts/dev"
true
( exit 7 )
EOF
zerr_out="$(zsh "$zerr_fixture" 2>&1 1>/dev/null)"
zerr_rc=$?
rm -f "$zerr_fixture"
if (( zerr_rc == 7 )); then
  pass "ZERR abort propagates the failing exit code (7), never zero-output exit 0"
else
  fail "fixture should exit 7 under set -e (got rc=$zerr_rc)"
fi
if [[ "$zerr_out" == *"exit 7"* ]]; then
  pass "TRAPZERR reports the failing command's exit code (exit 7)"
else
  fail "TRAPZERR should report 'exit 7' (got: $zerr_out)"
fi
if [[ "$zerr_out" == *line* ]]; then
  pass "TRAPZERR diagnostic includes 'line'"
else
  fail "TRAPZERR diagnostic should include 'line' (got: $zerr_out)"
fi
if [[ "$zerr_out" == *:5* ]]; then
  pass "TRAPZERR names the error-site line (fixture line 5)"
else
  fail "TRAPZERR should name the failing line :5 (got: $zerr_out)"
fi
if [[ "$zerr_out" == */scripts/dev:* ]]; then
  fail "TRAPZERR named scripts/dev — should report the error site, not its own trap line (got: $zerr_out)"
else
  pass "TRAPZERR reports the error site, not the trap's internal scripts/dev line"
fi

# Hardening guard: no fragile `]] && <var>=` assignment-RHS pattern may remain in
# scripts/dev — that bare-&&-in-a-non-tested-context form is the ERR_EXIT hazard
# this change removed, and it must not silently creep back.
if grep -nE '\]\] &&[[:space:]]+[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?=' "${REPO_ROOT}/scripts/dev"; then
  fail "scripts/dev still has a fragile ']] && var=' assignment (ERR_EXIT hazard)"
else
  pass "no fragile ']] && var=' assignment remains in scripts/dev"
fi

# The confirmed #631 trigger: `(( i++ ))` returns exit 1 when i==0 (post-increment
# yields the old value, and (( 0 )) is false), aborting the loop body under set -e.
# Guard that no post-increment arithmetic counter survives in scripts/dev.
if grep -nE '\(\([[:space:]]*[A-Za-z_][A-Za-z0-9_]*\+\+[[:space:]]*\)\)' "${REPO_ROOT}/scripts/dev"; then
  fail "scripts/dev still has a '(( var++ ))' post-increment (set -e abort at var==0, #631)"
else
  pass "no fragile '(( var++ ))' post-increment remains in scripts/dev"
fi

# The replacement `(( ++i ))` counter loop is ERR_EXIT-safe from i==0: the body
# must run and the loop complete without aborting under set -e.
if ( set -e; i=0; while (( i < 2 )); do (( ++i )); done; print "$i" ) >/dev/null 2>&1; then
  pass "'(( ++i ))' counter loop from i==0 does not abort under set -e"
else
  fail "'(( ++i ))' counter loop aborted under set -e (the #631 regression)"
fi

# The rewritten `if [[ false-cond ]]; then var=1; fi` form is ERR_EXIT-safe: a
# false condition must NOT abort under set -e (the `[[ ]]` is the if-condition, a
# tested context). zsh's ERR_EXIT-vs-`&&` interaction is subtle and version-
# dependent — the explicit if-form removes that ambiguity entirely, which is the
# point of the hardening.
if ( set -e; v=0; if [[ 1 == 2 ]]; then v=1; fi; print "$v" ) >/dev/null 2>&1; then
  pass "rewritten 'if [[ false ]]; then var=1; fi' does not abort under set -e"
else
  fail "rewritten if-form aborted under set -e (a false condition should be safe)"
fi

# 11. _healthz_port: the shared port derivation up's gate/preflight and down's
# port fallback consume — default 8080 plus the same FISHHAWKD_ADDR override
# matrix _healthz_url has.
unset FISHHAWKD_ADDR
if [[ "$(_healthz_port)" == "8080" ]]; then
  pass "_healthz_port defaults to 8080 when FISHHAWKD_ADDR unset"
else
  fail "_healthz_port should default to 8080 (got: $(_healthz_port))"
fi
FISHHAWKD_ADDR=':9090'
if [[ "$(_healthz_port)" == "9090" ]]; then
  pass "_healthz_port respects ':9090' override"
else
  fail "_healthz_port should yield 9090 for ':9090' (got: $(_healthz_port))"
fi
FISHHAWKD_ADDR='127.0.0.1:9091'
if [[ "$(_healthz_port)" == "9091" ]]; then
  pass "_healthz_port respects '127.0.0.1:9091' override"
else
  fail "_healthz_port should yield 9091 for '127.0.0.1:9091' (got: $(_healthz_port))"
fi
unset FISHHAWKD_ADDR

# 12. _clean_stray_pid_files: tempdir fixture — only the numbered 'dev N.pid'
# strays (#965 shapes) are removed, never dev.pid itself.
stray_dir="$(mktemp -d -t test-dev-strays.XXXXXX)"
touch "$stray_dir/dev.pid" "$stray_dir/dev 2.pid" "$stray_dir/dev 3.pid"
sweep_out="$(_clean_stray_pid_files "$stray_dir")"
if [[ -f "$stray_dir/dev.pid" ]]; then
  pass "_clean_stray_pid_files preserves dev.pid"
else
  fail "_clean_stray_pid_files must never remove dev.pid"
fi
if [[ ! -f "$stray_dir/dev 2.pid" && ! -f "$stray_dir/dev 3.pid" ]]; then
  pass "_clean_stray_pid_files removes the numbered strays"
else
  fail "_clean_stray_pid_files should remove 'dev 2.pid' and 'dev 3.pid'"
fi
if [[ "$sweep_out" == *"dev 2.pid"* && "$sweep_out" == *"dev 3.pid"* ]]; then
  pass "_clean_stray_pid_files prints a notice per removal"
else
  fail "_clean_stray_pid_files should print a notice naming each removed stray (got: $sweep_out)"
fi

# 12b. _clean_stray_nonce_files: tempdir fixture — only the numbered
# 'dev N.nonce' strays (#1623, macOS/iCloud duplicate-name shapes) are
# removed, never the canonical dev.nonce, whose removal cmd_down defers until
# after _down_port_fallback proves listener ownership (#1018).
touch "$stray_dir/dev.nonce" "$stray_dir/dev 2.nonce" "$stray_dir/dev 3.nonce"
nonce_sweep_out="$(_clean_stray_nonce_files "$stray_dir")"
if [[ -f "$stray_dir/dev.nonce" ]]; then
  pass "_clean_stray_nonce_files preserves dev.nonce"
else
  fail "_clean_stray_nonce_files must never remove dev.nonce"
fi
if [[ ! -f "$stray_dir/dev 2.nonce" && ! -f "$stray_dir/dev 3.nonce" ]]; then
  pass "_clean_stray_nonce_files removes the numbered strays"
else
  fail "_clean_stray_nonce_files should remove 'dev 2.nonce' and 'dev 3.nonce'"
fi
if [[ "$nonce_sweep_out" == *"dev 2.nonce"* && "$nonce_sweep_out" == *"dev 3.nonce"* ]]; then
  pass "_clean_stray_nonce_files prints a notice per removal"
else
  fail "_clean_stray_nonce_files should print a notice naming each removed stray (got: $nonce_sweep_out)"
fi

# 13. Listener-identity contract (#965), driven behaviorally with a REAL
# squatter: an `nc -l` background listener on a random high port. lsof only
# inspects (never connects), so nc stays listening for the section's duration.
squat_port=""
for _try in 1 2 3 4 5; do
  cand=$(( 20000 + (RANDOM % 20000) ))
  if [[ -z "$(_port_listeners "$cand")" ]]; then squat_port="$cand"; break; fi
done
free_port=""
for _try in 1 2 3 4 5; do
  cand=$(( 40001 + (RANDOM % 20000) ))
  if [[ "$cand" != "$squat_port" && -z "$(_port_listeners "$cand")" ]]; then free_port="$cand"; break; fi
done
if [[ -z "$squat_port" || -z "$free_port" ]]; then
  fail "could not find two free high ports for the squatter fixture"
else
  nc -l 127.0.0.1 "$squat_port" >/dev/null 2>&1 &
  nc_pid=$!
  # Wait for the bind (up to ~2s); the assertions below fail if nc never binds.
  i=0
  while (( i < 20 )); do
    if [[ -n "$(_port_listeners "$squat_port")" ]]; then break; fi
    sleep 0.1
    (( ++i ))
  done

  if [[ "$(_port_listeners "$squat_port")" == *"$nc_pid"* ]]; then
    pass "_port_listeners finds the nc squatter pid on its port"
  else
    fail "_port_listeners should print the nc pid ${nc_pid} for port ${squat_port} (got: $(_port_listeners "$squat_port"))"
  fi
  if [[ -z "$(_port_listeners "$free_port")" ]]; then
    pass "_port_listeners prints nothing for a free port"
  else
    fail "_port_listeners should be empty for free port ${free_port} (got: $(_port_listeners "$free_port"))"
  fi

  # Expected-pid mismatch: the function must return non-zero, name the actual
  # squatter pid AND the expected pid, and tail the log (the bind-error line).
  squat_log="$(mktemp -t test-dev-squatlog.XXXXXX)"
  print "bind: address already in use (fixture marker)" > "$squat_log"
  vout="$(_verify_listener_identity "$$" "$squat_port" "$squat_log" 2>&1)"
  vrc=$?
  if (( vrc != 0 )); then
    pass "_verify_listener_identity returns non-zero on an expected-pid mismatch"
  else
    fail "_verify_listener_identity should return non-zero when the listener is not the expected pid"
  fi
  if [[ "$vout" == *"$nc_pid"* ]]; then
    pass "_verify_listener_identity diagnostic names the actual squatter pid"
  else
    fail "_verify_listener_identity should name squatter pid ${nc_pid} (got: $vout)"
  fi
  if [[ "$vout" == *"expected pid $$"* ]]; then
    pass "_verify_listener_identity diagnostic names the expected pid"
  else
    fail "_verify_listener_identity should name expected pid $$ (got: $vout)"
  fi
  if [[ "$vout" == *"address already in use"* ]]; then
    pass "_verify_listener_identity tails the log on mismatch"
  else
    fail "_verify_listener_identity should emit the log tail (got: $vout)"
  fi

  # Matching pid: the squatter itself as the expected pid must pass.
  if _verify_listener_identity "$nc_pid" "$squat_port" "$squat_log" >/dev/null 2>&1; then
    pass "_verify_listener_identity returns 0 when the listener IS the expected pid"
  else
    fail "_verify_listener_identity should return 0 for the matching pid ${nc_pid}"
  fi

  # cmd_down port-fallback refuse-success leg: a non-fishhawkd listener (nc) is
  # reported, never killed, and the function returns non-zero.
  dout="$(_down_port_fallback "$squat_port" "$stray_dir/unused.pid" 2>&1)"
  drc=$?
  if (( drc != 0 )); then
    pass "_down_port_fallback refuses success for a non-fishhawkd squatter"
  else
    fail "_down_port_fallback should return non-zero when a foreign process holds the port"
  fi
  if [[ "$dout" == *"$nc_pid"* ]]; then
    pass "_down_port_fallback names the foreign squatter pid"
  else
    fail "_down_port_fallback should name pid ${nc_pid} (got: $dout)"
  fi
  if kill -0 "$nc_pid" 2>/dev/null; then
    pass "_down_port_fallback did not kill the non-fishhawkd listener"
  else
    fail "_down_port_fallback must never kill a non-fishhawkd process"
  fi
  if _down_port_fallback "$free_port" "$stray_dir/unused.pid" >/dev/null 2>&1; then
    pass "_down_port_fallback returns 0 for a free port"
  else
    fail "_down_port_fallback should return 0 when the port is free"
  fi

  kill "$nc_pid" 2>/dev/null
  wait "$nc_pid" 2>/dev/null
  rm -f "$squat_log"
fi
rm -rf "$stray_dir"

# 13b. Call-site wiring (#965) — body-greps only; the control flow itself is
# behaviorally covered above. cmd_up must run the pre-spawn preflight
# (_port_listeners) and the post-gate identity check; cmd_down must compose
# _down_port_fallback and keep the refuse-success exit; both sweep strays.
if print -r -- "$up_body" | grep -q '_port_listeners'; then
  pass "cmd_up runs the pre-spawn port preflight (_port_listeners)"
else
  fail "cmd_up should preflight the port via _port_listeners before spawning"
fi
if print -r -- "$up_body" | grep -q '_verify_listener_identity'; then
  pass "cmd_up runs the post-gate listener-identity check"
else
  fail "cmd_up should call _verify_listener_identity after _await_healthz"
fi
if print -r -- "$up_body" | grep -q '_clean_stray_pid_files'; then
  pass "cmd_up sweeps stray pid files"
else
  fail "cmd_up should call _clean_stray_pid_files"
fi
if print -r -- "$up_body" | grep -q '_clean_stray_nonce_files'; then
  pass "cmd_up sweeps stray nonce files"
else
  fail "cmd_up should call _clean_stray_nonce_files"
fi
down_body="$(typeset -f cmd_down)"
if print -r -- "$down_body" | grep -q '_down_port_fallback'; then
  pass "cmd_down composes the port fallback (_down_port_fallback)"
else
  fail "cmd_down should call _down_port_fallback"
fi
if print -r -- "$down_body" | grep -q 'exit 1'; then
  pass "cmd_down exits non-zero when the port fallback refuses success"
else
  fail "cmd_down should exit 1 on a refused port fallback"
fi
if print -r -- "$down_body" | grep -q '_clean_stray_pid_files'; then
  pass "cmd_down sweeps stray pid files"
else
  fail "cmd_down should call _clean_stray_pid_files"
fi
if print -r -- "$down_body" | grep -q '_clean_stray_nonce_files'; then
  pass "cmd_down sweeps stray nonce files"
else
  fail "cmd_down should call _clean_stray_nonce_files"
fi
# lsof-missing degraded mode: the identity layer must guard on `command -v
# lsof` (warn-and-degrade, never a broken up/down on a host without it).
if grep -q 'command -v lsof' "${REPO_ROOT}/scripts/dev"; then
  pass "scripts/dev guards the lsof-based checks on 'command -v lsof'"
else
  fail "scripts/dev should guard lsof usage with 'command -v lsof'"
fi

# 14. Start-nonce listener identity (#1018) — pure helpers.
nonce1="$(_generate_start_nonce)"
nonce2="$(_generate_start_nonce)"
if [[ -n "$nonce1" ]]; then
  pass "_generate_start_nonce emits a non-empty nonce"
else
  fail "_generate_start_nonce should emit a non-empty nonce"
fi
if print -r -- "$nonce1" | grep -qE '^[0-9a-f]+$'; then
  pass "_generate_start_nonce emits hex-only output"
else
  fail "_generate_start_nonce should be hex-only (got: $nonce1)"
fi
if [[ "$nonce1" != "$nonce2" ]]; then
  pass "_generate_start_nonce differs across calls"
else
  fail "_generate_start_nonce should differ across calls (got twice: $nonce1)"
fi

# _nonce_from_healthz_body: the compact Go-marshaled body shape (no whitespace
# around the colon — the exact bytes TestHandleHealth_StartNonce pins on the
# backend side of the seam), the field-absent case, and a full healthz body.
if [[ "$(_nonce_from_healthz_body '{"status":"ok","start_nonce":"cafe1234"}')" == "cafe1234" ]]; then
  pass "_nonce_from_healthz_body extracts the nonce from a compact body"
else
  fail "_nonce_from_healthz_body should extract cafe1234 (got: $(_nonce_from_healthz_body '{"status":"ok","start_nonce":"cafe1234"}'))"
fi
full_body='{"status":"ok","version":"dev","git_sha":"unknown","min_runner_version":"dev","schemas":{"plan-standard-v1":"abc","workflow-v0":"def"},"start_nonce":"feedbeef"}'
if [[ "$(_nonce_from_healthz_body "$full_body")" == "feedbeef" ]]; then
  pass "_nonce_from_healthz_body extracts the nonce from a full healthz body"
else
  fail "_nonce_from_healthz_body should extract feedbeef (got: $(_nonce_from_healthz_body "$full_body"))"
fi
if [[ -z "$(_nonce_from_healthz_body '{"status":"ok","version":"dev"}')" ]]; then
  pass "_nonce_from_healthz_body prints nothing when the field is absent"
else
  fail "_nonce_from_healthz_body should print nothing for a nonce-less body (got: $(_nonce_from_healthz_body '{"status":"ok","version":"dev"}'))"
fi

# 14b. _verify_healthz_nonce against a REAL curl + one-shot fake responder.
# macOS/BSD nc without -k serves exactly one connection then exits, so each
# assertion gets its own responder instance (same fixture family as section 13).
_find_free_port() {
  local cand
  for _try in 1 2 3 4 5; do
    cand=$(( 20000 + (RANDOM % 40000) ))
    if [[ -z "$(_port_listeners "$cand")" ]]; then print "$cand"; return 0; fi
  done
  return 1
}
# Serve one canned HTTP 200 with <body> on <port>; sets responder_pid. Waits
# for the bind (up to ~2s) so the caller's curl can't race the listener.
_serve_healthz_once() {
  local port="$1"
  local body="$2"
  printf 'HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' "${#body}" "$body" | nc -l 127.0.0.1 "$port" >/dev/null 2>&1 &
  responder_pid=$!
  local i=0
  while (( i < 20 )); do
    if [[ -n "$(_port_listeners "$port")" ]]; then break; fi
    sleep 0.1
    (( ++i ))
  done
}

nonce_log="$(mktemp -t test-dev-noncelog.XXXXXX)"
print "bind: address already in use (nonce fixture marker)" > "$nonce_log"

# Mismatch: responder echoes 'aaaa', we expect 'bbbb' → rc=1 and a #628-shaped
# diagnostic naming BOTH nonces plus the log tail.
np="$(_find_free_port)"
if [[ -z "$np" ]]; then
  fail "could not find a free port for the nonce-mismatch responder"
else
  _serve_healthz_once "$np" '{"status":"ok","start_nonce":"aaaa"}'
  nvout="$(_verify_healthz_nonce "http://localhost:${np}/healthz" "bbbb" "$nonce_log" 2>&1)"
  nvrc=$?
  if (( nvrc == 1 )); then
    pass "_verify_healthz_nonce returns 1 on a nonce mismatch"
  else
    fail "_verify_healthz_nonce should return 1 on mismatch (got rc=$nvrc)"
  fi
  if [[ "$nvout" == *aaaa* && "$nvout" == *bbbb* ]]; then
    pass "_verify_healthz_nonce diagnostic names both the actual and expected nonce"
  else
    fail "_verify_healthz_nonce diagnostic should name aaaa and bbbb (got: $nvout)"
  fi
  if [[ "$nvout" == *"address already in use"* ]]; then
    pass "_verify_healthz_nonce tails the log on mismatch"
  else
    fail "_verify_healthz_nonce should emit the log tail (got: $nvout)"
  fi
  wait "$responder_pid" 2>/dev/null
fi

# Degraded path: a body WITHOUT start_nonce (pre-#1018 binary) → rc=2, so
# cmd_up falls back to the #965 pid identity check instead of failing.
np="$(_find_free_port)"
if [[ -z "$np" ]]; then
  fail "could not find a free port for the nonce-less responder"
else
  _serve_healthz_once "$np" '{"status":"ok","version":"dev"}'
  _verify_healthz_nonce "http://localhost:${np}/healthz" "bbbb" "$nonce_log" >/dev/null 2>&1
  nvrc=$?
  if (( nvrc == 2 )); then
    pass "_verify_healthz_nonce returns 2 when the body carries no start_nonce"
  else
    fail "_verify_healthz_nonce should return 2 for a nonce-less body (got rc=$nvrc)"
  fi
  wait "$responder_pid" 2>/dev/null
fi

# 14c. _down_port_fallback nonce ladder (#1018 / approval amendment): the nonce
# only UPGRADES confidence, never blocks the #965 path.
nonce_dir="$(mktemp -d -t test-dev-nonce.XXXXXX)"
print "bbbb" > "$nonce_dir/dev.nonce"

# No start_nonce in the body while our nonce file exists → must DEGRADE to the
# comm-basename heuristic (which reports/refuses the foreign listener), not a
# nonce-specific refuse leg.
np="$(_find_free_port)"
if [[ -z "$np" ]]; then
  fail "could not find a free port for the degraded down-fallback responder"
else
  _serve_healthz_once "$np" '{"status":"ok","version":"dev"}'
  dnout="$(_down_port_fallback "$np" "$nonce_dir/unused.pid" "$nonce_dir/dev.nonce" 2>&1)"
  dnrc=$?
  if (( dnrc != 0 )); then
    pass "_down_port_fallback (no start_nonce in body) refuses success via the comm route"
  else
    fail "_down_port_fallback should return non-zero for a nonce-less foreign listener (got rc=$dnrc)"
  fi
  if [[ "$dnout" == *"not fishhawkd"* ]]; then
    pass "_down_port_fallback (no start_nonce in body) takes the comm-heuristic route"
  else
    fail "_down_port_fallback should report via the comm heuristic ('not fishhawkd') (got: $dnout)"
  fi
  wait "$responder_pid" 2>/dev/null
fi

# Exact nonce match → proven ours: the kill leg is taken with nonce-verified
# provenance (the one-shot responder has already exited by then, so the TERM
# is a no-op — the assertion is on the route, not the kill outcome).
np="$(_find_free_port)"
if [[ -z "$np" ]]; then
  fail "could not find a free port for the nonce-match down-fallback responder"
else
  _serve_healthz_once "$np" '{"status":"ok","start_nonce":"bbbb"}'
  dnout="$(_down_port_fallback "$np" "$nonce_dir/unused.pid" "$nonce_dir/dev.nonce" 2>&1)"
  dnrc=$?
  if (( dnrc == 0 )); then
    pass "_down_port_fallback (nonce match) reports a clean takedown"
  else
    fail "_down_port_fallback should return 0 on a nonce-verified takedown (got rc=$dnrc, out: $dnout)"
  fi
  if [[ "$dnout" == *"nonce-verified"* ]]; then
    pass "_down_port_fallback (nonce match) takes the nonce-verified kill leg"
  else
    fail "_down_port_fallback should report 'nonce-verified' on an exact match (got: $dnout)"
  fi
  wait "$responder_pid" 2>/dev/null
fi
rm -f "$nonce_log"
rm -rf "$nonce_dir"

# 14d. Call-site wiring (#1018) — body-greps in the section-13b style.
if print -r -- "$up_body" | grep -q '_generate_start_nonce'; then
  pass "cmd_up generates a per-spawn start nonce"
else
  fail "cmd_up should call _generate_start_nonce before the spawn"
fi
if print -r -- "$up_body" | grep -q '_verify_healthz_nonce'; then
  pass "cmd_up verifies the start_nonce round-trip"
else
  fail "cmd_up should call _verify_healthz_nonce after the readiness gate"
fi
await_line="$(print -r -- "$up_body" | grep -n '_await_healthz' | head -n 1 | cut -d: -f1)"
nonce_line="$(print -r -- "$up_body" | grep -n '_verify_healthz_nonce' | head -n 1 | cut -d: -f1)"
if [[ -n "$await_line" && -n "$nonce_line" ]] && (( await_line < nonce_line )); then
  pass "cmd_up runs _verify_healthz_nonce AFTER the _await_healthz gate"
else
  fail "cmd_up should order _await_healthz before _verify_healthz_nonce (await=$await_line nonce=$nonce_line)"
fi
if print -r -- "$up_body" | grep -q '_verify_listener_identity'; then
  pass "cmd_up retains the #965 pid-check fallback (_verify_listener_identity)"
else
  fail "cmd_up should keep _verify_listener_identity as the rc=2 degraded fallback"
fi
dpf_body="$(typeset -f _down_port_fallback)"
if print -r -- "$dpf_body" | grep -q '_nonce_from_healthz_body'; then
  pass "_down_port_fallback consults the nonce before comm matching"
else
  fail "_down_port_fallback should call _nonce_from_healthz_body"
fi
if print -r -- "$down_body" | grep -qE 'rm -f .*NONCE_FILE'; then
  pass "cmd_down removes the nonce file on teardown"
else
  fail "cmd_down should rm the NONCE_FILE"
fi

# 15. Acceptance preview (E31.18 / #1569) — pure DB derivation. The preview
# database name must be the base name with an `_preview` suffix and can NEVER
# equal the base name, so a preview start can never DROP the dev database.
base_db_url='postgres://fishhawk:fishhawk@localhost:5432/fishhawk?sslmode=disable'
out="$(_preview_db_name "$base_db_url")"
if [[ "$out" == "fishhawk_preview" ]]; then
  pass "_preview_db_name suffixes the database name with _preview"
else
  fail "_preview_db_name should yield fishhawk_preview (got: $out)"
fi
if [[ "$out" != "fishhawk" ]]; then
  pass "_preview_db_name never equals the base database name"
else
  fail "_preview_db_name must never equal the base name"
fi
out="$(_preview_db_name 'postgres://u:p@h:5432/mydb')"
if [[ "$out" == "mydb_preview" ]]; then
  pass "_preview_db_name handles a query-less URL"
else
  fail "_preview_db_name should yield mydb_preview for a query-less URL (got: $out)"
fi
if _preview_db_name 'postgres://u:p@h:5432' >/dev/null; then
  fail "_preview_db_name should return non-zero for a URL with no database name"
else
  pass "_preview_db_name rejects a URL with no database name"
fi
# _preview_db_url now swaps BOTH the database name AND the userinfo for the
# least-privilege role (E31.19 / #1577) — the credential handed to the untrusted
# branch binary must NOT be the operator's fishhawk:fishhawk superuser.
out="$(_preview_db_url "$base_db_url")"
if [[ "$out" == 'postgres://fishhawk_preview:fishhawk_preview@localhost:5432/fishhawk_preview?sslmode=disable' ]]; then
  pass "_preview_db_url swaps role+database and preserves the query string"
else
  fail "_preview_db_url should yield the least-privilege URL keeping ?sslmode (got: $out)"
fi
# Done-means behavioral assertion (#1577): the preview URL must NOT bear the
# operator's superuser credential.
if [[ "$out" != *'fishhawk:fishhawk@'* ]]; then
  pass "_preview_db_url does NOT carry the operator's fishhawk:fishhawk credential"
else
  fail "_preview_db_url leaked the operator credential into the branch-exec URL (got: $out)"
fi
out="$(_preview_db_url 'postgres://u:p@h:5432/mydb')"
if [[ "$out" == 'postgres://fishhawk_preview:fishhawk_preview@h:5432/mydb_preview' ]]; then
  pass "_preview_db_url handles a query-less URL"
else
  fail "_preview_db_url should yield .../mydb_preview with role creds (got: $out)"
fi
if _preview_db_url 'postgres://u:p@h:5432' >/dev/null; then
  fail "_preview_db_url should return non-zero for a URL with no database name"
else
  pass "_preview_db_url rejects a URL with no database name"
fi
# Role/password override knobs (default + FISHHAWK_PREVIEW_DB_* overrides).
if [[ "$(_preview_db_role)" == "fishhawk_preview" && "$(_preview_db_password)" == "fishhawk_preview" ]]; then
  pass "_preview_db_role/_preview_db_password default to fishhawk_preview"
else
  fail "_preview_db_role/_preview_db_password should default to fishhawk_preview"
fi
out="$(FISHHAWK_PREVIEW_DB_ROLE='pv_role' FISHHAWK_PREVIEW_DB_PASSWORD='pv_pw' _preview_db_url "$base_db_url")"
if [[ "$out" == 'postgres://pv_role:pv_pw@localhost:5432/fishhawk_preview?sslmode=disable' ]]; then
  pass "_preview_db_url honors the FISHHAWK_PREVIEW_DB_ROLE/PASSWORD overrides"
else
  fail "_preview_db_url should splice the role/password overrides (got: $out)"
fi
# _db_name_from_url: the shared bare-name parser (used for the dev DB too).
if [[ "$(_db_name_from_url "$base_db_url")" == "fishhawk" ]]; then
  pass "_db_name_from_url extracts the bare database name (query dropped)"
else
  fail "_db_name_from_url should yield fishhawk (got: $(_db_name_from_url "$base_db_url"))"
fi
if _db_name_from_url 'postgres://u:p@h:5432' >/dev/null; then
  fail "_db_name_from_url should return non-zero for a URL with no database name"
else
  pass "_db_name_from_url rejects a URL with no database name"
fi

# 15a. Preview address/port derivation: default localhost:8090 (distinct from
# the orchestrating 8080), FISHHAWK_PREVIEW_ADDR override honored.
unset FISHHAWK_PREVIEW_ADDR
if [[ "$(_preview_port)" == "8090" ]]; then
  pass "_preview_port defaults to 8090 when FISHHAWK_PREVIEW_ADDR unset"
else
  fail "_preview_port should default to 8090 (got: $(_preview_port))"
fi
if [[ "$(_preview_healthz_url)" == "http://localhost:8090/healthz" ]]; then
  pass "_preview_healthz_url defaults to port 8090"
else
  fail "_preview_healthz_url should default to 8090 (got: $(_preview_healthz_url))"
fi
FISHHAWK_PREVIEW_ADDR='localhost:9191'
if [[ "$(_preview_port)" == "9191" ]]; then
  pass "_preview_port respects the FISHHAWK_PREVIEW_ADDR override"
else
  fail "_preview_port should yield 9191 for 'localhost:9191' (got: $(_preview_port))"
fi
unset FISHHAWK_PREVIEW_ADDR

# 15b. _git_sha_from_healthz_body: compact Go-marshaled shape (same seam
# discipline as _nonce_from_healthz_body), and the field-absent case.
full_sha_body='{"status":"ok","version":"dev","git_sha":"abc1234","min_runner_version":"dev","start_nonce":"feedbeef"}'
if [[ "$(_git_sha_from_healthz_body "$full_sha_body")" == "abc1234" ]]; then
  pass "_git_sha_from_healthz_body extracts git_sha from a full healthz body"
else
  fail "_git_sha_from_healthz_body should extract abc1234 (got: $(_git_sha_from_healthz_body "$full_sha_body"))"
fi
if [[ -z "$(_git_sha_from_healthz_body '{"status":"ok","version":"dev"}')" ]]; then
  pass "_git_sha_from_healthz_body prints nothing when git_sha is absent"
else
  fail "_git_sha_from_healthz_body should print nothing for a sha-less body"
fi

# 15c. _await_preview_healthz behavior: the git_sha-gated readiness poll.
# Dead pid → prompt non-zero (spawn-then-die fails fast, mirroring section 8).
( exit 0 ) &
dead_pid=$!
wait "$dead_pid" 2>/dev/null
if _await_preview_healthz "$dead_pid" "http://localhost:1/healthz" "abc1234" 10; then
  fail "_await_preview_healthz should return non-zero for an already-exited pid"
else
  pass "_await_preview_healthz returns non-zero promptly for a dead pid"
fi
# Matching git_sha → 0 (one-shot responder; our own live pid stands in for the
# spawned daemon).
np="$(_find_free_port)"
if [[ -z "$np" ]]; then
  fail "could not find a free port for the preview-readiness responder"
else
  _serve_healthz_once "$np" '{"status":"ok","git_sha":"abc1234"}'
  if _await_preview_healthz "$$" "http://localhost:${np}/healthz" "abc1234" 5; then
    pass "_await_preview_healthz returns 0 when /healthz echoes the expected git_sha"
  else
    fail "_await_preview_healthz should verify a matching git_sha"
  fi
  wait "$responder_pid" 2>/dev/null
fi
# Mismatched git_sha → non-zero at deadline: serving is not enough, the
# listener must BE the expected build (identity-gated readiness).
np="$(_find_free_port)"
if [[ -z "$np" ]]; then
  fail "could not find a free port for the preview-mismatch responder"
else
  _serve_healthz_once "$np" '{"status":"ok","git_sha":"aaaa111"}'
  if _await_preview_healthz "$$" "http://localhost:${np}/healthz" "bbb2222" 1; then
    fail "_await_preview_healthz should NOT verify a mismatched git_sha"
  else
    pass "_await_preview_healthz returns non-zero for a wrong-identity listener"
  fi
  wait "$responder_pid" 2>/dev/null
fi

# 15d. _preview_kill_tracked: behavioral TERM leg + idempotent no-op paths
# (tempdir-parameterized like _clean_stray_pid_files); the KILL escalation leg
# is locked by body-grep below (a TERM-immune fixture would cost 5s per run).
pv_dir="$(mktemp -d -t test-dev-preview.XXXXXX)"
sleep 60 &
pv_pid=$!
print "$pv_pid" > "$pv_dir/preview.pid"
pv_out="$(_preview_kill_tracked "$pv_dir/preview.pid")"
if ! kill -0 "$pv_pid" 2>/dev/null; then
  pass "_preview_kill_tracked terminates the tracked pid"
else
  fail "_preview_kill_tracked should have killed pid ${pv_pid}"
  kill -KILL "$pv_pid" 2>/dev/null
fi
wait "$pv_pid" 2>/dev/null
if [[ ! -f "$pv_dir/preview.pid" ]]; then
  pass "_preview_kill_tracked removes the pid file"
else
  fail "_preview_kill_tracked should remove the pid file"
fi
if _preview_kill_tracked "$pv_dir/preview.pid" >/dev/null; then
  pass "_preview_kill_tracked is a clean no-op when no pid file exists"
else
  fail "_preview_kill_tracked should return 0 for a missing pid file"
fi
kt_body="$(typeset -f _preview_kill_tracked)"
if print -r -- "$kt_body" | grep -q 'kill -TERM' && print -r -- "$kt_body" | grep -q 'kill -KILL'; then
  pass "_preview_kill_tracked escalates TERM -> KILL"
else
  fail "_preview_kill_tracked should carry the TERM -> KILL ladder"
fi

# 15e. _preview_remove_worktree: an unregistered leftover directory is removed
# via the rm -rf fallback; a missing directory is a clean no-op.
mkdir -p "$pv_dir/wt"
touch "$pv_dir/wt/marker"
_preview_remove_worktree "$pv_dir/wt" >/dev/null 2>&1
if [[ ! -d "$pv_dir/wt" ]]; then
  pass "_preview_remove_worktree removes an unregistered leftover directory"
else
  fail "_preview_remove_worktree should remove the directory (fallback rm -rf)"
fi
if _preview_remove_worktree "$pv_dir/wt" >/dev/null 2>&1; then
  pass "_preview_remove_worktree is a clean no-op when the directory is absent"
else
  fail "_preview_remove_worktree should return 0 for a missing directory"
fi
rw_body="$(typeset -f _preview_remove_worktree)"
if print -r -- "$rw_body" | grep -q 'worktree remove --force'; then
  pass "_preview_remove_worktree uses git worktree remove --force"
else
  fail "_preview_remove_worktree should call git worktree remove --force"
fi
rm -rf "$pv_dir"

# 15f. cmd_preview wiring body-greps (section-13b style): detached worktree,
# GitSHA-stamped build, DB reset, git_sha-gated readiness, fail-loud contract.
preview_body="$(typeset -f cmd_preview)"
if print -r -- "$preview_body" | grep -q 'worktree add' && print -r -- "$preview_body" | grep -q -- '--detach'; then
  pass "cmd_preview checks out the merge candidate in a detached worktree"
else
  fail "cmd_preview should git worktree add --detach"
fi
if print -r -- "$preview_body" | grep -q '_build_ldflags'; then
  pass "cmd_preview stamps the preview build via _build_ldflags"
else
  fail "cmd_preview should stamp GitSHA via _build_ldflags"
fi
if print -r -- "$preview_body" | grep -q '_preview_db_reset'; then
  pass "cmd_preview resets the isolated preview database"
else
  fail "cmd_preview should call _preview_db_reset"
fi
if print -r -- "$preview_body" | grep -q '_await_preview_healthz'; then
  pass "cmd_preview gates readiness on the git_sha-verified healthz poll"
else
  fail "cmd_preview should call _await_preview_healthz"
fi
if print -r -- "$preview_body" | grep -q 'migrate up'; then
  pass "cmd_preview migrates the preview database with the preview binary"
else
  fail "cmd_preview should run migrate up against the preview database"
fi
if print -r -- "$preview_body" | grep -q 'tail -n 15'; then
  pass "cmd_preview tails the preview log on a failed readiness gate"
else
  fail "cmd_preview should tail the log on readiness-gate failure"
fi
if print -r -- "$preview_body" | grep -q 'exit 1'; then
  pass "cmd_preview exits non-zero on failure"
else
  fail "cmd_preview should exit 1 on failure"
fi
if print -r -- "$preview_body" | grep -q 'FISHHAWK_PREVIEW_SHA'; then
  pass "cmd_preview defaults its arg to \$FISHHAWK_PREVIEW_SHA (runner-hook bare invocation)"
else
  fail "cmd_preview should default to FISHHAWK_PREVIEW_SHA"
fi
# Fail-loud guard legs (body-greps; the parameterized helpers behind them are
# behaviorally covered above, and the DB-reset-failure teardown was validated
# live): empty ref, missing DB URL, unresolvable ref, port squatter, and
# teardown-on-failure (worktree removal on the post-worktree failure paths).
if print -r -- "$preview_body" | grep -q 'no SHA to preview'; then
  pass "cmd_preview dies loud when neither arg nor FISHHAWK_PREVIEW_SHA is set"
else
  fail "cmd_preview should _die on an empty ref"
fi
if print -r -- "$preview_body" | grep -q 'FISHHAWKD_DATABASE_URL is not set'; then
  pass "cmd_preview dies loud when FISHHAWKD_DATABASE_URL is unset"
else
  fail "cmd_preview should _die on a missing FISHHAWKD_DATABASE_URL"
fi
if print -r -- "$preview_body" | grep -q 'could not resolve'; then
  pass "cmd_preview dies loud on an unresolvable ref (after the direct-fetch retry)"
else
  fail "cmd_preview should _die when the ref resolves to no commit"
fi
if print -r -- "$preview_body" | grep -q '_down_port_fallback'; then
  pass "cmd_preview pre-empts a stale orphan via the port reclaim (_down_port_fallback)"
else
  fail "cmd_preview should compose _down_port_fallback for the preview-port preflight"
fi
if print -r -- "$preview_body" | grep -q "run 'scripts/dev preview-down'"; then
  pass "cmd_preview retains the foreign-case _die guidance ('run scripts/dev preview-down')"
else
  fail "cmd_preview should retain the foreign-holder _die message (binding condition 2)"
fi
if print -r -- "$preview_body" | grep -q '_preview_remove_worktree'; then
  pass "cmd_preview removes the preview worktree on its post-worktree failure paths"
else
  fail "cmd_preview should call _preview_remove_worktree on failure"
fi
db_reset_body="$(typeset -f _preview_db_reset)"
if print -r -- "$db_reset_body" | grep -q 'DROP DATABASE IF EXISTS' && print -r -- "$db_reset_body" | grep -q 'CREATE DATABASE'; then
  pass "_preview_db_reset DROP/CREATEs the preview database"
else
  fail "_preview_db_reset should DROP DATABASE IF EXISTS + CREATE DATABASE"
fi
# The preview DB is OWNED by the least-privilege role (#1577) so it can run
# migrate up in its own database (PG15+ public-schema ownership).
if print -r -- "$db_reset_body" | grep -q 'OWNER'; then
  pass "_preview_db_reset CREATEs the preview database OWNED by the preview role"
else
  fail "_preview_db_reset should carry the OWNER clause"
fi
if print -r -- "$db_reset_body" | grep -q 'docker exec fishhawk-postgres'; then
  pass "_preview_db_reset degrades to psql inside the compose container when the host has none"
else
  fail "_preview_db_reset should carry the docker-exec psql fallback"
fi

# 15i. _preview_role_setup body-greps (E31.19 / #1577): least-privilege role
# provisioning + dev-DB CONNECT denial. Pins the binding approval conditions.
role_setup_body="$(typeset -f _preview_role_setup)"
if print -r -- "$role_setup_body" | grep -q 'CREATE ROLE' \
   && print -r -- "$role_setup_body" | grep -q 'IF NOT EXISTS' \
   && print -r -- "$role_setup_body" | grep -q 'pg_roles'; then
  pass "_preview_role_setup guards CREATE ROLE with WHEN NOT EXISTS (idempotent)"
else
  fail "_preview_role_setup should CREATE ROLE only IF NOT EXISTS (pg_roles)"
fi
if print -r -- "$role_setup_body" | grep -q 'LOGIN'; then
  pass "_preview_role_setup creates a LOGIN role"
else
  fail "_preview_role_setup should create a LOGIN role"
fi
# Binding condition 1: normalize-always via an UNCONDITIONAL ALTER ROLE with the
# least-privilege NOSUPERUSER/NOCREATEROLE attributes, and NO granted SUPERUSER.
if print -r -- "$role_setup_body" | grep -q 'ALTER ROLE' \
   && print -r -- "$role_setup_body" | grep -q 'NOSUPERUSER' \
   && print -r -- "$role_setup_body" | grep -q 'NOCREATEROLE'; then
  pass "_preview_role_setup normalizes via ALTER ROLE … NOSUPERUSER NOCREATEROLE (binding condition 1)"
else
  fail "_preview_role_setup should ALTER ROLE … NOSUPERUSER NOCREATEROLE"
fi
if print -r -- "$role_setup_body" | grep -qE '[[:space:]]SUPERUSER'; then
  fail "_preview_role_setup must NOT grant SUPERUSER"
else
  pass "_preview_role_setup grants no SUPERUSER attribute"
fi
# Binding condition 2: REVOKE CONNECT from PUBLIC *and* explicitly from the role.
if print -r -- "$role_setup_body" | grep -q 'REVOKE CONNECT ON DATABASE' \
   && print -r -- "$role_setup_body" | grep -q 'FROM PUBLIC'; then
  pass "_preview_role_setup revokes CONNECT on the dev DB FROM PUBLIC"
else
  fail "_preview_role_setup should REVOKE CONNECT … FROM PUBLIC"
fi
if print -r -- "$role_setup_body" | grep -q 'FROM ${role}'; then
  pass "_preview_role_setup ALSO revokes CONNECT explicitly FROM the role (binding condition 2)"
else
  fail "_preview_role_setup should REVOKE CONNECT … FROM \${role} in addition to PUBLIC"
fi
if print -r -- "$role_setup_body" | grep -q 'docker exec fishhawk-postgres'; then
  pass "_preview_role_setup degrades to psql inside the compose container when the host has none"
else
  fail "_preview_role_setup should carry the docker-exec psql fallback"
fi

# 15j. cmd_preview wiring (#1577): role setup precedes db reset; both privileged
# ops use base_url (operator creds); the branch binary gets preview_url only.
if print -r -- "$preview_body" | grep -q '_preview_role_setup "$base_url"'; then
  pass "cmd_preview provisions the least-privilege role against base_url (operator creds)"
else
  fail "cmd_preview should call _preview_role_setup with base_url"
fi
if print -r -- "$preview_body" | grep -q '_preview_db_reset "$base_url"'; then
  pass "cmd_preview resets the preview DB against base_url (operator creds)"
else
  fail "cmd_preview should call _preview_db_reset with base_url"
fi
if print -r -- "$preview_body" | grep -q 'FISHHAWKD_DATABASE_URL=$preview_url'; then
  pass "cmd_preview hands the branch binary the least-privilege preview_url"
else
  fail "cmd_preview should exec migrate/serve with FISHHAWKD_DATABASE_URL=\$preview_url"
fi
# base_url (operator superuser creds) must NEVER be spliced into a branch-exec
# FISHHAWKD_DATABASE_URL — only the privileged role-setup/db-reset ops see it.
if print -r -- "$preview_body" | grep -q 'FISHHAWKD_DATABASE_URL=$base_url'; then
  fail "cmd_preview must NOT hand base_url to the branch binary"
else
  pass "cmd_preview never hands base_url to the branch binary"
fi
pd_body="$(typeset -f cmd_preview_down)"
if print -r -- "$pd_body" | grep -q '_preview_kill_tracked' && print -r -- "$pd_body" | grep -q '_down_port_fallback' && print -r -- "$pd_body" | grep -q '_preview_remove_worktree'; then
  pass "cmd_preview_down composes kill + port reclaim + worktree-removal"
else
  fail "cmd_preview_down should call _preview_kill_tracked, _down_port_fallback, and _preview_remove_worktree"
fi

# 15g. Preview-port reclaim (#1675) — behavioral, driving BOTH enumerated modes
# of the ownership heuristic through _down_port_fallback with NO nonce arg (the
# comm-basename route preview daemons take, since they are git_sha-gated, not
# nonce-stamped). This is exactly what cmd_preview_down and cmd_preview's
# preflight compose to reclaim an orphaned :8090 whose pid file is already gone.
if ! command -v nc &>/dev/null; then
  print "skip: nc not found — skipping preview-port reclaim behavioral tests"
else
  reclaim_dir="$(mktemp -d -t test-dev-reclaim.XXXXXX)"
  reclaim_bin="$(mktemp -d -t test-dev-reclaimbin.XXXXXX)"
  absent_pid="$reclaim_dir/preview.pid"   # deliberately never created (#1675)

  # -- Mode 1: reclaim KILL leg. A listener whose comm basename is 'fishhawkd'
  # (nc launched via a 'fishhawkd'-named path) holding a port with the pid file
  # ABSENT is the #1675 orphan; the reclaim must TERM→KILL it and free the
  # port. We SYMLINK rather than cp: copying a signed binary invalidates its
  # signature and macOS SIGKILLs the copy on exec (so the plan's literal cp
  # would always skip here), while exec-via-symlink keeps nc alive AND yields
  # comm=…/fishhawkd on both macOS and Linux. Guard still skips cleanly if even
  # the symlinked listener cannot bind as comm=fishhawkd.
  fhd_port=""
  for _try in 1 2 3 4 5; do
    cand=$(( 20000 + (RANDOM % 40000) ))
    if [[ -z "$(_port_listeners "$cand")" ]]; then fhd_port="$cand"; break; fi
  done
  fhd_bin="$reclaim_bin/fishhawkd"
  ln -s "$(command -v nc)" "$fhd_bin" 2>/dev/null || true
  fhd_pid=""
  if [[ -n "$fhd_port" && -x "$fhd_bin" ]]; then
    "$fhd_bin" -l 127.0.0.1 "$fhd_port" >/dev/null 2>&1 &
    fhd_pid=$!
    i=0
    while (( i < 20 )); do
      if [[ -n "$(_port_listeners "$fhd_port")" ]]; then break; fi
      sleep 0.1
      (( ++i ))
    done
  fi
  fhd_comm=""
  if [[ -n "$fhd_pid" ]]; then fhd_comm="$(ps -p "$fhd_pid" -o comm= 2>/dev/null)"; fi
  if [[ -z "$fhd_pid" ]] || ! kill -0 "$fhd_pid" 2>/dev/null \
     || [[ -z "$(_port_listeners "$fhd_port")" ]] || [[ "${fhd_comm:t}" != fishhawkd ]]; then
    print "skip: 'fishhawkd'-named nc copy could not bind as comm=fishhawkd — skipping the reclaim KILL-leg assertion"
    if [[ -n "$fhd_pid" ]]; then kill "$fhd_pid" 2>/dev/null; wait "$fhd_pid" 2>/dev/null; fi
  else
    rout="$(_down_port_fallback "$fhd_port" "$absent_pid" 2>&1)"
    rrc=$?
    if (( rrc == 0 )); then
      pass "reclaim returns 0 for a pid-file-absent fishhawkd orphan (#1675 done-means)"
    else
      fail "reclaim should return 0 after killing a stale fishhawkd orphan (got rc=$rrc, out: $rout)"
    fi
    if kill -0 "$fhd_pid" 2>/dev/null; then
      fail "reclaim should have TERM→KILLed the fishhawkd orphan pid ${fhd_pid}"
      kill -KILL "$fhd_pid" 2>/dev/null
    else
      pass "reclaim TERM→KILLs the pid-file-absent fishhawkd orphan"
    fi
    wait "$fhd_pid" 2>/dev/null
    if [[ -z "$(_port_listeners "$fhd_port")" ]]; then
      pass "reclaim frees the orphaned preview port"
    else
      fail "reclaim should free port ${fhd_port} (still held: $(_port_listeners "$fhd_port"))"
    fi
  fi

  # -- Mode 2: reclaim FOREIGN-safety leg (binding condition 1). A plain nc
  # listener (comm=nc) must be REPORTED and NOT killed, with the reclaim
  # returning non-zero so preview-down/preflight cannot falsely claim success.
  foreign_port=""
  for _try in 1 2 3 4 5; do
    cand=$(( 20000 + (RANDOM % 40000) ))
    if [[ "$cand" != "$fhd_port" && -z "$(_port_listeners "$cand")" ]]; then foreign_port="$cand"; break; fi
  done
  if [[ -z "$foreign_port" ]]; then
    fail "could not find a free port for the foreign-safety reclaim fixture"
  else
    nc -l 127.0.0.1 "$foreign_port" >/dev/null 2>&1 &
    foreign_pid=$!
    i=0
    while (( i < 20 )); do
      if [[ -n "$(_port_listeners "$foreign_port")" ]]; then break; fi
      sleep 0.1
      (( ++i ))
    done
    frout="$(_down_port_fallback "$foreign_port" "$absent_pid" 2>&1)"
    frrc=$?
    if (( frrc != 0 )); then
      pass "reclaim refuses success (rc!=0) for a foreign :8090 holder"
    else
      fail "reclaim should return non-zero for a non-fishhawkd listener (got rc=$frrc)"
    fi
    if [[ "$frout" == *"$foreign_pid"* ]]; then
      pass "reclaim reports the foreign holder's pid"
    else
      fail "reclaim should name the foreign pid ${foreign_pid} (got: $frout)"
    fi
    if kill -0 "$foreign_pid" 2>/dev/null; then
      pass "reclaim never kills the foreign (comm=nc) listener"
    else
      fail "reclaim must NOT kill a non-fishhawkd process (pid ${foreign_pid})"
    fi
    kill "$foreign_pid" 2>/dev/null
    wait "$foreign_pid" 2>/dev/null
  fi
  rm -rf "$reclaim_dir" "$reclaim_bin"
fi

# 15h. _preview_branch_env: the credential-stripped prefix that runs the
# UNTRUSTED merge-candidate binary (#1569 security fixup). It must be an
# `env -i` boundary (default-deny) and never forward a .env-sourced secret,
# while preserving PATH so the branch binary can still boot.
ANTHROPIC_API_KEY="leaked-model-key" FISHHAWK_GITHUB_TOKEN="leaked-gh-token" FISHHAWK_API_TOKEN="leaked-api-token" _preview_branch_env
if [[ "${reply[1]}" == "env" && "${reply[2]}" == "-i" ]]; then
  pass "_preview_branch_env clears the inherited env via env -i"
else
  fail "_preview_branch_env should start with 'env -i' (got: ${reply[1]} ${reply[2]})"
fi
if print -r -- "${reply[@]}" | grep -q 'leaked-'; then
  fail "_preview_branch_env leaked a secret into the branch-exec env: ${reply[*]}"
else
  pass "_preview_branch_env forwards no runner/.env secret to branch code"
fi
if print -r -- "${reply[@]}" | grep -q "PATH=${PATH}"; then
  pass "_preview_branch_env preserves PATH so the branch binary can boot"
else
  fail "_preview_branch_env should preserve PATH"
fi
if print -r -- "$preview_body" | grep -q '_preview_branch_env'; then
  pass "cmd_preview runs the branch binary through the credential-stripped _preview_branch_env"
else
  fail "cmd_preview should exec migrate up / serve via _preview_branch_env"
fi

# 15k. OPTIONAL live containment test (E31.19 / #1577) — gated on a host psql
# AND a reachable dev Postgres (skips cleanly like the 15g nc block otherwise).
# Drives BOTH enumerated failure modes end-to-end against a real Postgres:
#   mode 1 — the least-privilege preview role CAN connect to its throwaway
#            preview database and create an object (the PG15+ ownership path
#            `migrate up` relies on);
#   mode 2 — that same role CANNOT connect to the dev database (REVOKE CONNECT).
# The block provisions against a UNIQUE throwaway role/DB and RESTORES the dev
# DB's PUBLIC CONNECT grant + drops the role/DB on exit, so a test run leaves no
# durable dev-DB side effect.
if ! command -v psql &>/dev/null; then
  print "skip: psql not found — skipping the live preview-containment test"
elif ! psql "$base_db_url" -v ON_ERROR_STOP=1 -tAc 'SELECT 1' >/dev/null 2>&1; then
  print "skip: dev Postgres unreachable at the base URL — skipping the live preview-containment test"
else
  live_role="fishhawk_preview_selftest_$$"
  live_pw="selftest_pw"
  live_dev_db="$(_db_name_from_url "$base_db_url")"
  live_preview_db="${live_role}_db"
  live_base="${base_db_url%%\?*}"
  live_query=""
  if [[ "$base_db_url" == *\?* ]]; then live_query="?${base_db_url#*\?}"; fi
  live_rest="${live_base#*://}"
  live_authority="${live_rest%%/*}"
  live_hostport="${live_authority##*@}"
  live_scheme="${live_base%%://*}://"
  dev_as_role_url="${live_scheme}${live_role}:${live_pw}@${live_hostport}/${live_dev_db}${live_query}"
  preview_as_role_url="${live_scheme}${live_role}:${live_pw}@${live_hostport}/${live_preview_db}${live_query}"

  # Provision (revokes dev CONNECT) + create the throwaway preview DB owned by
  # the role. Reuses the exact functions under test.
  _preview_role_setup "$base_db_url" "$live_dev_db" "$live_role" "$live_pw" >/dev/null 2>&1
  _preview_db_reset "$base_db_url" "$live_preview_db" "$live_role" >/dev/null 2>&1

  # Mode 1: the preview role connects to its own DB and creates an object.
  if psql "$preview_as_role_url" -v ON_ERROR_STOP=1 -q \
       -c 'CREATE TABLE _fishhawk_selftest(id int)' -c 'DROP TABLE _fishhawk_selftest' >/dev/null 2>&1; then
    pass "live: preview role CAN connect to its preview DB and create objects (mode 1)"
  else
    fail "live: preview role should own its preview DB and run DDL (mode 1)"
  fi

  # Mode 2: the same role is REFUSED a connection to the dev database.
  if psql "$dev_as_role_url" -v ON_ERROR_STOP=1 -tAc 'SELECT 1' >/dev/null 2>&1; then
    fail "live: preview role must NOT be able to connect to the dev DB (mode 2)"
  else
    pass "live: preview role is REFUSED connection to the dev DB (mode 2)"
  fi

  # Cleanup: drop the throwaway DB + role, restore the dev DB PUBLIC CONNECT ACL.
  psql "$base_db_url" -q -c "DROP DATABASE IF EXISTS \"${live_preview_db}\" WITH (FORCE)" >/dev/null 2>&1
  psql "$base_db_url" -q -c "GRANT CONNECT ON DATABASE \"${live_dev_db}\" TO PUBLIC" >/dev/null 2>&1
  psql "$base_db_url" -q -c "DROP ROLE IF EXISTS ${live_role}" >/dev/null 2>&1
fi

# ── Stale operator-worktree warning + run-artifact litter sweep (#1917) ──────

# 16. _classify_worktree pure precedence table (dirty > detached > merged > active).
if [[ "$(_classify_worktree ' M f' 1 somebranch)" == dirty ]]; then
  pass "_classify_worktree: dirty wins over merged"
else
  fail "_classify_worktree: a dirty merged worktree should classify dirty (got: $(_classify_worktree ' M f' 1 somebranch))"
fi
if [[ "$(_classify_worktree '' 1 somebranch)" == merged ]]; then
  pass "_classify_worktree: clean merged-ancestor -> merged"
else
  fail "_classify_worktree: clean + is_merged should be merged"
fi
if [[ "$(_classify_worktree '' 0 somebranch)" == active ]]; then
  pass "_classify_worktree: clean unmerged -> active"
else
  fail "_classify_worktree: clean + unmerged should be active"
fi
if [[ "$(_classify_worktree '' 0 '')" == detached ]]; then
  pass "_classify_worktree: empty branch -> detached"
else
  fail "_classify_worktree: empty branch should be detached"
fi
if [[ "$(_classify_worktree ' M f' 0 '')" == dirty ]]; then
  pass "_classify_worktree: dirty wins even with an empty branch"
else
  fail "_classify_worktree: dirty should win regardless of branch"
fi

# 17. _scan_operator_worktrees + _warn_stale_worktrees against a real git repo.
# Fixture: a main checkout with an origin/main ref and four operator worktrees
# under .claude/worktrees — merged-clean, merged-but-dirty, unmerged, detached.
if command -v git >/dev/null 2>&1; then
  gitfix="$(mktemp -d -t test-dev-worktrees.XXXXXX)"
  (
    set -e
    cd "$gitfix"
    git init -q -b main main
    cd main
    git config user.email t@example.com
    git config user.name tester
    git config commit.gpgsign false
    echo a > f
    git add f
    git commit -qm base
    base_sha="$(git rev-parse HEAD)"
    git update-ref refs/remotes/origin/main "$base_sha"
    mkdir -p .claude/worktrees
    git branch merged-clean
    git worktree add -q .claude/worktrees/wt-merged merged-clean
    git branch merged-dirty
    git worktree add -q .claude/worktrees/wt-merged-dirty merged-dirty
    echo dirt >> .claude/worktrees/wt-merged-dirty/f
    git branch unmerged
    git worktree add -q .claude/worktrees/wt-unmerged unmerged
    ( cd .claude/worktrees/wt-unmerged && echo b > g && git add g && git commit -qm ahead )
    git worktree add -q --detach .claude/worktrees/wt-detached "$base_sha"
  )
  if [[ -d "$gitfix/main/.claude/worktrees/wt-merged" ]]; then
    scan_out="$(_scan_operator_worktrees "$gitfix/main/.claude/worktrees" refs/remotes/origin/main)"
    if print -r -- "$scan_out" | grep -qE "^merged"$'\t'".*/wt-merged$"; then
      pass "_scan_operator_worktrees: merged-clean worktree classifies merged"
    else
      fail "_scan: wt-merged should be merged (got: $scan_out)"
    fi
    if print -r -- "$scan_out" | grep -qE "^dirty"$'\t'".*/wt-merged-dirty$"; then
      pass "_scan_operator_worktrees: dirty merged worktree classifies dirty"
    else
      fail "_scan: wt-merged-dirty should be dirty (got: $scan_out)"
    fi
    if print -r -- "$scan_out" | grep -qE "^active"$'\t'".*/wt-unmerged$"; then
      pass "_scan_operator_worktrees: unmerged worktree classifies active"
    else
      fail "_scan: wt-unmerged should be active (got: $scan_out)"
    fi
    if print -r -- "$scan_out" | grep -qE "^detached"$'\t'".*/wt-detached$"; then
      pass "_scan_operator_worktrees: detached worktree classifies detached"
    else
      fail "_scan: wt-detached should be detached (got: $scan_out)"
    fi
    # _warn_stale_worktrees names ONLY the merged-clean path.
    REPO_ROOT="$gitfix/main"
    warn_out="$(_warn_stale_worktrees 2>&1)"
    REPO_ROOT="$orig_repo_root"
    if print -r -- "$warn_out" | grep -q "/wt-merged$"; then
      pass "_warn_stale_worktrees names the merged-clean worktree"
    else
      fail "_warn_stale_worktrees should name wt-merged (got: $warn_out)"
    fi
    if print -r -- "$warn_out" | grep -qE "wt-merged-dirty|wt-unmerged|wt-detached"; then
      fail "_warn_stale_worktrees should name ONLY merged-clean (got: $warn_out)"
    else
      pass "_warn_stale_worktrees excludes dirty/active/detached worktrees"
    fi
  else
    fail "git worktree fixture setup failed (no wt-merged)"
  fi
  rm -rf "$gitfix"

  # 17b. Degrade-to-silence: a missing .claude/worktrees dir and an unresolvable
  # origin/main both yield NO warning and exit 0 (cmd_up never aborts).
  silfix="$(mktemp -d -t test-dev-silent.XXXXXX)"
  ( set -e; cd "$silfix"; git init -q -b main main; cd main
    git config user.email t@e.com; git config user.name t; git config commit.gpgsign false
    echo a > f; git add f; git commit -qm base )
  REPO_ROOT="$silfix/main"
  # No .claude/worktrees dir at all -> silence, rc 0.
  sil_out="$(_warn_stale_worktrees 2>&1)"; sil_rc=$?
  REPO_ROOT="$orig_repo_root"
  if [[ -z "$sil_out" && "$sil_rc" == 0 ]]; then
    pass "_warn_stale_worktrees: missing .claude/worktrees degrades to silence (rc 0)"
  else
    fail "_warn_stale_worktrees should be silent+rc0 with no worktrees dir (out: $sil_out rc: $sil_rc)"
  fi
  # A worktrees dir present but origin/main unresolvable -> still silence, rc 0.
  ( set -e; cd "$silfix/main"; mkdir -p .claude/worktrees
    git branch feat; git worktree add -q .claude/worktrees/wt feat )
  REPO_ROOT="$silfix/main"
  sil2_out="$(_warn_stale_worktrees 2>&1)"; sil2_rc=$?
  REPO_ROOT="$orig_repo_root"
  if [[ -z "$sil2_out" && "$sil2_rc" == 0 ]]; then
    pass "_warn_stale_worktrees: unresolvable origin/main degrades to silence (rc 0)"
  else
    fail "_warn_stale_worktrees should be silent+rc0 when origin/main is unresolvable (out: $sil2_out rc: $sil2_rc)"
  fi
  rm -rf "$silfix"
else
  print "skip: git not found — skipping worktree scan/warn fixtures"
fi

# 18. _prune_aged_artifacts: age boundary, legacy fixed-slot protection, dry-run.
# Uses a throwaway git repo as REPO_ROOT so the git worktree remove/prune calls
# are hermetic, and drives the two litter roots against tempdir fixtures.
prune_repo="$(mktemp -d -t test-dev-prunerepo.XXXXXX)"
# A HEAD commit is required so `git worktree add --detach HEAD` can register the
# real run worktrees the fail-closed prune path exercises (#1917 review).
( cd "$prune_repo" && git init -q -b main && git config user.email t@e.com \
  && git config user.name t && git config commit.gpgsign false \
  && git commit -q --allow-empty -m base ) 2>/dev/null
# 8 days ago (older than the 7-day default); fall back to year 2000 if date(1)
# lacks the BSD -v flag.
old_stamp="$(date -v-8d +%Y%m%d%H%M 2>/dev/null || echo 200001010000)"

make_prune_fixture() {
  local base="$1"
  mkdir -p "$base/wt" "$base/tmp"
  # aged run worktree — a REAL registered, CLEAN worktree of prune_repo, so
  # git status succeeds and is empty -> removed (fail-closed: only a positively
  # clean worktree is a removal candidate). + aged runid file.
  git -C "$prune_repo" worktree add -q --detach "$base/wt/run-old" HEAD 2>/dev/null
  : > "$base/wt/run-old.runid"
  # aged DIRTY worktree — a real registered worktree with an uncommitted file,
  # so git status is non-empty -> SKIPPED by the dirty-worktree protection
  # (#1917 review: the protective branch now has a fixture).
  git -C "$prune_repo" worktree add -q --detach "$base/wt/run-dirty" HEAD 2>/dev/null
  : > "$base/wt/run-dirty/uncommitted"
  # aged BROKEN dir — a plain dir where git status errors; fail-closed leaves it
  # in place rather than rm -rf'ing possibly-uncommitted work (#1917 review).
  mkdir -p "$base/wt/run-broken"; : > "$base/wt/run-broken/marker"
  # fresh run worktree + runid (must survive the age gate).
  mkdir -p "$base/wt/run-fresh"; : > "$base/wt/run-fresh/marker"; : > "$base/wt/run-fresh.runid"
  # aged keyed /tmp sidecars (must be removed) + a fresh one (must survive).
  : > "$base/tmp/fishhawk-scope-run1-stage1.json"
  : > "$base/tmp/fishhawk-pr-run1-stage1.md"
  : > "$base/tmp/fishhawk-scope-fresh-x.json"
  # legacy fixed-slot transports (dash-keyed globs must NEVER match these).
  : > "$base/tmp/fishhawk-plan.json"
  : > "$base/tmp/fishhawk-pr.md"
  : > "$base/tmp/fishhawk-acceptance.json"
  # acceptance-evidence DIRECTORY (the plain-file (.) qualifier must skip it).
  mkdir -p "$base/tmp/fishhawk-acceptance-evidence-run1"
  # Age the "old" set; leave the fresh ones at now. Touch the run DIRS last so
  # creating files inside them does not reset the mtime the glob keys on.
  touch -t "$old_stamp" \
    "$base/tmp/fishhawk-scope-run1-stage1.json" "$base/tmp/fishhawk-pr-run1-stage1.md" \
    "$base/tmp/fishhawk-plan.json" "$base/tmp/fishhawk-pr.md" "$base/tmp/fishhawk-acceptance.json" \
    "$base/tmp/fishhawk-acceptance-evidence-run1" "$base/wt/run-old.runid"
  touch -t "$old_stamp" "$base/wt/run-old" "$base/wt/run-dirty" "$base/wt/run-broken"
}

prune_run="$(mktemp -d -t test-dev-prunerun.XXXXXX)"
make_prune_fixture "$prune_run"
REPO_ROOT="$prune_repo"
_prune_aged_artifacts 7 0 "$prune_run/wt" "$prune_run/tmp" >/dev/null 2>&1
REPO_ROOT="$orig_repo_root"
if [[ ! -d "$prune_run/wt/run-old" ]]; then pass "_prune: removes aged CLEAN run worktree dir"; else fail "_prune should remove the aged clean run-old worktree"; fi
if [[ ! -f "$prune_run/wt/run-old.runid" ]]; then pass "_prune: removes aged runid file"; else fail "_prune should remove aged run-old.runid"; fi
# Protective branch: an aged-but-DIRTY registered run worktree survives (#1917).
if [[ -d "$prune_run/wt/run-dirty" && -f "$prune_run/wt/run-dirty/uncommitted" ]]; then
  pass "_prune: keeps an aged DIRTY run worktree (uncommitted work protected)"
else
  fail "_prune must NOT remove an aged dirty run worktree"
fi
# Fail-closed branch: an aged dir whose git status FAILS survives (#1917) —
# never rm -rf'd when cleanliness cannot be positively established.
if [[ -d "$prune_run/wt/run-broken" && -f "$prune_run/wt/run-broken/marker" ]]; then
  pass "_prune: keeps an aged run dir whose cleanliness is unverifiable (fail-closed)"
else
  fail "_prune must NOT rm -rf a run dir when git status fails"
fi
if [[ ! -f "$prune_run/tmp/fishhawk-scope-run1-stage1.json" ]]; then pass "_prune: removes aged keyed scope sidecar"; else fail "_prune should remove aged scope sidecar"; fi
if [[ ! -f "$prune_run/tmp/fishhawk-pr-run1-stage1.md" ]]; then pass "_prune: removes aged keyed pr sidecar"; else fail "_prune should remove aged pr sidecar"; fi
if [[ -d "$prune_run/wt/run-fresh" ]]; then pass "_prune: keeps a fresh run worktree dir"; else fail "_prune should keep fresh run worktree"; fi
if [[ -f "$prune_run/wt/run-fresh.runid" ]]; then pass "_prune: keeps a fresh runid file"; else fail "_prune should keep fresh runid"; fi
if [[ -f "$prune_run/tmp/fishhawk-scope-fresh-x.json" ]]; then pass "_prune: keeps a fresh keyed sidecar (age boundary)"; else fail "_prune should keep the fresh keyed sidecar"; fi
if [[ -f "$prune_run/tmp/fishhawk-plan.json" && -f "$prune_run/tmp/fishhawk-pr.md" && -f "$prune_run/tmp/fishhawk-acceptance.json" ]]; then
  pass "_prune: keeps legacy fixed-slot files (fishhawk-plan.json / -pr.md / -acceptance.json)"
else
  fail "_prune must NOT touch the legacy fixed-slot transports"
fi
if [[ -d "$prune_run/tmp/fishhawk-acceptance-evidence-run1" ]]; then pass "_prune: keeps the acceptance-evidence directory"; else fail "_prune must not remove the acceptance-evidence dir"; fi
rm -rf "$prune_run"

# 18b. dry-run removes nothing.
prune_dry="$(mktemp -d -t test-dev-prunedry.XXXXXX)"
make_prune_fixture "$prune_dry"
REPO_ROOT="$prune_repo"
_prune_aged_artifacts 7 1 "$prune_dry/wt" "$prune_dry/tmp" >/dev/null 2>&1
REPO_ROOT="$orig_repo_root"
if [[ -d "$prune_dry/wt/run-old" && -f "$prune_dry/wt/run-old.runid" && -f "$prune_dry/tmp/fishhawk-scope-run1-stage1.json" ]]; then
  pass "_prune: --dry-run removes nothing"
else
  fail "_prune --dry-run must not remove any candidate"
fi
rm -rf "$prune_dry"
rm -rf "$prune_repo"

# 18b. _warn_stale_shim (#2831): stub-driven branches for every degrade, plus
# the stderr case and the bounded-probe case.
# The probe is a MACHINE-CONSUMABLE mode, so anything other than non-empty stdout
# must produce total silence — including output the probe wrote to STDERR, which
# on a dev box that has ever run a shim is the COMMON case (dead-pid leftover
# state files persist forever when a shim is SIGKILLed).
shim_stub_dir="$(mktemp -d)"

# (a) stale output on stdout -> a warning naming the pid text and /mcp.
cat > "${shim_stub_dir}/stale" <<'STUB'
#!/bin/sh
echo "STALE: shim pid 4242 (git_sha=abc1234)"
echo "  child pid 918273  path /tmp/bin/fishhawk-mcp"
STUB
chmod +x "${shim_stub_dir}/stale"
shim_out="$(_warn_stale_shim "${shim_stub_dir}/stale" 2>&1)"; shim_rc=$?
if [[ "$shim_out" == *"4242"* ]] && print -r -- "$shim_out" | grep -q -- '/mcp' && (( shim_rc == 0 )); then
  pass "_warn_stale_shim warns (naming the pid and /mcp) on stale probe output"
else
  fail "_warn_stale_shim should warn naming the pid and /mcp (out: $shim_out rc: $shim_rc)"
fi

# (b) empty stdout -> silence.
cat > "${shim_stub_dir}/clean" <<'STUB'
#!/bin/sh
exit 0
STUB
chmod +x "${shim_stub_dir}/clean"
shim_out="$(_warn_stale_shim "${shim_stub_dir}/clean" 2>&1)"; shim_rc=$?
if [[ -z "$shim_out" && "$shim_rc" -eq 0 ]]; then
  pass "_warn_stale_shim: empty probe output degrades to silence (rc 0)"
else
  fail "_warn_stale_shim should be silent+rc0 on empty output (out: $shim_out rc: $shim_rc)"
fi

# (c) probe exits non-zero -> silence (even with output).
cat > "${shim_stub_dir}/broken" <<'STUB'
#!/bin/sh
echo "some output"
exit 3
STUB
chmod +x "${shim_stub_dir}/broken"
shim_out="$(_warn_stale_shim "${shim_stub_dir}/broken" 2>&1)"; shim_rc=$?
if [[ -z "$shim_out" && "$shim_rc" -eq 0 ]]; then
  pass "_warn_stale_shim: non-zero probe exit degrades to silence (rc 0)"
else
  fail "_warn_stale_shim should be silent+rc0 when the probe fails (out: $shim_out rc: $shim_rc)"
fi

# (d) probe exits ZERO, prints NOTHING to stdout and DOES print to stderr ->
# total silence. Neither (b) nor (c) can catch this: the advisory captures only
# stdout, so probe stderr would otherwise reach the operator's terminal on every
# `scripts/dev up` while nothing at all is stale.
cat > "${shim_stub_dir}/noisy_stderr" <<'STUB'
#!/bin/sh
echo "skipped /tmp/fishhawk-mcp-shim/999.json: shim pid 999 is not running" >&2
exit 0
STUB
chmod +x "${shim_stub_dir}/noisy_stderr"
shim_out="$(_warn_stale_shim "${shim_stub_dir}/noisy_stderr" 2>&1)"; shim_rc=$?
if [[ -z "$shim_out" && "$shim_rc" -eq 0 ]]; then
  pass "_warn_stale_shim: probe stderr never reaches the operator (total silence)"
else
  fail "_warn_stale_shim must swallow probe stderr (out: $shim_out rc: $shim_rc)"
fi

# (d2) probe that never returns -> the advisory must NOT hang. cmd_up calls this
# before anything else, so an unbounded probe hangs `scripts/dev up`/`reload`
# outright — the one failure mode an advisory must not have. The shim hashes each
# snapshot's untrusted child_path, which can be a stalled mount or a huge file.
# Case (b)/(c)/(d) cannot catch this: they all RETURN.
cat > "${shim_stub_dir}/hangs" <<'STUB'
#!/bin/sh
echo "STALE: shim pid 4242"
sleep 600
STUB
chmod +x "${shim_stub_dir}/hangs"
# NB: as in case (g), an assignment prefix on an ASSIGNMENT is not a command
# prefix in zsh — it would persist into case (d3) below and race its 1s stub — so
# set and restore the bound explicitly.
hang_saved="$_SHIM_PROBE_TIMEOUT"
_SHIM_PROBE_TIMEOUT=1
hang_start=$SECONDS
shim_out="$(_warn_stale_shim "${shim_stub_dir}/hangs" 2>&1)"; shim_rc=$?
hang_elapsed=$(( SECONDS - hang_start ))
_SHIM_PROBE_TIMEOUT="$hang_saved"
if [[ -z "$shim_out" && "$shim_rc" -eq 0 ]] && (( hang_elapsed < 15 )); then
  pass "_warn_stale_shim: a hanging probe is bounded and degrades to silence (${hang_elapsed}s)"
else
  fail "_warn_stale_shim must bound the probe and stay silent (out: $shim_out rc: $shim_rc elapsed: ${hang_elapsed}s)"
fi

# (d3) the bound must not clip a probe that answers in time — otherwise (d2)
# would pass with a timeout of zero and the advisory would never warn at all.
cat > "${shim_stub_dir}/slow_ok" <<'STUB'
#!/bin/sh
sleep 1
echo "STALE: shim pid 4242"
STUB
chmod +x "${shim_stub_dir}/slow_ok"
shim_out="$(_warn_stale_shim "${shim_stub_dir}/slow_ok" 2>&1)"; shim_rc=$?
if [[ "$shim_out" == *"4242"* ]] && (( shim_rc == 0 )); then
  pass "_warn_stale_shim: a probe that answers within the bound still warns"
else
  fail "_warn_stale_shim clipped an in-time probe (out: $shim_out rc: $shim_rc)"
fi

# (e) missing binary -> silence, rc 0.
shim_out="$(_warn_stale_shim "${shim_stub_dir}/does-not-exist" 2>&1)"; shim_rc=$?
if [[ -z "$shim_out" && "$shim_rc" -eq 0 ]]; then
  pass "_warn_stale_shim: missing shim binary degrades to silence (rc 0)"
else
  fail "_warn_stale_shim should be silent+rc0 with no shim binary (out: $shim_out rc: $shim_rc)"
fi

# (f) a non-executable file is not probed either.
: > "${shim_stub_dir}/not-exec"
shim_out="$(_warn_stale_shim "${shim_stub_dir}/not-exec" 2>&1)"; shim_rc=$?
if [[ -z "$shim_out" && "$shim_rc" -eq 0 ]]; then
  pass "_warn_stale_shim: non-executable path degrades to silence (rc 0)"
else
  fail "_warn_stale_shim should be silent+rc0 for a non-executable path (out: $shim_out rc: $shim_rc)"
fi

# (g) the FISHHAWK_MCP_SHIM_STATE_DIR coupling: when the variable is set in this
# process's environment it is forwarded to the probe as --state-dir, so a
# custom-dir registration scripts/dev CAN see is still covered.
cat > "${shim_stub_dir}/echo_args" <<'STUB'
#!/bin/sh
echo "STALE args: $*"
STUB
chmod +x "${shim_stub_dir}/echo_args"
# NB: an assignment prefix on an ASSIGNMENT is not a command prefix in zsh — it
# would persist into the next case — so set and unset it explicitly.
export FISHHAWK_MCP_SHIM_STATE_DIR=/tmp/custom-state
shim_out="$(_warn_stale_shim "${shim_stub_dir}/echo_args" 2>&1)"
unset FISHHAWK_MCP_SHIM_STATE_DIR
if [[ "$shim_out" == *"--state-dir /tmp/custom-state"* ]]; then
  pass "_warn_stale_shim forwards FISHHAWK_MCP_SHIM_STATE_DIR to the probe"
else
  fail "_warn_stale_shim should forward the state-dir override (out: $shim_out)"
fi
shim_out="$(_warn_stale_shim "${shim_stub_dir}/echo_args" 2>&1)"
if [[ "$shim_out" != *"--state-dir"* ]]; then
  pass "_warn_stale_shim omits --state-dir when no override is set"
else
  fail "_warn_stale_shim should not pass --state-dir without an override (out: $shim_out)"
fi
rm -rf "$shim_stub_dir"

# 19. Body-greps: cmd_up -> _warn_stale_worktrees, cmd_sweep wiring, dispatch, usage.
up_body="$(typeset -f cmd_up)"
if print -r -- "$up_body" | grep -q '_warn_stale_worktrees'; then
  pass "cmd_up invokes _warn_stale_worktrees"
else
  fail "cmd_up should invoke _warn_stale_worktrees"
fi
if print -r -- "$up_body" | grep -q '_warn_stale_shim'; then
  pass "cmd_up invokes _warn_stale_shim"
else
  fail "cmd_up should invoke _warn_stale_shim (#2831)"
fi
if print -r -- "$up_body" | grep -q 'bin/fishhawk-mcp-shim'; then
  pass "cmd_up points the stale-shim probe at bin/fishhawk-mcp-shim"
else
  fail "cmd_up should probe \${REPO_ROOT}/bin/fishhawk-mcp-shim"
fi
sweep_body="$(typeset -f cmd_sweep)"
if print -r -- "$sweep_body" | grep -q 'cleanup-merged'; then
  pass "cmd_sweep reuses scripts/cleanup-merged"
else
  fail "cmd_sweep should compose scripts/cleanup-merged"
fi
if print -r -- "$sweep_body" | grep -q 'read -q'; then
  pass "cmd_sweep gates removal on read -q"
else
  fail "cmd_sweep should confirm via read -q"
fi
if print -r -- "$sweep_body" | grep -q -- '--yes'; then
  pass "cmd_sweep honors --yes"
else
  fail "cmd_sweep should parse --yes"
fi
if print -r -- "$sweep_body" | grep -q -- '--dry-run'; then
  pass "cmd_sweep honors --dry-run"
else
  fail "cmd_sweep should parse --dry-run"
fi
if print -r -- "$sweep_body" | grep -q '_prune_aged_artifacts'; then
  pass "cmd_sweep prunes aged run/tmp litter"
else
  fail "cmd_sweep should call _prune_aged_artifacts"
fi
if grep -qE '^[[:space:]]*sweep\)[[:space:]]*cmd_sweep' "${orig_repo_root}/scripts/dev"; then
  pass "sweep wired into the dispatch table"
else
  fail "sweep should be wired into the dispatch case"
fi
usage_body="$(typeset -f _usage)"
if print -r -- "$usage_body" | grep -q 'sweep'; then
  pass "sweep documented in _usage"
else
  fail "_usage should document sweep"
fi

# 20. cmd_sweep fail-safe: a non-tty stdin without --yes lists and removes nothing;
# and self-protection: the merged worktree containing $PWD is never a candidate.
if command -v git >/dev/null 2>&1; then
  swfix="$(mktemp -d -t test-dev-sweep.XXXXXX)"
  (
    set -e
    cd "$swfix"; git init -q -b main main; cd main
    git config user.email t@e.com; git config user.name t; git config commit.gpgsign false
    echo a > f; git add f; git commit -qm base
    git update-ref refs/remotes/origin/main "$(git rev-parse HEAD)"
    mkdir -p .claude/worktrees
    git branch merged-clean
    git worktree add -q .claude/worktrees/wt-merged merged-clean
  )
  # 20a. non-tty stdin, no --yes -> nothing removed (fail-safe listing).
  REPO_ROOT="$swfix/main"
  sweep_noninteractive_out="$(cmd_sweep </dev/null 2>&1)"
  REPO_ROOT="$orig_repo_root"
  if [[ -d "$swfix/main/.claude/worktrees/wt-merged" ]]; then
    pass "cmd_sweep: non-tty stdin without --yes removes nothing"
  else
    fail "cmd_sweep must not remove a worktree on non-tty stdin without --yes"
  fi
  # Pin the `[[ ! -t 0 ]]` guard specifically: a non-tty session must take the
  # listing-only branch and NEVER reach the read -q prompt. Asserting the
  # message distinguishes it from the read-q EOF-cancel path, which would also
  # remove nothing but prove nothing about the tty guard (#1917 review).
  if print -r -- "$sweep_noninteractive_out" | grep -q 'non-interactive stdin and no --yes — listing only, nothing removed'; then
    pass "cmd_sweep: non-tty stdin takes the listing-only branch (never prompts)"
  else
    fail "cmd_sweep should print the non-interactive listing-only message (got: $sweep_noninteractive_out)"
  fi
  # 20b. from OUTSIDE the worktree, the merged worktree IS a listed candidate.
  REPO_ROOT="$swfix/main"
  cd "$swfix/main"
  out_root="$(cmd_sweep --dry-run 2>&1)"
  cd "$orig_pwd"
  REPO_ROOT="$orig_repo_root"
  if print -r -- "$out_root" | grep -q 'operator worktrees to remove: 1'; then
    pass "cmd_sweep: a merged worktree is a removal candidate from the main checkout"
  else
    fail "cmd_sweep should list the merged worktree as a candidate (got: $out_root)"
  fi
  # 20c. from INSIDE the merged worktree, it self-protects (0 candidates).
  REPO_ROOT="$swfix/main"
  cd "$swfix/main/.claude/worktrees/wt-merged"
  out_self="$(cmd_sweep --dry-run 2>&1)"
  cd "$orig_pwd"
  REPO_ROOT="$orig_repo_root"
  if print -r -- "$out_self" | grep -q 'operator worktrees to remove: 0'; then
    pass "cmd_sweep: never lists the worktree containing \$PWD as a candidate"
  else
    fail "cmd_sweep should self-protect the current worktree (got: $out_self)"
  fi
  rm -rf "$swfix"
else
  print "skip: git not found — skipping cmd_sweep fixtures"
fi

# 21. Confirmed sweep end-to-end: --yes removes the merged operator worktree AND
# composes cleanup-merged to delete the now-un-checked-out merged branch. Uses a
# real bare origin so cleanup-merged's `git fetch origin main` succeeds, and
# --days 99999 so the real /tmp litter glob matches nothing (hermetic).
if command -v git >/dev/null 2>&1; then
  cfix="$(mktemp -d -t test-dev-confirm.XXXXXX)"
  (
    set -e
    cd "$cfix"
    git init -q --bare origin.git
    git init -q -b main main
    cd main
    git config user.email t@e.com; git config user.name t; git config commit.gpgsign false
    echo a > f; git add f; git commit -qm base
    git remote add origin "$cfix/origin.git"
    git push -q origin HEAD:main
    git fetch -q origin
    # cmd_sweep resolves cleanup-merged under REPO_ROOT; give the fixture its own
    # copy so the composition runs against the fixture repo, not the real one.
    mkdir -p scripts
    cp "$orig_repo_root/scripts/cleanup-merged" scripts/cleanup-merged
    chmod +x scripts/cleanup-merged
    mkdir -p .claude/worktrees
    git branch merged-clean
    git worktree add -q .claude/worktrees/wt-merged merged-clean
  )
  if [[ -d "$cfix/main/.claude/worktrees/wt-merged" ]]; then
    REPO_ROOT="$cfix/main"
    cd "$cfix/main"
    cmd_sweep --yes --days 99999 >/dev/null 2>&1
    cd "$orig_pwd"
    REPO_ROOT="$orig_repo_root"
    if [[ ! -d "$cfix/main/.claude/worktrees/wt-merged" ]]; then
      pass "cmd_sweep --yes removes the merged-clean operator worktree"
    else
      fail "cmd_sweep --yes should remove the merged-clean worktree"
    fi
    if ! git -C "$cfix/main" show-ref --verify --quiet refs/heads/merged-clean; then
      pass "cmd_sweep --yes deletes the merged branch via cleanup-merged"
    else
      fail "cmd_sweep --yes should delete the merged branch (cleanup-merged composition)"
    fi
  else
    fail "confirmed-sweep fixture setup failed (no wt-merged)"
  fi
  rm -rf "$cfix"
else
  print "skip: git not found — skipping confirmed-sweep fixture"
fi

# ===========================================================================
# 16. Opt-in local TLS front end (E66.28 / #2453). Hermetic: no real caddy and
# no real TLS handshake in the purity/failure-mode blocks (stubs only), so the
# suite still runs where caddy is absent. The cert path is proven separately
# with REAL openssl (16h) — gated on openssl / s_server availability.
# ===========================================================================

# 16a. _tls_enabled: 0 ONLY when FISHHAWK_DEV_TLS is exactly "1".
if FISHHAWK_DEV_TLS=1 _tls_enabled; then
  pass "_tls_enabled returns 0 when FISHHAWK_DEV_TLS=1"
else
  fail "_tls_enabled should return 0 when FISHHAWK_DEV_TLS=1"
fi
if FISHHAWK_DEV_TLS=0 _tls_enabled; then
  fail "_tls_enabled should return non-zero when FISHHAWK_DEV_TLS=0"
else
  pass "_tls_enabled returns non-zero for FISHHAWK_DEV_TLS=0"
fi
if _tls_enabled; then
  fail "_tls_enabled should return non-zero when FISHHAWK_DEV_TLS is unset"
else
  pass "_tls_enabled returns non-zero when FISHHAWK_DEV_TLS is unset (default off)"
fi
if FISHHAWK_DEV_TLS=true _tls_enabled; then
  fail "_tls_enabled should return non-zero for FISHHAWK_DEV_TLS=true (only literal 1 enables)"
else
  pass "_tls_enabled treats FISHHAWK_DEV_TLS=true as disabled (only literal 1 enables)"
fi

# 16b. _tls_port / _tls_healthz_url: default 8443 + override.
if [[ "$(_tls_port)" == "8443" ]]; then
  pass "_tls_port defaults to 8443"
else
  fail "_tls_port should default to 8443 (got: $(_tls_port))"
fi
if [[ "$(FISHHAWK_DEV_TLS_PORT=9443 _tls_port)" == "9443" ]]; then
  pass "_tls_port honors FISHHAWK_DEV_TLS_PORT"
else
  fail "_tls_port should honor FISHHAWK_DEV_TLS_PORT (got: $(FISHHAWK_DEV_TLS_PORT=9443 _tls_port))"
fi
if [[ "$(_tls_healthz_url)" == "https://localhost:8443/healthz" ]]; then
  pass "_tls_healthz_url is the https localhost URL on the TLS port"
else
  fail "_tls_healthz_url should be https://localhost:8443/healthz (got: $(_tls_healthz_url))"
fi

# 16c. DONE-MEANS rendered-config assertion. Not mere helper presence: the
# shipped config text must terminate TLS, bind loopback-only, and forward to the
# unchanged fishhawkd. A comment-only touch fails these.
caddy_text="$(_tls_render_caddyfile 8443 /c/server.pem /c/server.key 127.0.0.1:8080)"
if print -r -- "$caddy_text" | grep -qE '^:8443 \{'; then
  pass "rendered Caddyfile uses the bare :8443 site address (host-agnostic)"
else
  fail "rendered Caddyfile should carry a bare ':8443 {' site address (got: $caddy_text)"
fi
# CONDITION 1 (binding assertion): the listener is pinned loopback-only.
if print -r -- "$caddy_text" | grep -qE '^[[:space:]]*bind 127\.0\.0\.1 ::1$'; then
  pass "rendered Caddyfile binds loopback-only (bind 127.0.0.1 ::1) — condition 1"
else
  fail "rendered Caddyfile MUST contain 'bind 127.0.0.1 ::1' (condition 1 — got: $caddy_text)"
fi
if print -r -- "$caddy_text" | grep -qE '^[[:space:]]*tls /c/server\.pem /c/server\.key$'; then
  pass "rendered Caddyfile terminates TLS with the cert/key pair"
else
  fail "rendered Caddyfile should carry 'tls <cert> <key>' (got: $caddy_text)"
fi
if print -r -- "$caddy_text" | grep -qE '^[[:space:]]*reverse_proxy 127\.0\.0\.1:8080$'; then
  pass "rendered Caddyfile reverse-proxies to the plain-http fishhawkd (127.0.0.1:8080)"
else
  fail "rendered Caddyfile should reverse_proxy to 127.0.0.1:8080 (got: $caddy_text)"
fi
if print -r -- "$caddy_text" | grep -qE '^[[:space:]]*auto_https off$'; then
  pass "rendered Caddyfile disables auto_https (no ACME)"
else
  fail "rendered Caddyfile should carry 'auto_https off' (got: $caddy_text)"
fi
if print -r -- "$caddy_text" | grep -qE '^[[:space:]]*admin off$'; then
  pass "rendered Caddyfile disables the admin endpoint (no :2019 listener)"
else
  fail "rendered Caddyfile should carry 'admin off' (got: $caddy_text)"
fi

# 16d. NON-VACUITY of the scope-item-2 control: the readiness gate goes THROUGH
# the proxy. Drive _tls_up with a stub proxy bin (sleeps → a live pid), a stub
# curl FIRST on PATH that captures its full argv and exits 0, and a stubbed cert
# step. Assert the captured argv points at the https gate URL with --cacert, and
# NOT at the plain-http upstream — so repointing the gate at fishhawkd goes red.
# (During implementation the gate was repointed at http://127.0.0.1:8080 and
# this case went RED as required; restored — see PR notes.)
if [[ -n "$(_port_listeners 8443)" ]]; then
  print "skip: port 8443 already has a listener — skipping the through-the-proxy non-vacuity case"
else
  nv_wd="$(mktemp -d -t test-dev-tlsnv.XXXXXX)"
  print '#!/bin/sh\nsleep 30\n' > "$nv_wd/proxy"; chmod +x "$nv_wd/proxy"
  mkdir -p "$nv_wd/bin"
  print "#!/bin/sh\nprintf '%s\\\\n' \"\$*\" >> \"$nv_wd/curl.argv\"\nexit 0\n" > "$nv_wd/bin/curl"; chmod +x "$nv_wd/bin/curl"
  (
    TLS_DIR="$nv_wd/tls"; TLS_PID_FILE="$nv_wd/tls.pid"; TLS_LOG_FILE="$nv_wd/tls.log"; LOG_DIR="$nv_wd"
    export FISHHAWK_DEV_TLS_PROXY_BIN="$nv_wd/proxy"
    _tls_ensure_certs() { mkdir -p "$1"; : > "$1/ca.pem"; : > "$1/server.pem"; : > "$1/server.key"; return 0 }
    PATH="$nv_wd/bin:$PATH" _tls_up >/dev/null 2>&1
    [[ -f "$TLS_PID_FILE" ]] && kill "$(cat "$TLS_PID_FILE")" 2>/dev/null
  )
  nv_cap="$(cat "$nv_wd/curl.argv" 2>/dev/null)"
  if [[ "$nv_cap" == *"https://localhost:8443/healthz"* ]]; then
    pass "_tls_up gates on the https proxy URL (through-the-proxy readiness)"
  else
    fail "_tls_up gate should curl https://localhost:8443/healthz (got: $nv_cap)"
  fi
  if [[ "$nv_cap" == *"--cacert $nv_wd/tls/ca.pem"* ]]; then
    pass "_tls_up gate passes --cacert with the derived ca.pem path"
  else
    fail "_tls_up gate should pass --cacert <ca.pem> (got: $nv_cap)"
  fi
  if [[ "$nv_cap" != *"http://127.0.0.1:8080"* ]]; then
    pass "_tls_up gate does NOT probe the plain-http upstream directly (non-vacuity)"
  else
    fail "_tls_up gate must not curl the plain-http upstream http://127.0.0.1:8080 (got: $nv_cap)"
  fi
  rm -rf "$nv_wd"
fi

# 16e. Failure mode: proxy binary absent. FISHHAWK_DEV_TLS_PROXY_BIN unset and a
# PATH with no caddy → non-zero, stderr names 'brew install caddy', NO pid file
# written (the never-silently-skip proof). _tls_resolve_proxy_bin uses only
# builtins, so scoping PATH to the _tls_up call is safe.
fm_wd="$(mktemp -d -t test-dev-tlsfm.XXXXXX)"
mkdir -p "$fm_wd/empty"
(
  TLS_PID_FILE="$fm_wd/tls.pid"; TLS_DIR="$fm_wd/tls"; TLS_LOG_FILE="$fm_wd/tls.log"
  unset FISHHAWK_DEV_TLS_PROXY_BIN
  out="$(PATH="$fm_wd/empty" _tls_up 2>&1)"; rc=$?
  if (( rc != 0 )); then pass "_tls_up fails (non-zero) when no proxy binary resolves"; else fail "_tls_up should fail when no proxy binary resolves"; fi
  if [[ "$out" == *"brew install caddy"* ]]; then pass "_tls_up names 'brew install caddy' when the proxy binary is absent"; else fail "_tls_up should name 'brew install caddy' (got: $out)"; fi
  if [[ ! -f "$TLS_PID_FILE" ]]; then pass "_tls_up writes NO pid file when the proxy binary is absent (never silently skips)"; else fail "_tls_up must not write a pid file on proxy-binary-absent"; fi
)
rm -rf "$fm_wd"

# 16f. Failure mode: openssl absent. A resolvable proxy bin but no openssl on
# PATH → non-zero + actionable message, before any cert/pid work.
fm_wd="$(mktemp -d -t test-dev-tlsfm.XXXXXX)"
mkdir -p "$fm_wd/empty"
print '#!/bin/sh\nsleep 5\n' > "$fm_wd/proxy"; chmod +x "$fm_wd/proxy"
(
  TLS_PID_FILE="$fm_wd/tls.pid"; TLS_DIR="$fm_wd/tls"; TLS_LOG_FILE="$fm_wd/tls.log"
  export FISHHAWK_DEV_TLS_PROXY_BIN="$fm_wd/proxy"
  out="$(PATH="$fm_wd/empty" _tls_up 2>&1)"; rc=$?
  if (( rc != 0 )); then pass "_tls_up fails (non-zero) when openssl is absent"; else fail "_tls_up should fail when openssl is absent"; fi
  if [[ "$out" == *"openssl not found"* ]]; then pass "_tls_up names openssl as the missing prerequisite"; else fail "_tls_up should name the missing openssl (got: $out)"; fi
  if [[ ! -f "$TLS_PID_FILE" ]]; then pass "_tls_up writes NO pid file when openssl is absent"; else fail "_tls_up must not write a pid file on openssl-absent"; fi
)
rm -rf "$fm_wd"

# 16g. Failure mode: TLS port already occupied. Bind the TLS port with an nc
# one-shot listener (the section-13 fixture family) → non-zero and the message
# names the squatting pid. Requires lsof + nc (skip cleanly otherwise).
if ! command -v nc &>/dev/null || ! command -v lsof &>/dev/null; then
  print "skip: nc or lsof not found — skipping the TLS port-occupied failure-mode case"
else
  occ_port=""
  for _try in 1 2 3 4 5; do
    cand=$(( 20000 + (RANDOM % 20000) ))
    if [[ -z "$(_port_listeners "$cand")" ]]; then occ_port="$cand"; break; fi
  done
  if [[ -z "$occ_port" ]]; then
    fail "could not find a free high port for the TLS port-occupied fixture"
  else
    nc -l 127.0.0.1 "$occ_port" >/dev/null 2>&1 &
    occ_nc_pid=$!
    i=0
    while (( i < 20 )); do
      if [[ -n "$(_port_listeners "$occ_port")" ]]; then break; fi
      sleep 0.1
      (( ++i ))
    done
    fm_wd="$(mktemp -d -t test-dev-tlsfm.XXXXXX)"
    print '#!/bin/sh\nsleep 5\n' > "$fm_wd/proxy"; chmod +x "$fm_wd/proxy"
    (
      TLS_PID_FILE="$fm_wd/tls.pid"; TLS_DIR="$fm_wd/tls"; TLS_LOG_FILE="$fm_wd/tls.log"
      export FISHHAWK_DEV_TLS_PROXY_BIN="$fm_wd/proxy"
      export FISHHAWK_DEV_TLS_PORT="$occ_port"
      out="$(_tls_up 2>&1)"; rc=$?
      if (( rc != 0 )); then pass "_tls_up fails (non-zero) when the TLS port is occupied"; else fail "_tls_up should fail when the TLS port is occupied"; fi
      if [[ "$out" == *"$occ_nc_pid"* ]]; then pass "_tls_up port-preflight names the squatting pid"; else fail "_tls_up should name squatter pid ${occ_nc_pid} (got: $out)"; fi
      if [[ ! -f "$TLS_PID_FILE" ]]; then pass "_tls_up writes NO pid file when the port is occupied"; else fail "_tls_up must not write a pid file on port-occupied"; fi
    )
    rm -rf "$fm_wd"
    kill "$occ_nc_pid" 2>/dev/null
    wait "$occ_nc_pid" 2>/dev/null
  fi
fi

# 16h. Failure mode: proxy spawn-then-die. A stub bin that exits immediately →
# the gate's kill -0 fails → _tls_up returns non-zero, tails the log, and
# removes the pid file. A stub curl that fails keeps the loop bounded.
if [[ -n "$(_port_listeners 8443)" ]]; then
  print "skip: port 8443 busy — skipping the spawn-then-die failure-mode case"
else
  fm_wd="$(mktemp -d -t test-dev-tlsfm.XXXXXX)"
  print '#!/bin/sh\nexit 0\n' > "$fm_wd/proxy"; chmod +x "$fm_wd/proxy"
  mkdir -p "$fm_wd/bin"
  print '#!/bin/sh\nexit 1\n' > "$fm_wd/bin/curl"; chmod +x "$fm_wd/bin/curl"
  (
    TLS_DIR="$fm_wd/tls"; TLS_PID_FILE="$fm_wd/tls.pid"; TLS_LOG_FILE="$fm_wd/tls.log"; LOG_DIR="$fm_wd"
    export FISHHAWK_DEV_TLS_PROXY_BIN="$fm_wd/proxy"
    _tls_ensure_certs() { mkdir -p "$1"; : > "$1/ca.pem"; : > "$1/server.pem"; : > "$1/server.key"; return 0 }
    print "proxy exited (fixture marker)" > "$fm_wd/tls.log"
    out="$(PATH="$fm_wd/bin:$PATH" _tls_up 2>&1)"; rc=$?
    if (( rc != 0 )); then pass "_tls_up fails (non-zero) on proxy spawn-then-die"; else fail "_tls_up should fail when the proxy dies immediately"; fi
    if [[ "$out" == *"fixture marker"* ]]; then pass "_tls_up tails the proxy log on spawn-then-die"; else fail "_tls_up should tail the log on spawn-then-die (got: $out)"; fi
    if [[ ! -f "$TLS_PID_FILE" ]]; then pass "_tls_up removes the pid file on spawn-then-die"; else fail "_tls_up should remove the pid file on spawn-then-die"; fi
  )
  rm -rf "$fm_wd"
fi

# 16i. Failure mode: readiness-gate timeout with a LIVE proxy. Redefine the gate
# to always time out (return 1) so the test is fast and deterministic; the point
# is _tls_up's failure HANDLING — kill the live proxy AND remove the pid file.
if [[ -n "$(_port_listeners 8443)" ]]; then
  print "skip: port 8443 busy — skipping the readiness-timeout failure-mode case"
else
  fm_wd="$(mktemp -d -t test-dev-tlsfm.XXXXXX)"
  print '#!/bin/sh\nsleep 30\n' > "$fm_wd/proxy"; chmod +x "$fm_wd/proxy"
  captured_pid=""
  (
    TLS_DIR="$fm_wd/tls"; TLS_PID_FILE="$fm_wd/tls.pid"; TLS_LOG_FILE="$fm_wd/tls.log"; LOG_DIR="$fm_wd"
    export FISHHAWK_DEV_TLS_PROXY_BIN="$fm_wd/proxy"
    _tls_ensure_certs() { mkdir -p "$1"; : > "$1/ca.pem"; : > "$1/server.pem"; : > "$1/server.key"; return 0 }
    _await_tls_healthz() { return 1 }
    out="$(_tls_up 2>&1)"; rc=$?
    print -r -- "$rc" > "$fm_wd/rc"
    if [[ -f "$fm_wd/lastpid" ]]; then :; fi
  )
  # Reconstruct: after _tls_up returns, the pid file must be gone and the proxy
  # process killed. The pid file was removed by _tls_up, so read it from the log
  # is not possible; instead assert the pid file is gone and no stub proxy of
  # this fixture survives.
  fm_rc="$(cat "$fm_wd/rc" 2>/dev/null)"
  if [[ "$fm_rc" != "0" && -n "$fm_rc" ]]; then pass "_tls_up fails (non-zero) on readiness-gate timeout"; else fail "_tls_up should fail on readiness-gate timeout (rc=$fm_rc)"; fi
  if [[ ! -f "$fm_wd/tls.pid" ]]; then pass "_tls_up removes the pid file on readiness-gate timeout"; else fail "_tls_up should remove the pid file on readiness-gate timeout"; fi
  # The stub proxy must have been killed; if any 'sleep 30' from our stub path
  # survives, this leaks. Best-effort: pgrep by the fixture proxy path.
  if command -v pgrep &>/dev/null; then
    if [[ -z "$(pgrep -f "$fm_wd/proxy" 2>/dev/null)" ]]; then
      pass "_tls_up killed the live proxy on readiness-gate timeout"
    else
      fail "_tls_up should kill the live proxy on readiness-gate timeout"
      pkill -f "$fm_wd/proxy" 2>/dev/null
    fi
  else
    print "skip: pgrep not found — skipping the proxy-killed assertion (pid file removal already asserted)"
  fi
  rm -rf "$fm_wd"
fi

# 16j. _tls_down behavioral contract (mirrors _preview_kill_tracked).
# Absent pid file → silent no-op returning 0 (the disabled-default regression
# control from step 12 case 6).
tls_dn_wd="$(mktemp -d -t test-dev-tlsdn.XXXXXX)"
if _tls_down "$tls_dn_wd/absent.pid" >/dev/null 2>&1; then
  pass "_tls_down returns 0 on an absent pid file (idempotent no-op)"
else
  fail "_tls_down should return 0 when the pid file is absent"
fi
# Live stub pid → process killed AND pid file removed (step 12 case 7, and the
# condition-2 teardown-after-flag-cleared behavior: _tls_down never consults
# FISHHAWK_DEV_TLS, so a cleared flag does not orphan the proxy).
print '#!/bin/sh\nsleep 30\n' > "$tls_dn_wd/proc"; chmod +x "$tls_dn_wd/proc"
"$tls_dn_wd/proc" &
tls_dn_pid=$!
print "$tls_dn_pid" > "$tls_dn_wd/live.pid"
FISHHAWK_DEV_TLS='' _tls_down "$tls_dn_wd/live.pid" >/dev/null 2>&1
if ! kill -0 "$tls_dn_pid" 2>/dev/null; then
  pass "_tls_down kills a live proxy even with FISHHAWK_DEV_TLS cleared (condition 2 — no orphan)"
else
  fail "_tls_down should kill the live proxy pid ${tls_dn_pid}"
  kill "$tls_dn_pid" 2>/dev/null
fi
if [[ ! -f "$tls_dn_wd/live.pid" ]]; then
  pass "_tls_down removes the pid file after killing the proxy"
else
  fail "_tls_down should remove the pid file after killing the proxy"
fi
wait "$tls_dn_pid" 2>/dev/null
rm -rf "$tls_dn_wd"

# 16j-2. _tls_down SIGKILL-after-5s escalation branch: a proxy that IGNORES
# SIGTERM must be waited on and escalated to SIGKILL, not left orphaned. This is
# the branch _tls_up's readiness-failure cleanup now relies on (it tears down
# through _tls_down rather than a bare single TERM). ~5s cost, deterministic.
tls_kill_wd="$(mktemp -d -t test-dev-tlskill.XXXXXX)"
# The stub installs its TERM-ignore trap, THEN touches the ready marker ($1), so
# the test can wait for the trap to be armed before _tls_down sends TERM —
# otherwise TERM can land in the startup window (default disposition) and kill
# the stub, never exercising the SIGKILL escalation branch.
print '#!/bin/sh\ntrap "" TERM\n: > "$1"\nsleep 30\n' > "$tls_kill_wd/ignterm"; chmod +x "$tls_kill_wd/ignterm"
"$tls_kill_wd/ignterm" "$tls_kill_wd/ready" &
tls_kill_pid=$!
print "$tls_kill_pid" > "$tls_kill_wd/ignterm.pid"
tls_kill_i=0
while [[ ! -f "$tls_kill_wd/ready" ]] && (( tls_kill_i < 50 )); do
  sleep 0.1
  (( ++tls_kill_i ))
done
tls_kill_out="$(_tls_down "$tls_kill_wd/ignterm.pid" 2>&1)"
if ! kill -0 "$tls_kill_pid" 2>/dev/null; then
  pass "_tls_down escalates to SIGKILL a proxy that ignores SIGTERM (no orphan)"
else
  fail "_tls_down should SIGKILL a TERM-ignoring proxy pid ${tls_kill_pid}"
  kill -KILL "$tls_kill_pid" 2>/dev/null
fi
if [[ "$tls_kill_out" == *"SIGKILL after 5s"* ]]; then
  pass "_tls_down reports the SIGKILL-after-5s escalation"
else
  fail "_tls_down should report the SIGKILL escalation (got: $tls_kill_out)"
fi
if [[ ! -f "$tls_kill_wd/ignterm.pid" ]]; then
  pass "_tls_down removes the pid file after a SIGKILL escalation"
else
  fail "_tls_down should remove the pid file after a SIGKILL escalation"
fi
wait "$tls_kill_pid" 2>/dev/null
rm -rf "$tls_kill_wd"

# 16k. Call-site wiring (body-grep, section-13b style). cmd_up runs the TLS leg
# under an _tls_enabled guard, AFTER the #1018 nonce verification (so the nonce
# identity proof stays on plain-http fishhawkd), and BEFORE _signal_mcp_activation.
tls_up_body="$(typeset -f cmd_up)"
tls_down_body="$(typeset -f cmd_down)"
if print -r -- "$tls_up_body" | grep -q '_tls_up'; then
  pass "cmd_up invokes _tls_up"
else
  fail "cmd_up should invoke _tls_up"
fi
if print -r -- "$tls_up_body" | grep -q '_tls_enabled'; then
  pass "cmd_up guards the TLS leg with _tls_enabled (default off)"
else
  fail "cmd_up should guard the TLS leg with _tls_enabled"
fi
tls_nonce_line="$(print -r -- "$tls_up_body" | grep -n '_verify_healthz_nonce' | head -n 1 | cut -d: -f1)"
tls_up_line="$(print -r -- "$tls_up_body" | grep -n '_tls_up' | head -n 1 | cut -d: -f1)"
tls_mcp_line="$(print -r -- "$tls_up_body" | grep -n '_signal_mcp_activation' | head -n 1 | cut -d: -f1)"
if [[ -n "$tls_nonce_line" && -n "$tls_up_line" ]] && (( tls_nonce_line < tls_up_line )); then
  pass "cmd_up runs _tls_up AFTER the #1018 nonce verification (nonce proof stays on plain http)"
else
  fail "cmd_up should order _verify_healthz_nonce before _tls_up (nonce=$tls_nonce_line tls=$tls_up_line)"
fi
if [[ -n "$tls_up_line" && -n "$tls_mcp_line" ]] && (( tls_up_line < tls_mcp_line )); then
  pass "cmd_up runs _tls_up BEFORE _signal_mcp_activation (MCP banner stays last)"
else
  fail "cmd_up should order _tls_up before _signal_mcp_activation (tls=$tls_up_line mcp=$tls_mcp_line)"
fi
# cmd_down calls _tls_down UNCONDITIONALLY (condition 2): no _tls_enabled guard.
if print -r -- "$tls_down_body" | grep -q '_tls_down'; then
  pass "cmd_down invokes _tls_down"
else
  fail "cmd_down should invoke _tls_down"
fi
if print -r -- "$tls_down_body" | grep -q '_tls_enabled'; then
  fail "cmd_down must NOT guard _tls_down on _tls_enabled (condition 2 — teardown is unconditional)"
else
  pass "cmd_down tears down the TLS front end unconditionally (no _tls_enabled guard — condition 2)"
fi

# 16l. REAL-openssl cert-path proofs (conditions 3/4/5 + idempotency). Skipped
# cleanly where openssl is unavailable so the suite stays portable.
if ! command -v openssl &>/dev/null; then
  print "skip: openssl not found — skipping the real cert-path proofs (conditions 3/4/5)"
else
  # Idempotency: two runs leave the CA byte-identical (the NODE_EXTRA_CA_CERTS
  # stability the docs depend on).
  cert_wd="$(mktemp -d -t test-dev-tlscert.XXXXXX)"
  (
    TLS_DIR="$cert_wd/tls"
    _tls_ensure_certs "$cert_wd/tls" >/dev/null 2>&1
  )
  if [[ -f "$cert_wd/tls/ca.pem" && -f "$cert_wd/tls/server.pem" && -f "$cert_wd/tls/server.key" ]]; then
    ca_sha1="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
    (
      TLS_DIR="$cert_wd/tls"
      _tls_ensure_certs "$cert_wd/tls" >/dev/null 2>&1
    )
    ca_sha2="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
    if [[ "$ca_sha1" == "$ca_sha2" ]]; then
      pass "_tls_ensure_certs is idempotent — CA byte-identical across two runs"
    else
      fail "_tls_ensure_certs should leave the CA byte-identical on the second run"
    fi
    # Leftover temp dir check (workspace hygiene).
    if [[ -z "$(print -rl -- "$cert_wd"/tls/.gen.*(N) 2>/dev/null)" ]]; then
      pass "_tls_ensure_certs leaves no .gen temp dir behind"
    else
      fail "_tls_ensure_certs should clean up its temp dir"
    fi
  else
    fail "_tls_ensure_certs did not produce ca.pem/server.pem/server.key"
  fi

  # CONDITION 4: mismatched CA/leaf pair triggers regeneration (self-repair),
  # not a skip. Seed a valid leaf next to a DIFFERENT (valid) CA.
  openssl req -x509 -newkey rsa:2048 -nodes -keyout "$cert_wd/tls/ca.key" \
    -out "$cert_wd/tls/ca.pem" -days 825 -subj "/CN=Different CA" >/dev/null 2>&1
  if ! openssl verify -CAfile "$cert_wd/tls/ca.pem" "$cert_wd/tls/server.pem" >/dev/null 2>&1; then
    srv_before="$(shasum "$cert_wd/tls/server.pem" | cut -d' ' -f1)"
    (
      TLS_DIR="$cert_wd/tls"
      _tls_ensure_certs "$cert_wd/tls" >/dev/null 2>&1
    )
    srv_after="$(shasum "$cert_wd/tls/server.pem" | cut -d' ' -f1)"
    if [[ "$srv_before" != "$srv_after" ]] && openssl verify -CAfile "$cert_wd/tls/ca.pem" "$cert_wd/tls/server.pem" >/dev/null 2>&1; then
      pass "_tls_ensure_certs regenerates a MISMATCHED leaf and re-verifies the chain (condition 4)"
    else
      fail "_tls_ensure_certs should regenerate a leaf that no longer verifies against the CA (condition 4)"
    fi
  else
    fail "condition-4 fixture setup failed (seeded CA unexpectedly still verifies the leaf)"
  fi

  # CONDITION 5: a leaf within its renewal window renews WITHOUT rotating the
  # still-valid CA. Sign a 1-day leaf with the existing CA, then regenerate.
  ca_keep="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
  openssl req -newkey rsa:2048 -nodes -keyout "$cert_wd/tls/server.key" \
    -out "$cert_wd/short.csr" -subj "/CN=localhost" >/dev/null 2>&1
  printf 'subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n' > "$cert_wd/short.ext"
  openssl x509 -req -in "$cert_wd/short.csr" -CA "$cert_wd/tls/ca.pem" \
    -CAkey "$cert_wd/tls/ca.key" -CAcreateserial -out "$cert_wd/tls/server.pem" \
    -days 1 -extfile "$cert_wd/short.ext" >/dev/null 2>&1
  if ! openssl x509 -in "$cert_wd/tls/server.pem" -checkend 604800 >/dev/null 2>&1; then
    srv_short="$(shasum "$cert_wd/tls/server.pem" | cut -d' ' -f1)"
    (
      TLS_DIR="$cert_wd/tls"
      _tls_ensure_certs "$cert_wd/tls" >/dev/null 2>&1
    )
    ca_after="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
    srv_renewed="$(shasum "$cert_wd/tls/server.pem" | cut -d' ' -f1)"
    if [[ "$ca_keep" == "$ca_after" ]]; then
      pass "_tls_ensure_certs preserves the CA when only the leaf renews (condition 5 — no NODE_EXTRA_CA_CERTS churn)"
    else
      fail "_tls_ensure_certs must NOT rotate the CA on a leaf-only renewal (condition 5)"
    fi
    if [[ "$srv_short" != "$srv_renewed" ]] && openssl x509 -in "$cert_wd/tls/server.pem" -checkend 604800 >/dev/null 2>&1; then
      pass "_tls_ensure_certs renews the near-expiry leaf to a fresh long-lived one (condition 5)"
    else
      fail "_tls_ensure_certs should renew a near-expiry leaf (condition 5)"
    fi
  else
    fail "condition-5 fixture setup failed (short leaf unexpectedly not near expiry)"
  fi

  # CERT/KEY MISMATCH (the FALSE branch of _tls_cert_key_match): a half-published
  # pair from a SIGKILL between the checked mvs — a valid CA-signed server.pem
  # next to a NON-matching server.key — must REGENERATE, not be reused. This is
  # the ONLY exercise of that helper's false path: replace _tls_cert_key_match
  # with `return 0` and the stale leaf is reused here (server.pem unchanged) and
  # this case goes red, pinning the silent-reuse wedge (5b797641) the control
  # exists to prevent. server.pem still VERIFIES against the CA, so `openssl
  # verify` alone would skip over it — only the cert/key correspondence check
  # catches the mismatch. Reuses condition-5's leftover state (valid CA + fresh
  # matched leaf); overwrite only server.key with a freshly generated non-match.
  openssl req -newkey rsa:2048 -nodes -keyout "$cert_wd/tls/server.key" \
    -out "$cert_wd/mismatch.csr" -subj "/CN=localhost" >/dev/null 2>&1
  if openssl verify -CAfile "$cert_wd/tls/ca.pem" "$cert_wd/tls/server.pem" >/dev/null 2>&1 \
    && ! _tls_cert_key_match "$cert_wd/tls/server.pem" "$cert_wd/tls/server.key"; then
    srv_mm_before="$(shasum "$cert_wd/tls/server.pem" | cut -d' ' -f1)"
    ca_mm_before="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
    (
      TLS_DIR="$cert_wd/tls"
      _tls_ensure_certs "$cert_wd/tls" >/dev/null 2>&1
    )
    srv_mm_after="$(shasum "$cert_wd/tls/server.pem" | cut -d' ' -f1)"
    ca_mm_after="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
    if [[ "$srv_mm_before" != "$srv_mm_after" ]] \
      && _tls_cert_key_match "$cert_wd/tls/server.pem" "$cert_wd/tls/server.key" \
      && openssl verify -CAfile "$cert_wd/tls/ca.pem" "$cert_wd/tls/server.pem" >/dev/null 2>&1; then
      pass "_tls_ensure_certs regenerates a leaf whose KEY no longer matches its cert (cert/key self-repair — false branch of _tls_cert_key_match)"
    else
      fail "_tls_ensure_certs should regenerate a leaf whose key does not match its cert (silent-reuse self-repair)"
    fi
    if [[ "$ca_mm_before" == "$ca_mm_after" ]]; then
      pass "_tls_ensure_certs preserves the CA while self-repairing a cert/key mismatch (condition 5 — leaf-only regen)"
    else
      fail "_tls_ensure_certs must NOT rotate the CA when self-repairing a cert/key mismatch (condition 5)"
    fi
  else
    fail "cert/key-mismatch fixture setup failed (server.pem should still verify against the CA but not match the new key)"
  fi

  # CA-near-expiry branch (ca_ok=0 via -checkend on the CA itself → FULL
  # regeneration including CA rotation). Condition-5's fixtures only ever expire
  # the leaf; this expires the CA. Seed a 1-day CA + a leaf it signed, then
  # regenerate and assert the CA rotated to a fresh, still-verifiable chain.
  rm -rf "$cert_wd/tls"; mkdir -p "$cert_wd/tls"
  openssl req -x509 -newkey rsa:2048 -nodes -keyout "$cert_wd/tls/ca.key" \
    -out "$cert_wd/tls/ca.pem" -days 1 -subj "/CN=Expiring CA" >/dev/null 2>&1
  openssl req -newkey rsa:2048 -nodes -keyout "$cert_wd/tls/server.key" \
    -out "$cert_wd/caexp.csr" -subj "/CN=localhost" >/dev/null 2>&1
  printf 'subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n' > "$cert_wd/caexp.ext"
  openssl x509 -req -in "$cert_wd/caexp.csr" -CA "$cert_wd/tls/ca.pem" \
    -CAkey "$cert_wd/tls/ca.key" -CAcreateserial -out "$cert_wd/tls/server.pem" \
    -days 90 -extfile "$cert_wd/caexp.ext" >/dev/null 2>&1
  ca_exp_before="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
  if ! openssl x509 -in "$cert_wd/tls/ca.pem" -checkend 604800 >/dev/null 2>&1; then
    (
      TLS_DIR="$cert_wd/tls"
      _tls_ensure_certs "$cert_wd/tls" >/dev/null 2>&1
    )
    ca_exp_after="$(shasum "$cert_wd/tls/ca.pem" | cut -d' ' -f1)"
    if [[ "$ca_exp_before" != "$ca_exp_after" ]] \
      && openssl x509 -in "$cert_wd/tls/ca.pem" -checkend 604800 >/dev/null 2>&1 \
      && openssl verify -CAfile "$cert_wd/tls/ca.pem" "$cert_wd/tls/server.pem" >/dev/null 2>&1; then
      pass "_tls_ensure_certs rotates the CA when the CA itself is near expiry (full regen)"
    else
      fail "_tls_ensure_certs should rotate an expiring CA and re-issue a verifiable leaf"
    fi
  else
    fail "CA-near-expiry fixture setup failed (1-day CA unexpectedly not near expiry)"
  fi

  # CONDITION 3: serve the REAL generated pair with `openssl s_server` on an
  # ephemeral port and verify BOTH URL shapes with curl --cacert. Pins the
  # dual-SAN shape + full chain end to end. Skipped if s_server is unavailable.
  s_server_ok=0
  if echo | openssl s_server -help >/dev/null 2>&1 || openssl s_server -help 2>&1 | grep -qi 'accept'; then
    s_server_ok=1
  fi
  if (( ! s_server_ok )); then
    print "skip: openssl s_server unavailable — skipping the dual-SAN handshake proof (condition 3)"
  elif ! command -v lsof &>/dev/null || ! command -v curl &>/dev/null; then
    print "skip: lsof/curl unavailable — skipping the dual-SAN handshake proof (condition 3)"
  else
    # Regenerate a clean pair (the condition-4/5 fixtures left a mixed state).
    rm -rf "$cert_wd/tls"
    (
      TLS_DIR="$cert_wd/tls"
      _tls_ensure_certs "$cert_wd/tls" >/dev/null 2>&1
    )
    ss_port=""
    for _try in 1 2 3 4 5; do
      cand=$(( 20000 + (RANDOM % 20000) ))
      if [[ -z "$(_port_listeners "$cand")" ]]; then ss_port="$cand"; break; fi
    done
    if [[ -z "$ss_port" ]]; then
      fail "could not find a free port for the s_server dual-SAN proof"
    else
      openssl s_server -accept "$ss_port" -cert "$cert_wd/tls/server.pem" \
        -key "$cert_wd/tls/server.key" -www -quiet >/dev/null 2>&1 &
      ss_pid=$!
      i=0
      while (( i < 30 )); do
        if [[ -n "$(_port_listeners "$ss_port")" ]]; then break; fi
        sleep 0.1
        (( ++i ))
      done
      if curl --silent --fail --max-time 3 --cacert "$cert_wd/tls/ca.pem" "https://localhost:${ss_port}/" >/dev/null 2>&1; then
        pass "generated cert verifies via curl --cacert for the localhost URL (condition 3)"
      else
        fail "generated cert should verify for https://localhost (condition 3 — dual-SAN)"
      fi
      if curl --silent --fail --max-time 3 --cacert "$cert_wd/tls/ca.pem" "https://127.0.0.1:${ss_port}/" >/dev/null 2>&1; then
        pass "generated cert verifies via curl --cacert for the 127.0.0.1 URL (condition 3 — dual SAN)"
      else
        fail "generated cert should verify for https://127.0.0.1 (condition 3 — dual-SAN)"
      fi
      kill "$ss_pid" 2>/dev/null
      wait "$ss_pid" 2>/dev/null
    fi
  fi
  rm -rf "$cert_wd"
fi

# 16m. Hermetic error-branch proofs for _tls_ensure_certs (no real openssl
# needed — the failure paths are what's under test). Each is a defensive branch
# whose contract is: fail loud (non-zero), leave the real dir untouched, and
# clean up any temp dir.
# (a) openssl-generation failure: reuse checks fail (empty dir), the generation
# subshell fails → tmp dir removed, real dir has no ca.pem, non-zero return.
gen_wd="$(mktemp -d -t test-dev-tlsgen.XXXXXX)"
(
  TLS_DIR="$gen_wd/tls"
  openssl() { return 1 }
  _tls_ensure_certs "$gen_wd/tls" >/dev/null 2>&1
  print -r -- "$?" > "$gen_wd/rc"
)
gen_rc="$(cat "$gen_wd/rc" 2>/dev/null)"
if [[ -n "$gen_rc" && "$gen_rc" != "0" ]]; then
  pass "_tls_ensure_certs fails (non-zero) when openssl generation fails"
else
  fail "_tls_ensure_certs should fail when openssl generation fails (rc=$gen_rc)"
fi
if [[ ! -f "$gen_wd/tls/ca.pem" ]]; then
  pass "_tls_ensure_certs leaves the real dir untouched on generation failure"
else
  fail "_tls_ensure_certs must not publish artifacts on generation failure"
fi
if [[ -z "$(print -rl -- "$gen_wd"/tls/.gen.*(N) 2>/dev/null)" ]]; then
  pass "_tls_ensure_certs removes its temp dir on generation failure"
else
  fail "_tls_ensure_certs should remove its temp dir on generation failure"
fi
rm -rf "$gen_wd"
# (b) mktemp failure: no temp dir can be created → named error, non-zero return,
# real dir has no artifacts.
mkt_wd="$(mktemp -d -t test-dev-tlsmkt.XXXXXX)"
(
  TLS_DIR="$mkt_wd/tls"
  openssl() { return 1 }   # force reuse checks to fail so generation is attempted
  mktemp() { return 1 }
  out="$(_tls_ensure_certs "$mkt_wd/tls" 2>&1)"; rc=$?
  print -r -- "$rc" > "$mkt_wd/rc"
  print -r -- "$out" > "$mkt_wd/out"
)
mkt_rc="$(cat "$mkt_wd/rc" 2>/dev/null)"
mkt_out="$(cat "$mkt_wd/out" 2>/dev/null)"
if [[ -n "$mkt_rc" && "$mkt_rc" != "0" ]]; then
  pass "_tls_ensure_certs fails (non-zero) when mktemp cannot create a temp dir"
else
  fail "_tls_ensure_certs should fail when mktemp fails (rc=$mkt_rc)"
fi
if [[ "$mkt_out" == *"temp dir"* ]]; then
  pass "_tls_ensure_certs names the temp-dir failure"
else
  fail "_tls_ensure_certs should name the temp-dir failure (got: $mkt_out)"
fi
if [[ ! -f "$mkt_wd/tls/ca.pem" ]]; then
  pass "_tls_ensure_certs leaves the real dir untouched on mktemp failure"
else
  fail "_tls_ensure_certs must not publish artifacts on mktemp failure"
fi
rm -rf "$mkt_wd"

# 6. Parse check: scripts/dev is valid zsh.
if zsh -n "${REPO_ROOT}/scripts/dev"; then
  pass "scripts/dev parses clean (zsh -n)"
else
  fail "scripts/dev failed zsh -n parse check"
fi

print ""
print "Results: ${PASS} passed, ${FAIL} failed"
[[ "$FAIL" -eq 0 ]]
